// ═══════════════════════════════════════════════════════════════════════════
// strings.slint — every user-facing string, in both languages.
//
// `fa` is the default and the app's native voice. `en` exists so the app is
// usable by anyone who does not read Persian; it is a full translation, not a
// fallback. Adding a string means adding it to both branches.
//
// Persian here deliberately prefers Persian roots over Arabic loans where a
// natural word exists (کار ژرف not تمرکز, آسایش not استراحت, سنجه not نمره).
// ═══════════════════════════════════════════════════════════════════════════

export global Strings {
    // "fa" | "en"
    in-out property <string> lang: "fa";
    out property <bool> fa: lang == "fa";

    // ── app ──────────────────────────────────────────────────────────────
    out property <string> app-name: fa ? "پنگان" : "Pangan";
    out property <string> app-tagline: fa ? "زمان‌سنج کار ژرف" : "Deep work timer";
    out property <string> app-credit: fa ? "پنگان · ساختهٔ خسروان" : "Pangan · by Khosrowan";
    out property <string> made-by: fa ? "ساختهٔ" : "Made by";

    // ── navigation ───────────────────────────────────────────────────────
    // The calendar grid's weekday header, Saturday-first. Persian uses the
    // single-letter initials; English uses the conventional two-letter form
    // because "T" and "S" each appear twice and would be ambiguous.
    out property <[string]> weekday-initials: fa
        ? ["ش", "ی", "د", "س", "چ", "پ", "ج"]
        : ["Sa", "Su", "Mo", "Tu", "We", "Th", "Fr"];

    out property <string> nav-timer: fa ? "زمان‌سنج" : "Timer";
    out property <string> nav-today: fa ? "امروز" : "Today";
    out property <string> nav-stats: fa ? "آمار" : "Stats";

    // ── timer phases ─────────────────────────────────────────────────────
    out property <string> phase-work: fa ? "کار ژرف" : "Deep Work";
    out property <string> phase-short: fa ? "آسایش کوتاه" : "Short Break";
    out property <string> phase-long: fa ? "آسایش دراز" : "Long Break";
    out property <string> state-running: fa ? "روان" : "Running";
    out property <string> state-paused: fa ? "درنگ" : "Paused";

    // ── main screen ──────────────────────────────────────────────────────
    out property <string> today: fa ? "امروز" : "Today";
    out property <string> tasks: fa ? "کارها" : "Tasks";
    out property <string> tasks-empty: fa ? "چیزی در صف نیست. یکی بیفزایید." : "Nothing queued. Add one below.";
    out property <string> task-placeholder: fa ? "کار تازه…" : "Add a task…";
    out property <string> task-placeholder-day: fa ? "کاری برای این روز…" : "Add a task for this day…";
    out property <string> tasks-none-day: fa ? "برای این روز کاری نیست." : "Nothing on this day.";
    out property <string> move-earlier: fa ? "یک روز عقب‌تر" : "Move a day earlier";
    out property <string> move-later: fa ? "یک روز جلوتر" : "Move a day later";
    out property <string> rename: fa ? "تغییر نام" : "Rename";
    out property <string> delete: fa ? "حذف" : "Delete";
    out property <string> sync: fa ? "همگام‌سازی" : "Sync";
    out property <string> minutes-short: fa ? "دقیقه" : "min";

    // ── calendar ─────────────────────────────────────────────────────────
    out property <string> day-name-label: fa ? "نام روز به گاهشمار ساسانی" : "Sasanian day-name";
    out property <string> feast-prefix: fa ? "جشن " : "Feast of ";
    out property <string> iran-events: fa ? "رخدادهای ایران" : "Iranian history";
    out property <string> world-events: fa ? "رخدادهای جهان" : "World history";
    out property <string> births: fa ? "زادروزها" : "Born";
    out property <string> deaths: fa ? "درگذشت‌ها" : "Died";
    out property <string> occasions: fa ? "مناسبت‌ها" : "Occasions";
    out property <string> no-events: fa ? "برای این روز رویدادی ثبت نشده است." : "No events recorded for this day.";
    out property <string> show-more: fa ? "بیشتر" : "More";
    out property <string> show-less: fa ? "کمتر" : "Less";
    out property <string> refresh-events: fa ? "تازه‌سازی از ویکی‌پدیا" : "Refresh from Wikipedia";
    out property <string> refreshing: fa ? "در حال برداشت…" : "Fetching…";

    // ── stats ────────────────────────────────────────────────────────────
    out property <string> score-title: fa ? "سنجهٔ کار ژرف" : "Deep work score";
    out property <string> this-week: fa ? "این هفته" : "This week";
    out property <string> sessions: fa ? "نشست‌ها" : "Sessions";
    out property <string> focus: fa ? "کار ژرف" : "Focus";
    out property <string> streak: fa ? "زنجیره" : "Streak";
    out property <string> consistency: fa ? "پیوستگی" : "Consistency";

    // ── settings ─────────────────────────────────────────────────────────
    out property <string> settings: fa ? "تنظیمات" : "Settings";
    out property <string> done: fa ? "تمام" : "Done";

    out property <string> sec-timer: fa ? "زمان‌سنج" : "TIMER";
    out property <string> lbl-work: fa ? "کار ژرف" : "Deep work";
    out property <string> lbl-short: fa ? "آسایش کوتاه" : "Short break";
    out property <string> lbl-long: fa ? "آسایش دراز" : "Long break";
    out property <string> lbl-long-every: fa ? "آسایش دراز پس از هر" : "Long break every";

    out property <string> sec-goal: fa ? "هدف روزانه" : "DAILY GOAL";
    out property <string> lbl-goal: fa ? "دقیقهٔ کار ژرف در روز" : "Deep work minutes per day";

    out property <string> sec-behaviour: fa ? "کنش" : "BEHAVIOUR";
    out property <string> lbl-autostart-next: fa ? "آغاز خودکار نشست بعدی" : "Auto-start next session";
    out property <string> lbl-autostart-launch: fa ? "آغاز خودکار هنگام راه‌اندازی" : "Auto-start on launch";

    out property <string> sec-heritage: fa ? "گنجینهٔ نیاکان" : "HERITAGE";
    out property <string> lbl-eras: fa ? "دودمان‌های ایران" : "Iranian dynasties";
    out property <string> era-cyrus: fa ? "کوروش" : "Cyrus";
    out property <string> era-darius: fa ? "داریوش" : "Darius";
    out property <string> era-parthian: fa ? "اشکانی" : "Parthian";
    out property <string> era-sasanid: fa ? "ساسانی" : "Sasanid";
    out property <string> era-cyrus-blurb: fa ? "آخامنشی" : "Achaemenid";
    out property <string> era-darius-blurb: fa ? "پارسه" : "Persepolis";
    out property <string> era-parthian-blurb: fa ? "لاجورد" : "Lapis";
    out property <string> era-sasanid-blurb: fa ? "زنگار" : "Verdigris";

    out property <string> sec-appearance: fa ? "آرایه" : "APPEARANCE";
    out property <string> lbl-theme: fa ? "پوسته" : "Theme";
    out property <string> theme-system: fa ? "سامانه" : "System";
    out property <string> theme-dark: fa ? "تاریک" : "Dark";
    out property <string> theme-light: fa ? "روشن" : "Light";
    out property <string> lbl-compact: fa ? "پنجرهٔ کوچک" : "Compact window";
    out property <string> lbl-animations: fa ? "پویانمایی" : "Animations";
    out property <string> hint-animations: fa
        ? "گذارها و حرکت نرم؛ خاموش کنید تا برنامه سبک‌تر شود."
        : "Smooth transitions and motion; turn off for a lighter app.";

    out property <string> sec-language: fa ? "زبان" : "LANGUAGE";
    out property <string> lbl-language: fa ? "زبان برنامه" : "App language";
    out property <string> lang-fa: "فارسی";
    out property <string> lang-en: "English";

    out property <string> sec-sound: fa ? "آوا" : "SOUND";
    out property <string> lbl-sound-on: fa ? "آواها روشن" : "Enable sounds";
    out property <string> lbl-chime: fa ? "آهنگ پایان" : "Chime";
    out property <string> preview: fa ? "شنیدن" : "Preview";
    out property <string> snd-santur: fa ? "سنتور" : "Santur";
    out property <string> snd-daf: fa ? "دف" : "Daf";
    out property <string> snd-tombak: fa ? "تنبک" : "Tombak";
    out property <string> snd-karn: fa ? "کرنای" : "Karnay";
    out property <string> snd-sand: fa ? "سنج" : "Cymbal";
    out property <string> snd-cyrus: fa ? "کوروش" : "Cyrus";

    out property <string> sec-system: fa ? "سامانه" : "SYSTEM";
    out property <string> lbl-hotkeys: fa ? "کلیدهای میان‌بر همگانی" : "Global hotkeys";
    out property <string> lbl-awake: fa ? "نمایش روشن بماند" : "Keep screen awake";
    out property <string> lbl-overlay: fa ? "پوشش هنگام آسایش" : "Break overlay";

    out property <string> sec-automation: fa ? "خودکاری" : "AUTOMATION";
    out property <string> automation-placeholder: fa ? "دستور، مانند playerctl pause" : "command, e.g. playerctl pause";
    out property <string> add: fa ? "افزودن" : "Add";
    out property <string> automation-hint: fa ? "هنگام آغاز کار ژرف اجرا می‌شود. متغیرها: %event%، %session%." : "Runs on focus_start. Variables: %event%, %session%.";

    out property <string> sec-cloud: fa ? "همگام‌سازی با گوگل" : "GOOGLE SYNC";
    out property <string> backup: fa ? "پشتیبان‌گیری" : "Back up";
    out property <string> restore: fa ? "بازگردانی" : "Restore";

    // --- Google account sync ---
    out property <string> sync-title: fa ? "همگام‌سازی خودکار" : "Automatic sync";
    out property <string> sync-blurb: fa ? "با حساب گوگل وارد شوید تا کارها و تاریخ تمرکز روی همهٔ دستگاه‌ها یکی بماند." : "Sign in with Google to keep your tasks and focus history the same on every device.";
    out property <string> sync-connect: fa ? "اتصال به گوگل" : "Connect Google";
    out property <string> sync-disconnect: fa ? "قطع اتصال" : "Disconnect";
    out property <string> sync-connected: fa ? "متصل" : "Connected";
    out property <string> sync-off: fa ? "وصل نشده" : "Not connected";
    out property <string> sync-auto: fa ? "همگام‌سازی خودکار" : "Sync automatically";
    out property <string> sync-code-hint: fa ? "این کد را در google.com/device وارد کنید" : "Enter this code at google.com/device";
    // The sign-in card walks the user through it in three numbered steps,
    // because the device flow is unfamiliar: a code appears, a browser opens,
    // the code goes in.
    out property <string> sync-step-1: fa ? "۱. دکمهٔ زیر را بزنید" : "1. Press the button below";
    out property <string> sync-step-2: fa ? "۲. مرورگر خودکار باز می‌شود" : "2. Your browser opens automatically";
    out property <string> sync-step-3: fa ? "۳. کد را وارد کنید و تأیید بزنید" : "3. Enter the code and approve";
    out property <string> sync-open-browser: fa ? "باز کردن مرورگر" : "Open browser";
    out property <string> sync-copy-code: fa ? "رونوشت کد" : "Copy code";
    out property <string> sync-copied: fa ? "رونوشت شد" : "Copied";
    out property <string> sync-signed-in-hint: fa
        ? "همگام‌سازی خودکار روشن است؛ هر تغییری خودش فرستاده می‌شود."
        : "Automatic sync is on; every change is sent on its own.";
    out property <string> sync-waiting: fa ? "در انتظار تأیید…" : "Waiting for approval…";
    out property <string> sync-copy: fa ? "کپی نشانی" : "Copy link";
    out property <string> sync-no-client: fa ? "این نسخه برای گوگل ثبت نشده است" : "This build is not registered with Google";
    out property <string> sync-client-hint: fa ? "این نسخه هنوز برای گوگل ثبت نشده است. شناسهٔ کلاینت خود را از Google Cloud Console بچسبانید." : "This build is not registered with Google yet. Paste your own client id from Google Cloud Console.";
    out property <string> sync-client-steps: fa
        ? "در Google Cloud Console پروژه بسازید، Google Drive API را روشن کنید، و یک کلاینت OAuth از نوع «TV and Limited Input» بسازید. شناسهٔ آن را اینجا بچسبانید."
        : "In Google Cloud Console create a project, enable the Drive API, and create an OAuth client of type \"TV and Limited Input\". Paste its id here.";
    out property <string> sync-console: fa ? "گشودن Google Cloud Console" : "Open Google Cloud Console";
    out property <string> sync-save-id: fa ? "ذخیرهٔ شناسه" : "Save id";
    out property <string> sync-client-placeholder: fa ? "شناسهٔ کلاینت…apps.googleusercontent.com" : "client id…apps.googleusercontent.com";
    out property <string> sync-last: fa ? "آخرین همگام‌سازی" : "Last sync";
    // The button under this label does a sync right now; the label above the
    // card says when the last one happened. Naming the button after the status
    // made it read as a readout, and users pressed it expecting nothing to
    // happen.
    out property <string> sync-now: fa ? "همگام‌سازی همین حالا" : "Sync now";
    out property <string> sync-this-device: fa ? "این دستگاه" : "This device";
    out property <string> sync-settings-note: fa
        ? "تنظیمات ظاهری، زمان‌ها و صداها هم بین دستگاه‌ها همگام می‌شوند. کلیدهای میان‌بر، فرمان‌های خودکار و حالت فشرده مخصوص همین دستگاه می‌مانند."
        : "Appearance, durations and sounds sync too. Hotkeys, automation commands and compact mode stay on this machine.";
    out property <string> sync-settings-note-title: fa ? "چه چیزی همگام می‌شود" : "What syncs";

    out property <string> sec-about: fa ? "شناسنامه" : "ABOUT";
    out property <string> emblem-credit: fa ? "نماد اشکانی از Oneasy، پروانهٔ هنر آزاد ۱٫۳" : "Parthian emblem by Oneasy, Free Art License 1.3";

    // ── imperial identity ────────────────────────────────────────────────
    // Each dynasty carries its span and one line of history, so the heritage
    // section teaches something instead of only recolouring the app.
    out property <string> era-cyrus-span: fa ? "۵۵۹ – ۵۳۰ پ.م." : "559 – 530 BC";
    out property <string> era-darius-span: fa ? "۵۲۲ – ۴۸۶ پ.م." : "522 – 486 BC";
    out property <string> era-parthian-span: fa ? "۲۴۷ پ.م. – ۲۲۴ م." : "247 BC – 224 AD";
    out property <string> era-sasanid-span: fa ? "۲۲۴ – ۶۵۱ م." : "224 – 651 AD";

    out property <string> era-cyrus-note: fa
        ? "بنیان‌گذار شاهنشاهی هخامنشی؛ منشور کوروش نخستین اعلام آزادی دین و بردگان."
        : "Founder of the Achaemenid Empire; the Cyrus Cylinder is the first decree of religious and slave emancipation.";
    out property <string> era-darius-note: fa
        ? "سازندهٔ پارسه و راه شاهی؛ نخستین شبکهٔ پول و پیک سراسری در جهان باستان."
        : "Builder of Persepolis and the Royal Road; the first empire-wide coinage and courier network.";
    out property <string> era-parthian-note: fa
        ? "درفش کاویانی و نبردهای اشکانی؛ بازدارندهٔ روم در شرق برای چهار سده."
        : "The Derafsh Kaviani and Parthian cavalry; four centuries holding Rome at the Euphrates.";
    out property <string> era-sasanid-note: fa
        ? "شاهنشاهی ساسانی؛ سیم‌رغ و زنگار، اوج هنر و دیوان‌سالاری ایرانی."
        : "The Sasanian Empire; simurgh roundels and verdigris, the height of Iranian art and administration.";

    // The calendar's own name. The old pair of strings here was
    // "شاهنشاهی ایران · هزار سال فرمانروایی پیش از اسلام", which was both
    // inaccurate (Iranian rule runs well past a thousand years) and too long
    // to sit under the date without crowding it. This says what the calendar
    // is, in four words.
    out property <string> heritage-title: fa ? "گاه‌شمار پادشاهی ایران" : "Chronicle of the Iranian Kingdom";
    out property <string> heritage-sub: fa
        ? "از کوروش بزرگ تا امروز"
        : "From Cyrus the Great to the present";

    // ── Chronicle view: the imperial timeline ──────────────────────────────
    // A single scroll through Iranian rule, dynasty by dynasty. This is the
    // view that answers "how long have we been doing this", which the timer
    // and the calendar cannot.
    out property <string> nav-chronicle: fa ? "گاه‌شمار" : "Chronicle";
    out property <string> chron-title: fa ? "گاه‌شمار پادشاهی ایران" : "Chronicle of the Iranian Kingdom";
    out property <string> chron-sub: fa
        ? "دو هزار و پانصد سال فرمانروایی، از کوروش تا امروز"
        : "Two and a half thousand years of rule, from Cyrus to the present";
    out property <string> chron-span-label: fa ? "دوره" : "Span";
    out property <string> chron-capital-label: fa ? "پایتخت" : "Capital";
    out property <string> chron-figure-label: fa ? "چهرهٔ نامدار" : "Notable figure";
    out property <string> chron-legacy-label: fa ? "میراث" : "Legacy";

    // The dynasties, in order. Each carries the same four facts so the rows
    // read as a table rather than prose.
    out property <string> dyn-medes: fa ? "ماد" : "Medes";
    out property <string> dyn-medes-span: fa ? "۶۷۸ – ۵۵۰ پ.م." : "678 – 550 BC";
    out property <string> dyn-medes-capital: fa ? "هگمتانه" : "Ecbatana";
    out property <string> dyn-medes-figure: fa ? "دیاکو، هووخشتره" : "Deioces, Cyaxares";
    out property <string> dyn-medes-legacy: fa
        ? "نخستین گردآمدن ایرانیان زیر یک فرمان؛ هگمتانه و راه شاهی شرق."
        : "The first union of the Iranian peoples under one crown; Ecbatana and the eastern royal road.";

    out property <string> dyn-achaemenid: fa ? "هخامنشی" : "Achaemenid";
    out property <string> dyn-achaemenid-span: fa ? "۵۵۰ – ۳۳۰ پ.م." : "550 – 330 BC";
    out property <string> dyn-achaemenid-capital: fa ? "پارسه، شوش" : "Persepolis, Susa";
    out property <string> dyn-achaemenid-figure: fa ? "کوروش بزرگ، داریوش بزرگ" : "Cyrus the Great, Darius the Great";
    out property <string> dyn-achaemenid-legacy: fa
        ? "بزرگ‌ترین شاهنشاهی جهان باستان؛ منشور کوروش، راه شاهی، و نخستین دیوان جهانی."
        : "The largest empire of the ancient world; the Cyrus Cylinder, the Royal Road, the first world administration.";

    out property <string> dyn-seleucid: fa ? "سلوکی" : "Seleucid";
    out property <string> dyn-seleucid-span: fa ? "۳۱۲ – ۲۴۷ پ.م." : "312 – 247 BC";
    out property <string> dyn-seleucid-capital: fa ? "سلوکیه" : "Seleucia";
    out property <string> dyn-seleucid-figure: fa ? "سلوکوس، آنتیوخوس" : "Seleucus, Antiochus";
    out property <string> dyn-seleucid-legacy: fa
        ? "دورهٔ هلنی میان هخامنشی و اشکانی؛ ایرانیان در آن پارسه را رها نکردند."
        : "The Hellenistic interlude between Achaemenid and Parthian; the Iranians never abandoned Persepolis.";

    out property <string> dyn-parthian: fa ? "اشکانی" : "Parthian";
    out property <string> dyn-parthian-span: fa ? "۲۴۷ پ.م. – ۲۲۴ م." : "247 BC – 224 AD";
    out property <string> dyn-parthian-capital: fa ? "نسـا، تیسفون" : "Nisa, Ctesiphon";
    out property <string> dyn-parthian-figure: fa ? "مهرداد یکم، سورنا" : "Mithridates I, Surena";
    out property <string> dyn-parthian-legacy: fa
        ? "درفش کاویانی و سواره‌نظام سنگین؛ چهار سده روم را در فرات نگه داشت."
        : "The Derafsh Kaviani and heavy cavalry; four centuries holding Rome at the Euphrates.";

    out property <string> dyn-sasanid: fa ? "ساسانی" : "Sasanian";
    out property <string> dyn-sasanid-span: fa ? "۲۲۴ – ۶۵۱ م." : "224 – 651 AD";
    out property <string> dyn-sasanid-capital: fa ? "تیسفون، بیشاپور" : "Ctesiphon, Bishapur";
    out property <string> dyn-sasanid-figure: fa ? "اردشیر بابکان، خسرو انوشیروان" : "Ardashir I, Khosrow Anushirvan";
    out property <string> dyn-sasanid-legacy: fa
        ? "اوج هنر و دیوان‌سالاری ایرانی؛ سیم‌رغ، زنگار، و آیین کشورداری که به سه قاره رسید."
        : "The height of Iranian art and administration; the simurgh, verdigris, and a statecraft that reached three continents.";

    out property <string> dyn-safavid: fa ? "صفوی" : "Safavid";
    out property <string> dyn-safavid-span: fa ? "۱۵۰۱ – ۱۷۳۶ م." : "1501 – 1736 AD";
    out property <string> dyn-safavid-capital: fa ? "تبریز، اصفهان" : "Tabriz, Isfahan";
    out property <string> dyn-safavid-figure: fa ? "شاه اسماعیل، شاه عباس" : "Shah Ismail, Shah Abbas";
    out property <string> dyn-safavid-legacy: fa
        ? "بازگرداندن یکپارچگی ایران پس از هشت سده؛ اصفهان پایتخت نیم جهان."
        : "Restored Iranian unity after eight centuries; Isfahan, the capital that was half the world.";

    out property <string> dyn-afsharid: fa ? "افشاری" : "Afsharid";
    out property <string> dyn-afsharid-span: fa ? "۱۷۳۶ – ۱۷۹۶ م." : "1736 – 1796 AD";
    out property <string> dyn-afsharid-capital: fa ? "مشهد" : "Mashhad";
    out property <string> dyn-afsharid-figure: fa ? "نادرشاه" : "Nader Shah";
    out property <string> dyn-afsharid-legacy: fa
        ? "بازپس‌گیری مرزهای شمالی و شرقی؛ آخرین لشکرکشی بزرگ ایرانی به بیرون."
        : "Recovered the northern and eastern frontiers; the last great Iranian campaign abroad.";

    out property <string> dyn-zand: fa ? "زند" : "Zand";
    out property <string> dyn-zand-span: fa ? "۱۷۵۱ – ۱۷۹۴ م." : "1751 – 1794 AD";
    out property <string> dyn-zand-capital: fa ? "شیراز" : "Shiraz";
    out property <string> dyn-zand-figure: fa ? "کریم‌خان زند" : "Karim Khan Zand";
    out property <string> dyn-zand-legacy: fa
        ? "چهل سال آرامش؛ شیراز، ارگ و بازار وکیل."
        : "Forty years of peace; Shiraz, the citadel and the Vakil bazaar.";

    out property <string> dyn-qajar: fa ? "قاجار" : "Qajar";
    out property <string> dyn-qajar-span: fa ? "۱۷۸۹ – ۱۹۲۵ م." : "1789 – 1925 AD";
    out property <string> dyn-qajar-capital: fa ? "تهران" : "Tehran";
    out property <string> dyn-qajar-figure: fa ? "فتحعلی‌شاه، امیرکبیر" : "Fath-Ali Shah, Amir Kabir";
    out property <string> dyn-qajar-legacy: fa
        ? "تهران پایتخت شد؛ دارالفنون و نخستین نهادهای نوین ایران."
        : "Tehran became the capital; the first modern Iranian institutions and the Dar ul-Funun.";

    out property <string> dyn-pahlavi: fa ? "پهلوی" : "Pahlavi";
    out property <string> dyn-pahlavi-span: fa ? "۱۹۲۵ – ۱۹۷۹ م." : "1925 – 1979 AD";
    out property <string> dyn-pahlavi-capital: fa ? "تهران" : "Tehran";
    out property <string> dyn-pahlavi-figure: fa ? "رضاشاه، محمدرضاشاه" : "Reza Shah, Mohammad Reza Shah";
    out property <string> dyn-pahlavi-legacy: fa
        ? "راه‌آهن سراسری، دانشگاه تهران، و جشن‌های دوهزار و پانصد ساله."
        : "The trans-Iranian railway, the University of Tehran, and the 2,500-year celebrations.";

    out property <string> chron-foot: fa
        ? "این گاه‌شمار پیوسته است: هر سلسله از دل سلسلهٔ پیش برخاست و همان سرزمین را نگه داشت."
        : "The chronicle is continuous: each dynasty rose from the last and held the same land.";
}
