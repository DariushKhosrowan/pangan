// ═══════════════════════════════════════════════════════════════════════════
// heritage.slint — pre-Islamic Iranian emblems, loaded from real artwork.
//
// The glyphs are NOT drawn here. Each one is an authentic emblem sourced from
// Wikimedia Commons, converted to a white-on-transparent mask so it can be
// tinted to the active era palette at any size.
//
//   Shahbaz      Achaemenid falcon standard  — Cyrus the Great
//                File:Achaemenid Falcon.svg (public domain, Sodacan)
//   Faravahar    Winged disc, Achaemenid     — Darius / Persepolis
//                File:Faravahar-Gold.svg (public domain, Shaahin)
//   Derafsh      Derafsh Kaviani, Sasanian   — Parthian era
//                File:Derafsh kaviani standard.svg (Free Art License, Oneasy)
//   Senmurv      Sasanian simurgh in roundel — Sasanid era
//                File:Senmurv.svg (public domain, Shaahin)
//
// No Islamic-era ornament (girih, shamsa, iwan) appears anywhere in this app.
// ═══════════════════════════════════════════════════════════════════════════

// Achaemenid Shahbaz — the falcon standard of Cyrus the Great.
component Shahbaz {
    in property <length> size: 40px;
    in property <brush> color: #D6A84E;
    in property <float> fade: 1;

    width: size;
    height: size;

    Image {
        source: @image-url("assets/cyrus.png");
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        colorize: root.color;
        opacity: root.fade;
    }
}

// Faravahar — Achaemenid winged disc with the human bust.
component Faravahar {
    in property <length> size: 40px;
    in property <brush> color: #D6A84E;
    in property <float> fade: 1;

    width: size;
    height: size;

    Image {
        source: @image-url("assets/darius.png");
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        colorize: root.color;
        opacity: root.fade;
    }
}

// Derafsh Kaviani — the Sasanian imperial standard.
component Derafsh {
    in property <length> size: 40px;
    in property <brush> color: #D6A84E;
    in property <float> fade: 1;

    width: size;
    height: size;

    Image {
        source: @image-url("assets/parthian.png");
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        colorize: root.color;
        opacity: root.fade;
    }
}

// Senmurv — Sasanian simurgh inside a pearl roundel.
component Senmurv {
    in property <length> size: 40px;
    in property <brush> color: #D6A84E;
    in property <float> fade: 1;

    width: size;
    height: size;

    Image {
        source: @image-url("assets/sasanid.png");
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        colorize: root.color;
        opacity: root.fade;
    }
}

// Boteh — the Iranian paisley, pre-Islamic in origin (cypress / flame reading).
component Boteh {
    in property <length> size: 40px;
    in property <brush> color: #D6A84E;
    in property <float> fade: 1;

    width: size * 0.8;
    height: size;

    Image {
        source: @image-url("assets/boteh.png");
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        colorize: root.color;
        opacity: root.fade;
    }
}

// A hairline rule with a boteh centred in it — used to separate sections.
component BotehDivider {
    in property <brush> color: #D6A84E;
    in property <float> fade: 0.5;
    in property <length> emblem-size: 14px;

    height: emblem-size;

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: (parent.width - root.emblem-size * 2) / 2;
        height: 1px;
        background: root.color;
        opacity: root.fade * 0.55;
    }
    Boteh {
        x: (parent.width - self.width) / 2;
        y: 0px;
        size: root.emblem-size;
        color: root.color;
        fade: root.fade;
    }
    Rectangle {
        x: (parent.width + root.emblem-size * 2) / 2;
        y: (parent.height - self.height) / 2;
        width: (parent.width - root.emblem-size * 2) / 2;
        height: 1px;
        background: root.color;
        opacity: root.fade * 0.55;
    }
}

// Faint repeating emblem field, used as a surface grain.
component EmblemField {
    in property <int> cols: 6;
    in property <int> rows: 10;
    in property <brush> color: #D6A84E;
    in property <float> fade: 0.05;
    in property <int> emblem: 0;

    for i in root.rows * root.cols : Rectangle {
        x: Math.mod(i, root.cols) * (root.width / root.cols);
        y: (i / root.cols) * (root.height / root.rows);
        width: root.width / root.cols;
        height: root.height / root.rows;
        background: transparent;

        if root.emblem == 0 : Image {
            source: @image-url("assets/darius.png");
            width: 100%; height: 100%;
            image-fit: contain;
            colorize: root.color;
            opacity: root.fade;
        }
        if root.emblem == 1 : Image {
            source: @image-url("assets/sasanid.png");
            width: 100%; height: 100%;
            image-fit: contain;
            colorize: root.color;
            opacity: root.fade;
        }
        if root.emblem == 2 : Image {
            source: @image-url("assets/cyrus.png");
            width: 100%; height: 100%;
            image-fit: contain;
            colorize: root.color;
            opacity: root.fade;
        }
        if root.emblem == 3 : Image {
            source: @image-url("assets/boteh.png");
            width: 100%; height: 100%;
            image-fit: contain;
            colorize: root.color;
            opacity: root.fade;
        }
    }
}

export { Shahbaz, Faravahar, Derafsh, Senmurv, Boteh, BotehDivider, EmblemField }
