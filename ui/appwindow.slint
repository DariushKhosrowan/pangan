import { LineEdit } from "std-widgets.slint";
import { Shahbaz, Faravahar, Derafsh, Senmurv, Boteh, BotehDivider, EmblemField, SteppedCrenellation, LotusRow, WingedDivider, ArchFrame } from "heritage.slint";
import { SunRing } from "ring.slint";
import { Digits } from "digits.slint";
import { Strings } from "strings.slint";
import { Motion } from "motion.slint";
export { Strings } from "strings.slint";
export { Digits } from "digits.slint";
export { Motion } from "motion.slint";

// ═══════════════════════════════════════════════════════════════════════════
// Pangan — پنگان
//
// Design language: calm, near-monochrome, generous whitespace. A single
// gilded accent carries the Persian identity without shouting it. The timer
// is the hero: a large light-weight numeral inside a true progress ring,
// flanked by three circular controls. Everything else recedes.
//
// Inspired by the restraint of FocusTimer (GNOME), rebuilt for Slint.
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────
// Palette — one source of truth for both themes.
// ───────────────────────────────────────────────────────────────────────────
export global Palette {
    in-out property <bool> dark: true;
    // Which dynasty's palette is active: cyrus | darius | parthian | sasanid
    // All four are pre-Islamic. No Islamic-era ornament is used in this app.
    in-out property <string> era: "cyrus"; // ── Era accents ────────────────────────────────────────────────────────
    // Cyrus: Achaemenid gold. Darius: Persepolis bronze. All pre-Islamic.
    // Parthian: lapis blue. Sasanid: verdigris silver.
    // The light-theme accents are deliberately darker than the dark-theme
    // ones. The same hue cannot serve both: gold at #A67A2B on an off-white
    // page is 3.5:1, which is not readable text, while the same gold on the
    // dark page is 8.7:1. Each theme gets the lightness its background needs,
    // and every value here clears 4.5:1 against both the page and a card.
    out property <brush> accent: era == "darius"
        ? (dark ? #C87941 : #8A4A1C)
        : era == "sasanid"
        ? (dark ? #4FA89B : #216158)
        : era == "parthian"
        ? (dark ? #5B8FD6 : #2A5495)
        : (dark ? #D6A84E : #8A6419); out property <brush> accent-soft: era == "darius"
        ? (dark ? #2A2018 : #F5E9DC)
        : era == "sasanid"
        ? (dark ? #14251F : #E2F0EC)
        : era == "parthian"
        ? (dark ? #141C2E : #E3E9F5)
        : (dark ? #2A2418 : #F3EAD8); out property <brush> on-accent: era == "darius"
        ? (dark ? #1A0F06 : #FFFFFF)
        : era == "sasanid"
        ? (dark ? #04120F : #FFFFFF)
        : era == "parthian"
        ? (dark ? #060B16 : #FFFFFF)
        : (dark ? #17120A : #FFFFFF); // ── Surfaces, tinted per era ───────────────────────────────────────────
    out property <brush> bg: era == "darius"
        ? (dark ? #12100C : #FAF6EF)
        : era == "sasanid"
        ? (dark ? #0A1413 : #F2F7F5)
        : era == "parthian"
        ? (dark ? #0B0F1A : #F3F5FA)
        : (dark ? #0E1016 : #F7F5F0); out property <brush> surface: era == "darius"
        ? (dark ? #1A1712 : #FFFFFF)
        : era == "sasanid"
        ? (dark ? #111D1B : #FFFFFF)
        : era == "parthian"
        ? (dark ? #131A28 : #FFFFFF)
        : (dark ? #15181F : #FFFFFF); out property <brush> surface-2: era == "darius"
        ? (dark ? #221D16 : #F2ECE1)
        : era == "sasanid"
        ? (dark ? #17251F : #E9F1EE)
        : era == "parthian"
        ? (dark ? #1A2334 : #E8EDF6)
        : (dark ? #1C2029 : #F0EDE6); out property <brush> surface-3: era == "darius"
        ? (dark ? #2A241B : #E8DFD0)
        : era == "sasanid"
        ? (dark ? #1E2E28 : #DCE8E4)
        : era == "parthian"
        ? (dark ? #212C40 : #DCE3F0)
        : (dark ? #232833 : #E7E2D8); out property <brush> border: era == "darius"
        ? (dark ? #2C261D : #E5DCCB)
        : era == "sasanid"
        ? (dark ? #20302A : #D9E5E1)
        : era == "parthian"
        ? (dark ? #232F45 : #D8E0EE)
        : (dark ? #262A35 : #E3DED3); out property <brush> hairline: era == "darius"
        ? (dark ? #221D15 : #EFE8DC)
        : era == "sasanid"
        ? (dark ? #182722 : #E8F0ED)
        : era == "parthian"
        ? (dark ? #1A2334 : #E7ECF5)
        : (dark ? #1E222B : #EDE9E1); out property <brush> text: dark ? #E9E7EF : #1B1A20; out property <brush> text-dim: dark ? #9A9DAD : #6B6774; out property <brush> text-faint: dark ? #868B9C : #726D7A; out property <brush> track: era == "darius"
        ? (dark ? #2A241B : #E8DFD0)
        : era == "sasanid"
        ? (dark ? #1E2E28 : #DCE8E4)
        : era == "parthian"
        ? (dark ? #212C40 : #DCE3F0)
        : (dark ? #232833 : #E7E2D8); // The accent, one step deeper. Used for the pressed/hover state of any
    // control filled with the accent, so the label keeps its contrast: white
    // on the light-theme gold goes from 5.36:1 to 6.12:1, where a lightened
    // hover dropped it to 4.40:1.
    out property <brush> accent-strong: era == "darius"
        ? (dark ? #D0834C : #7E4419)
        : era == "sasanid"
        ? (dark ? #5CB4A8 : #1E5950)
        : era == "parthian"
        ? (dark ? #6E9CDA : #264D89)
        : (dark ? #DAB263 : #7E5C17); // A shadow that works on both themes: a warm grey at low alpha in light, a
    // true black in dark. A grey shadow on a dark page reads as a smudge.
    out property <color> shadow: dark ? #00000066 : #2A211433; out property <brush> danger: dark ? #C9635B : #B04A42; }

export struct TaskItem {
    id: int,
    title: string,
    time: string,
    done: bool,
}

// One "on this day" row.
export struct CalEvent {
    section: string,   // گروه: رخداد / زادروز / درگذشت / مناسبت
    year: string,      // "۱۱۹۲" or ""
    text: string,
}

// One square of the month grid.
export struct DayCell {
    day: int,          // 0 for the blanks that pad the first week
    label: string,     // the day in Persian digits, or ""
    key: string,       // "1405-08-07", or "" for a blank
    is-today: bool,
    selected: bool,
    has-tasks: bool,   // at least one open task on this day
    open-count: string, // how many, in Persian digits, or ""
}

// One week of the month grid. Slint's GridLayout has no explicit column count,
// so the grid is built as a list of rows of seven rather than one flat list.
export struct DayRow {
    cells: [DayCell],
}

// ───────────────────────────────────────────────────────────────────────────
// Icons — drawn, not glyphs, so they stay crisp and identical everywhere.
// ───────────────────────────────────────────────────────────────────────────
component Icon {
    in property <string> kind: "play";
    in property <length> size: 18px;
    in property <brush> color: Palette.text;

    width: size;
    height: size;

    if kind == "play" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 8 5 L 19 12 L 8 19 Z";
    }
    if kind == "pause" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 8 5 h 3 v 14 h -3 Z M 14 5 h 3 v 14 h -3 Z";
    }
    if kind == "skip" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 6 5 L 15 12 L 6 19 Z M 17 5 h 2 v 14 h -2 Z";
    }
    if kind == "reset" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 12 4 A 8 8 0 1 0 20 12 L 17.5 12 A 5.5 5.5 0 1 1 12 6.5 L 12 9.5 L 8 6 L 12 2.5 Z";
    }
    if kind == "sliders" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 4 7 h 16 M 4 12 h 16 M 4 17 h 16";
    }
    if kind == "close" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 6 6 L 18 18 M 18 6 L 6 18";
    }
    if kind == "plus" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 5 v 14 M 5 12 h 14";
    }
    if kind == "check" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 5 12.5 L 10 17.5 L 19 6.5";
    }
    if kind == "timer" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 4 A 8 8 0 1 0 20 12 A 8 8 0 0 0 12 4 Z M 12 8 v 4.5 l 3 2";
    }
    if kind == "chart" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 2px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 6 19 v -5 M 12 19 v -11 M 18 19 v -8";
    }
    if kind == "chevron" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 9 5 L 16 12 L 9 19";
    }
    if kind == "back" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 15 5 L 8 12 L 15 19";
    }
    if kind == "moon" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 20 14.5 A 8.5 8.5 0 1 1 9.5 4 A 7 7 0 0 0 20 14.5 Z";
    }
    if kind == "sun" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 7.5 A 4.5 4.5 0 1 0 12 16.5 A 4.5 4.5 0 0 0 12 7.5 Z M 12 2 v 2 M 12 20 v 2 M 2 12 h 2 M 20 12 h 2 M 5 5 l 1.5 1.5 M 17.5 17.5 L 19 19 M 19 5 L 17.5 6.5 M 6.5 17.5 L 5 19";
    }
    // Pencil: a slanted nib with a baseline, for rename.
    if kind == "edit" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4 20 h 4 L 19 9 L 15 5 L 4 16 Z M 14 6 L 18 10";
    }
    // Bin: a lid, a body and two ribs, for delete.
    if kind == "trash" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4 7 h 16 M 9 7 V 4 h 6 v 3 M 6 7 l 1 13 h 10 l 1 -13 M 10 11 v 5 M 14 11 v 5";
    }
}

// ───────────────────────────────────────────────────────────────────────────
// TaskAction — one of the small per-task controls (move, rename, delete).
//
// Kept deliberately quiet: at rest it is barely visible, and it only takes on
// colour on hover. Four always-lit icons on every row would turn a task list
// into a toolbar.
// ───────────────────────────────────────────────────────────────────────────
component TaskAction inherits Rectangle {
    in property <string> icon: "edit";
    /// What this control does, in words. Icon-only buttons are invisible to a
    /// screen reader, so the label is what makes them usable without sight.
    in property <string> tip: "";
    /// Turns the icon red on hover. Used for delete, so the destructive action
    /// reads as destructive before it is clicked.
    in property <bool> destructive: false;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.tip;

    ta-act := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    states [
        hovered when ta-act.has-hover : {
            background: Palette.surface-3;
            in { animate background { duration: Motion.quick; } }
        }
    ]

    Icon {
        kind: root.icon;
        size: 13px;
        // text-faint was too pale to see against the card, which made the
        // controls look absent rather than quiet. text-dim is legible at rest
        // and still recedes behind the task title.
        color: root.destructive && ta-act.has-hover
            ? Palette.danger
            : (ta-act.has-hover ? Palette.text : Palette.text-dim);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ───────────────────────────────────────────────────────────────────────────
// DayStep — the previous/next-day button on the timer screen.
//
// A rounded square rather than a circle, so it reads as a control beside the
// date block instead of another round icon competing with the timer's own
// round buttons. The chevron is a single clean stroke; on hover the tile lifts
// to the accent tint and the chevron darkens, and on press it scales down a
// touch so the click is felt.
// ───────────────────────────────────────────────────────────────────────────
component DayStep inherits Rectangle {
    in property <bool> forward: false; callback clicked; width: 32px; height: 32px; border-radius: 16px; background: transparent; border-width: 1px; border-color: transparent; ta := TouchArea { clicked => { root.clicked(); } }

    states [
        hovered when ta.has-hover : {
            background: Palette.accent-soft; border-color: Palette.accent; in { animate background { duration: Motion.quick; } animate border-color { duration: Motion.quick; } }
        }
        pressed when ta.pressed : {
            background: Palette.accent; in { animate background { duration: Motion.instant; } }
        }
    ]

    // The chevron. `forward` mirrors it, so one path serves both directions.
    Icon {
        kind: root.forward ? "chevron" : "back"; size: 15px; color: ta.pressed ? Palette.on-accent : (ta.has-hover ? Palette.accent : Palette.text-dim); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

// ───────────────────────────────────────────────────────────────────────────
// IconButton — circular, quiet by default, warms on hover.
// ───────────────────────────────────────────────────────────────────────────
component IconButton inherits Rectangle {
    in property <string> icon: "play";
    in property <length> size: 34px;
    in property <length> icon-size: 17px;
    in property <brush> fg: Palette.text-dim;
    in property <brush> hover-bg: Palette.surface-2;
    callback clicked;

    width: size;
    height: size;
    border-radius: size / 2;
    background: transparent;

    ta1 := TouchArea {
        clicked => { root.clicked(); }
    }

    Icon {
        kind: root.icon;
        size: root.icon-size;
        color: root.fg;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    states [
        hovered when ta1.has-hover : {
            background: root.hover-bg;
            in {
                animate background { duration: Motion.quick; easing: ease-out; }
            }
        }
    ]
}

// ───────────────────────────────────────────────────────────────────────────
// TimerButton — the transport controls under the clock.
//
// These used to be bare icons floating on the page with no surface at all,
// which is why they read as decoration rather than as buttons: nothing told
// you they were pressable. Each one now sits on a real surface with a hairline,
// and the primary (play/pause) is filled with the accent so the row has one
// obvious target. Hover deepens the fill instead of replacing it with
// Palette.text, which made the button look like it had changed identity.
// ───────────────────────────────────────────────────────────────────────────
component TimerButton inherits Rectangle {
    in property <string> icon: "reset";
    in property <length> size: 44px;
    in property <length> icon-size: 18px;
    in property <bool> primary: false;
    in property <bool> running: false;
    callback clicked;

    width: size;
    height: size;
    // A Rectangle in a HorizontalLayout stretches to fill by default, which
    // turned all three of these into full-width bars. Pin them to their size.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: size / 2;

    // Primary carries the accent and a shadow so it sits above the row;
    // secondary is a quiet tile that only wakes on hover.
    //
    // The secondary fill is `surface` (white in light, the card colour in
    // dark) rather than `surface-2`, because surface-2 is only 1.07:1 against
    // the page — the tiles were there but invisible, so the icons looked like
    // they were floating loose on the background. White plus a real hairline
    // gives them an edge without making them shout.
    background: primary ? Palette.accent : Palette.surface;
    border-width: primary ? 0px : 1px;
    border-color: primary ? transparent : Palette.border;
    // A tight shadow. At 10px blur on a light page the shadow spread wider
    // than the button and read as a pale rectangle behind the whole row.
    drop-shadow-blur: primary ? 5px : 0px;
    drop-shadow-color: primary ? Palette.shadow : transparent;
    drop-shadow-offset-y: primary ? 2px : 0px;

    ta := TouchArea { clicked => { root.clicked(); } }

    states [
        hovered when ta.has-hover && !primary : {
            background: Palette.surface-3;
            border-color: Palette.accent;
            in { animate background { duration: Motion.quick; } animate border-color { duration: Motion.quick; } }
        }
        hovered-primary when ta.has-hover && primary : {
            background: Palette.accent-strong;
            in { animate background { duration: Motion.quick; } }
        }
        pressed when ta.pressed : {
            drop-shadow-blur: 0px;
            drop-shadow-offset-y: 0px;
            in { animate drop-shadow-blur { duration: Motion.instant; } }
        }
    ]

    Icon {
        kind: root.icon;
        size: root.icon-size;
        // The play triangle is optically left-heavy, so it is nudged right to
        // sit in the circle's true centre. Pause is symmetric and is not.
        color: root.primary ? Palette.on-accent : (ta.has-hover ? Palette.accent : Palette.text-dim); x: (parent.width - self.width) / 2 + (root.primary && root.icon == "play" ? 2px : 0px); y: (parent.height - self.height) / 2; }
}

// ───────────────────────────────────────────────────────────────────────────
// Ring — a true arc progress ring with a rounded cap.
// ───────────────────────────────────────────────────────────────────────────
component Ring {
    in property <float> progress: 0;
    in property <float> d: 236;
    in property <float> t: 7;
    in property <brush> track-color: Palette.track;
    in property <brush> fill-color: Palette.accent;
    in property <bool> glow: false;
    // Dot count for the progress arc. High enough that neighbouring dots
    // overlap and the arc reads as one continuous stroke.
    in property <int> steps: 180;

    width: d * 1px;
    height: d * 1px;

    pure function cx() -> float { return d / 2; }
    pure function rad() -> float { return (d - t) / 2; }
    pure function ax(i: int) -> float { return cx() + rad() * sin(360deg * (i * 1.0 / steps)); }
    pure function ay(i: int) -> float { return cx() - rad() * cos(360deg * (i * 1.0 / steps)); }

    // Soft halo behind the ring while a session is running.
    if glow : Rectangle {
        width: parent.width - 2 * t * 1px;
        height: parent.height - 2 * t * 1px;
        x: t * 1px;
        y: t * 1px;
        border-radius: self.width / 2;
        background: Palette.accent;
        opacity: 0.05;
    }

    // Track: a true stroked circle, so it is continuous at any size.
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        background: transparent;
        border-width: root.t * 1px;
        border-color: track-color;
    }

    // Progress: overlapping dots swept from 12 o'clock, clockwise.
    for i in root.steps : Rectangle {
        width: root.t * 1px; height: root.t * 1px; border-radius: root.t * 0.5px; background: fill-color; x: (root.ax(i) - root.t / 2) * 1px; y: (root.ay(i) - root.t / 2) * 1px; visible: (i * 1.0 / root.steps) < root.progress; }
}

// ───────────────────────────────────────────────────────────────────────────
// Segmented — a quiet two-or-three way switch.
// ───────────────────────────────────────────────────────────────────────────
component Segmented inherits Rectangle {
    in property <[string]> options: ["زمان‌سنج", "آمار"];
    in property <int> current: 0;
    in property <length> item-height: 28px;
    in property <length> font-size: 12px;
    callback selected(int);

    height: item-height + 8px;
    width: self.preferred-width;
    preferred-width: (options.length * 62px) + 8px;
    border-radius: (item-height + 8px) / 2;
    background: Palette.surface-2;

    // sliding indicator
    Rectangle {
        width: (parent.width - 8px) / root.options.length;
        height: root.item-height;
        x: 4px + root.current * self.width;
        y: 4px;
        border-radius: root.item-height / 2;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.border;
        animate x { duration: Motion.normal; easing: ease-out; }
    }

    HorizontalLayout {
        padding: 4px;
        spacing: 0px;

        for o[index] in root.options : Rectangle {
            width: (root.width - 8px) / root.options.length;
            height: root.item-height;
            background: transparent;
            border-radius: root.item-height / 2;

            ta2 := TouchArea {
                clicked => { root.selected(index); }
            }

            Text {
                text: o;
                font-size: root.font-size;
                font-weight: index == root.current ? 600 : 400;
                color: index == root.current ? Palette.text : Palette.text-dim;
                horizontal-alignment: center;
                width: parent.width;
                height: parent.height;
                animate color { duration: Motion.quick; }
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Toggle — pill switch with an animated knob.
// ───────────────────────────────────────────────────────────────────────────
component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Palette.accent : Palette.surface-3;

    animate background { duration: Motion.normal; easing: ease-out; }

    Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? parent.width - 21px : 3px;
        border-radius: 9px;
        background: root.checked ? Palette.on-accent : Palette.surface;
        animate x { duration: Motion.normal; easing: ease-out; }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Stepper — minus / value / plus, for durations.
// ───────────────────────────────────────────────────────────────────────────
component Stepper inherits Rectangle {
    in-out property <int> value: 25;
    in property <int> min: 1;
    in property <int> max: 180;
    in property <string> suffix: "د";
    callback changed(int);

    height: 30px;
    width: 124px;
    border-radius: 15px;
    background: Palette.surface-2;

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 0px;

        Rectangle {
            width: 26px;
            height: 26px;
            y: 2px;
            border-radius: 13px;
            background: transparent;
            ta3 := TouchArea {
                clicked => {
                    if (root.value > root.min) {
                        root.value = root.value - 1;
                        root.changed(root.value);
                    }
                }
            }
            states [
                hovered when ta3.has-hover : {
                    background: Palette.surface-3;
                    in { animate background { duration: Motion.instant; } }
                }
            ]
            Text {
                text: "−";
                font-size: 15px;
                color: root.value > root.min ? Palette.text : Palette.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        Text {
            text: Digits.num(root.value) + root.suffix;
            font-size: 12px;
            font-weight: 600;
            color: Palette.text;
            horizontal-alignment: center;
            // Slint defaults vertical-alignment to top. With a full-height
            // Text that pinned "25 دقیقه" to the top of the pill instead of
            // sitting it in the middle, which read as "the numbers drifted up".
            vertical-alignment: center;
            width: 66px;
            height: parent.height;
        }

        Rectangle {
            width: 26px;
            height: 26px;
            y: 2px;
            border-radius: 13px;
            background: transparent;
            ta2 := TouchArea {
                clicked => {
                    if (root.value < root.max) {
                        root.value = root.value + 1;
                        root.changed(root.value);
                    }
                }
            }
            states [
                hovered when ta2.has-hover : {
                    background: Palette.surface-3;
                    in { animate background { duration: Motion.instant; } }
                }
            ]
            Text {
                text: "+";
                font-size: 14px;
                color: root.value < root.max ? Palette.text : Palette.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// StatCard — label above, big value below. The FocusTimer stats idiom.
// ───────────────────────────────────────────────────────────────────────────
component StatCard inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hint: "";

    height: 78px;
    border-radius: 14px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.hairline;

    VerticalLayout {
        padding-left: 13px;
        padding-right: 15px;
        padding-top: 13px;
        padding-bottom: 15px;
        spacing: 3px;
        alignment: start;

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.1px;
            color: Palette.text-faint;
        }
        Text {
            text: root.value;
            font-size: 24px;
            font-weight: 400;
            color: Palette.text;
        }
        Text {
            text: root.hint;
            font-size: 10px;
            color: Palette.text-faint;
            visible: root.hint != "";
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// BarChart — seven days of focus minutes.
// ───────────────────────────────────────────────────────────────────────────
component BarChart {
    in property <[float]> values: [0, 0, 0, 0, 0, 0, 0];
    in property <[string]> labels: ["ش", "ی", "د", "س", "چ", "پ", "ج"];
    in property <int> highlight: 6;

    height: 132px;

    VerticalLayout {
        spacing: 8px;

        Rectangle {
            height: 96px;
            background: transparent;

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                for v[i] in root.values : Rectangle {
                    // reserve a hairline so an empty day still reads as a day
                    height: max(3px, (parent.height - 4px) * v);
                    horizontal-stretch: 1;
                    border-radius: 5px;
                    background: i == root.highlight ? Palette.accent : Palette.surface-3;
                    animate height { duration: Motion.slow; easing: ease-out; }
                    animate background { duration: Motion.normal; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            for l[i] in root.labels : Text {
                horizontal-stretch: 1;
                text: l;
                font-size: 10px;
                font-weight: i == root.highlight ? 700 : 400;
                color: i == root.highlight ? Palette.text-dim : Palette.text-faint;
                horizontal-alignment: center;
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// TaskRow — a single line with a check circle.
// ───────────────────────────────────────────────────────────────────────────
component TaskRow inherits Rectangle {
    in property <TaskItem> item;
    in property <bool> last: false;
    callback toggle(int);

    height: 42px;

    Rectangle {
        width: parent.width;
        height: 1px;
        y: parent.height - 1px;
        background: Palette.hairline;
        visible: !root.last;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 11px;
        alignment: start;

        // The checkbox. Completing a task is the one moment in the list that
        // deserves a flourish, so the ring scales up a touch and settles as
        // the check appears. It is a transform, not a size change, so nothing
        // around it reflows — the row stays exactly as tall as it was.
        Rectangle {
            width: 19px;
            height: 19px;
            border-radius: 9.5px;
            border-width: 1.5px;
            border-color: item.done ? Palette.accent : Palette.surface-3;
            background: item.done ? Palette.accent : transparent;
            y: (parent.height - self.height) / 2;
            transform-scale: item.done ? 1.0 : 0.92;
            animate transform-scale { duration: Motion.normal; easing: ease-out-back; }
            animate background { duration: Motion.normal; }
            animate border-color { duration: Motion.normal; }

            if item.done : Icon {
                kind: "check";
                size: 11px;
                color: Palette.on-accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            TouchArea { clicked => { root.toggle(item.id); } }
        }

        // Done tasks dim rather than vanish, and the dimming is animated so
        // ticking a box reads as the row settling back instead of blinking.
        //
        // `vertical-alignment: center` is not optional here: a Text given the
        // full row height lays its glyphs out from the top, which left every
        // title floating well above the checkbox it belongs to. Centering the
        // text box is what actually lines the two up.
        Text {
            text: item.title;
            font-size: 13px;
            color: item.done ? Palette.text-faint : Palette.text;
            overflow: elide;
            horizontal-stretch: 1;
            height: parent.height;
            vertical-alignment: center;
            animate color { duration: Motion.normal; }
        }

        Text {
            text: item.time;
            font-size: 11px;
            color: Palette.text-faint;
            visible: item.time != "";
            height: parent.height;
            vertical-alignment: center;
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// MonthGrid — the Jalali month as weeks of seven, Saturday first.
//
// This is what makes the task list a calendar rather than a list: a day with
// open work carries a dot, and clicking a square shows that day's tasks. The
// grid is a list of weeks of seven (Slint's GridLayout has no explicit column
// count), and the leading blanks come from Rust as cells with day == 0, so the
// 1st always lands under the right weekday.
// ───────────────────────────────────────────────────────────────────────────
component MonthGrid inherits Rectangle {
    in property <[DayRow]> rows: [];
    callback picked(string);

    height: rows.length * 34px;
    background: transparent;

    VerticalLayout {
        spacing: 2px;

        for r in root.rows : HorizontalLayout {
            height: 32px;
            spacing: 2px;

            for c in r.cells : Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 9px;
                // A day square is a button. The dot says "work here" visually;
                // the label says it in words, which is the only way a screen
                // reader can report it at all.
                accessible-role: button;
                accessible-label: c.day == 0
                    ? ""
                    : (c.label + (c.has-tasks ? ", " + c.open-count : ""));
                background: c.day == 0
                    ? transparent
                    : (c.selected ? Palette.accent : (c.is-today ? Palette.accent-soft : transparent));
                border-width: c.is-today && !c.selected ? 1px : 0px;
                border-color: Palette.accent;

                animate background { duration: Motion.quick; }

                if c.day != 0 : Text {
                    text: c.label;
                    font-family: "Vazirmatn";
                    font-size: 12px;
                    font-weight: c.is-today || c.selected ? 700 : 400;
                    color: c.selected ? Palette.on-accent : (c.is-today ? Palette.accent : Palette.text);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // The dot: this day has open work. A dot rather than a number,
                // so a full month still reads at a glance.
                if c.has-tasks : Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 7px;
                    background: c.selected ? Palette.on-accent : Palette.accent;
                }

                if c.day != 0 : TouchArea {
                    clicked => { root.picked(c.key); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// SectionLabel — small caps group heading.
// ───────────────────────────────────────────────────────────────────────────
component SectionLabel {
    in property <string> text: "";
    height: 18px;
    Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.3px;
        color: Palette.text-faint;
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Card — grouped container for settings rows.
// ───────────────────────────────────────────────────────────────────────────
component Card inherits Rectangle {
    in property <length> pad: 0px;
    border-radius: 14px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.hairline;
    @children
}

// ═══════════════════════════════════════════════════════════════════════════
// The window
// ═══════════════════════════════════════════════════════════════════════════
// ───────────────────────────────────────────────────────────────────────────
// EraPicker — four dynasty cards, each showing that era's emblem and colour.
// Selecting one repaints the entire app through the Palette global.
// ───────────────────────────────────────────────────────────────────────────
component EraCard inherits Rectangle {
    in property <string> era-id: "cyrus"; in property <string> name: "Cyrus"; in property <string> blurb: "Achaemenid gold on lapis"; in property <brush> swatch: #D6A84E; in property <bool> active: false; callback picked(); height: 88px; border-radius: 12px; background: active ? Palette.accent-soft : Palette.surface-2; border-width: active ? 1.5px : 1px; border-color: active ? Palette.accent : Palette.hairline; ta := TouchArea {
        clicked => { root.picked(); }
        mouse-cursor: pointer; }

    VerticalLayout {
        padding-left: 10px; padding-right: 10px; padding-top: 9px; padding-bottom: 9px; spacing: 4px; // emblem row
        Rectangle {
            height: 26px; background: transparent;
            if root.era-id == "cyrus" : Shahbaz {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }
            if root.era-id == "darius" : Faravahar {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }
            if root.era-id == "parthian" : Derafsh {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }
            if root.era-id == "sasanid" : Senmurv {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }

            // active check
            if root.active : Rectangle {
                width: 14px; height: 14px; border-radius: 7px; background: Palette.accent; x: parent.width - self.width; y: (parent.height - self.height) / 2; Icon {
                    kind: "check"; size: 9px; color: Palette.on-accent; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }

        Text {
            text: root.name; font-size: 11px; font-weight: 600; color: active ? Palette.accent : Palette.text; overflow: elide; }
        Text {
            text: root.blurb; font-size: 8px; color: Palette.text-faint; overflow: elide; }
    }
}

export component PanganWindow inherits Window {
    // ---- Live timer state (pushed from Rust each tick) ----
    in property <string> time-left; in property <int> time-minutes; in property <int> time-seconds; in property <string> session-name; in property <float> progress; in property <string> phase; in property <bool> running; in property <int> work-done; in property <string> session-counter; // ---- Theme ----
    in property <string> theme-label: "سامانه"; in property <string> resolved-theme: "dark"; in-out property <string> theme-pref: "system"; // Heritage era identity
in property <string> era: "cyrus"; in property <string> era-label: "کوروش"; in property <string> era-blurb: "زر آخامنشی بر لاجورد";

    // ---- Today (Persian calendar) ----
    in property <string> cal-date: "";        // "۱۲ آبان ۱۴۰۵"
    in property <string> cal-weekday: "";     // "چهارشنبه"
    in property <string> cal-day-name: "";    // "خور" — the Sasanian day-name
    in property <string> cal-day-index: "";   // "روز یازدهم ماه"
    in property <string> cal-feast: "";       // "مهرگان" or empty
    in property <string> cal-feast-note: "";  // one-line gloss under the name
    in property <string> cal-month-progress: ""; // "روز ۱۲ از ۳۰"
    in property <[CalEvent]> cal-events: [];
    in property <[CalEvent]> cal-world: [];
    in-out property <bool> cal-world-open: false;
    in-out property <string> refresh-status: "";
    in property <string> cal-empty: "برای این روز رویدادی ثبت نشده است."; // ---- Reports / status / sync / task input ----
    in property <string> status-line; in property <string> report-text; in property <string> sync-status;
    // ---- Google account sync ----
    in property <bool> sync-signed-in: false;
    in property <string> sync-account: "";
    in property <bool> sync-auto-on: false;
    in property <string> sync-device-code: "";
    in property <string> sync-device-url: "https://www.google.com/device";
    in property <bool> sync-waiting: false;
    in property <bool> sync-available: true; in-out property <string> new-task-text; in-out property <string> show-view: "main"; // ---- Settings (edited in the Settings screen) ----
    in-out property <int> work-minutes: 25; in-out property <int> short-break-minutes: 5; in-out property <int> long-break-minutes: 15; in-out property <int> long-break-interval: 4; in-out property <int> daily-goal-minutes: 120; in-out property <bool> auto-start-next: true; in-out property <bool> auto-start-on-launch: false; in-out property <bool> sound-enabled: true; in-out property <string> sound-theme: "santur"; in-out property <bool> hotkey-enabled: true; in-out property <bool> inhibit-enabled: true; in-out property <bool> overlay-enabled: true; in-out property <bool> compact-mode: false; in-out property <bool> animations: true; in-out property <int> sound-volume: 80; in property <string> automation-summary; // ---- Rich data (pushed from Rust) ----
    in property <[TaskItem]> tasks: []; in property <[DayRow]> month-rows: []; in property <[TaskItem]> day-tasks: []; in property <string> month-title: ""; in property <string> selected-day-title: ""; in property <string> selected-day-sub: ""; in property <bool> selected-is-today: false; in-out property <string> cal-selected: "";
    // Which task row is open for renaming (its id), or 0 for none. Only one row
    // can be edited at a time, so this is a single id rather than a set.
    in-out property <int> editing: 0;
    // The day navigator on the timer screen: the headline date, a subline with
    // the day-name and how much work sits on it, and whether it is today.
    in property <string> day-headline: "";
    in property <string> day-subline: "";
    in property <bool> day-is-today: true;
    in-out property <string> edit-text: "";
    in property <[float]> week-bars: [0, 0, 0, 0, 0, 0, 0]; in property <[string]> week-labels: ["ش", "ی", "د", "س", "چ", "پ", "ج"]; in property <int> today-sessions: 0; in property <int> today-minutes: 0; in property <int> today-score: 0; in property <int> today-streak: 0; in property <int> today-consistency: 0; in property <int> today-best: 0; in property <int> session-total: 4; in property <int> session-done: 0; in property <int> goal-minutes: 120; in property <int> goal-done-minutes: 0; // ---- Callbacks to Rust ----
    callback start-pause; callback skip; callback reset; callback open-report; callback close-report; callback open-today; callback close-today; callback open-settings; callback close-settings; callback cycle-theme; callback toggle-sound; callback preview-sound; callback sync-now; callback sync-connect; callback sync-disconnect; callback set-sync-auto(bool); callback add-task; callback backup-now; callback restore-now; callback add-automation(string, string); callback toggle-task(int); callback set-theme(string); callback set-era(string); callback set-lang(string); callback refresh-events; callback open-url(string); callback window-drag-start; callback set-compact-mode(bool); callback set-animations(bool); callback pick-day(string); callback shift-month(int); callback goto-today; callback add-task-on(string); callback delete-task(int); callback rename-task(int, string); callback move-task(int, int); callback step-day(int);
    // Resize: the edge/corner grab zones report the pointer's screen position
    // and which edge is being dragged; Rust turns that into a new window size.

    // Frameless drag: window position that keeps the pointer over the grab point.
    out property <length> drag-origin-x: self.absolute-position.x - root.drag-start-x;
    out property <length> drag-origin-y: self.absolute-position.y - root.drag-start-y;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;

    // Breathing phase for the ring's halo, 0..1. Advanced by a timer only
    // while a session is running and motion is enabled, so an idle window
    // costs nothing. A full breath is about 5.5s: slow enough to read as
    // breathing rather than blinking, which is the point of it.
    in-out property <float> pulse-phase: 0; timer := Timer {
        interval: 60ms; running: root.running && Motion.enabled; triggered => {
            root.pulse-phase = Math.mod(root.pulse-phase + 0.011, 1.0); }
    }

    // ── view transition ──────────────────────────────────────────────────
    // Navigating between screens fades the incoming view up and lifts it a
    // few pixels, so a switch reads as a change of place rather than a hard
    // cut. `view-enter` runs 0 → 1 over ~260ms; every screen binds its own
    // opacity and offset to it, which keeps the whole thing to one animated
    // property instead of one per screen.
    in-out property <float> view-enter: 1;
    // With motion off the transition never runs, so the screens must not be
    // left transparent: both derived properties fall back to the settled
    // state when `Motion.enabled` is false.
    private property <float> view-opacity: Motion.enabled ? root.view-enter : 1.0;
    private property <length> view-offset: Motion.enter-rise * (1 - root.view-enter);
    changed show-view => {
        root.view-enter = 0;
    }
    enter-timer := Timer {
        interval: 16ms;
        running: root.view-enter < 1 && Motion.enabled;
        triggered => {
            root.view-enter = Math.min(1, root.view-enter + 0.062);
        }
    }

    title: "Pangan";
    // A real window frame, not a frameless one.
    //
    // The app used to be `no-frame: true` and drew its own chrome, which meant
    // the window manager gave it no resize border at all — that is why the
    // window could not be resized. Hand-rolled edge grab zones were fragile
    // (the release event is lost as soon as the window shrinks out from under
    // the pointer). Letting the platform own the frame gives real, reliable
    // resizing on every desktop, the way a normal app behaves.
    no-frame: false;
    // No width/height binding here on purpose.
    //
    // A binding like `width: 420px` makes Slint re-apply that size on every
    // resize, so the window manager's resize is immediately undone — which is
    // exactly why the window could not be resized. The initial size is set
    // once from Rust instead, leaving the WM free to resize afterwards.
    min-width: 340px; min-height: 400px; background: Palette.bg; 
    // Vazirmatn is the Persian face the whole app is set in; Inter carries
    // the Latin side. Both are named so the platform picks the right one per
    // script instead of falling back to a system default that mangles Persian.
    default-font-family: Strings.fa ? "Vazirmatn" : "Inter";

    // ─────────────────────────────────────────────────────────────────────
    // Heritage texture
    //
    // This used to be a 6×9 tiling of the era emblem across the whole window,
    // including behind the header. At that density it stopped reading as paper
    // grain and started competing with the wordmark and the controls, which is
    // exactly what made the top of the window feel cluttered.
    //
    // It is now a single large watermark, centred in the body and kept well
    // below the header, so the emblem is present as a quiet ground without
    // ever sitting behind text. One mark at low opacity reads as intent; a
    // grid of them reads as noise.
    // ─────────────────────────────────────────────────────────────────────
    Rectangle {
        y: 56px;
        width: root.width;
        height: root.height - 56px;
        background: transparent;
        clip: true;

        // The watermark is deliberately oversized and offset so its edges fall
        // outside the body and it reads as a cropped detail rather than a
        // centred logo. Pushed well down the body so it never crowds the
        // header above it.
        Rectangle {
            width: root.width * 1.15;
            height: root.width * 1.15;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 64px;
            background: transparent;

            if root.era == "cyrus" : Shahbaz {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
            if root.era == "darius" : Faravahar {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
            if root.era == "parthian" : Derafsh {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
            if root.era == "sasanid" : Senmurv {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
        }
    }
  // ─────────────────────────────────────────────────────────────────────
    // Header — draggable, minimal. Title left, controls right.
    // ─────────────────────────────────────────────────────────────────────
    Rectangle {
        height: 56px; y: 0px; background: transparent; // drag handle covering the header, behind the buttons
        TouchArea {
            width: parent.width - 130px;
            height: parent.height;
            mouse-cursor: move;

            moved => {
                if (self.pressed) {
                    if (root.drag-start-x == 0px && root.drag-start-y == 0px) {
                        root.drag-start-x = self.mouse-x;
                        root.drag-start-y = self.mouse-y;
                    }
                    root.window-drag-start();
                }
            }

            // remember where inside the header the drag began
            init => {
                root.drag-start-x = 0px;
                root.drag-start-y = 0px;
            }
        }

        HorizontalLayout {
            padding-left: 18px; padding-right: 12px; spacing: 8px; alignment: space-between; // wordmark
            HorizontalLayout {
                spacing: 9px;
                alignment: start;

                // The mark: the active era's authentic emblem.
                Rectangle {
                    width: 30px; height: 30px; y: (parent.height - self.height) / 2; background: transparent; if root.era == "cyrus" : Shahbaz { width: 30px; height: 30px; color: Palette.accent; }
                    if root.era == "darius" : Faravahar { width: 30px; height: 30px; color: Palette.accent; }
                    if root.era == "parthian" : Derafsh { width: 30px; height: 30px; color: Palette.accent; }
                    if root.era == "sasanid" : Senmurv { width: 30px; height: 30px; color: Palette.accent; }
                }

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;
                    vertical-stretch: 0;
                    Text {
                        text: Strings.app-name;
                        font-size: 13px;
                        font-weight: 600;
                        letter-spacing: 0.3px;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Strings.app-tagline;
                        font-family: "Vazirmatn";
                        font-size: 10px;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px; alignment: end; IconButton {
                    icon: root.resolved-theme == "light" ? "moon" : "sun"; icon-size: 16px; clicked => { root.cycle-theme(); }
                }
                IconButton {
                    icon: "sliders"; icon-size: 16px; clicked => { root.open-settings(); }
                }
            }
        }

        // No ornament along the header edge.
        //
        // There used to be a decorative band here (first a stepped sawtooth,
        // then the Apadana lotus frieze). Both were wrong: the header already
        // carries the era emblem, the wordmark, the tagline and two controls,
        // and a patterned edge on top of that made the top of the window read
        // as clutter. The header is now just the mark and the controls, with
        // a single hairline to separate it from the body.
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Palette.hairline;
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Body
    // ─────────────────────────────────────────────────────────────────────
    Rectangle {
        y: 56px; width: parent.width; height: parent.height - 56px; background: transparent; // ═══ COMPACT ═══
        if root.show-view == "main" && root.compact-mode : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 16px; spacing: 10px; HorizontalLayout {
                spacing: 8px; alignment: space-between; Text {
                    text: root.session-name; font-size: 11px; font-weight: 700; color: Palette.text-faint; vertical-alignment: center; }
                Text {
                    text: root.session-counter; font-size: 10px; color: Palette.text-faint; vertical-alignment: center; }
            }

            Text {
                text: Digits.pad2(root.time-minutes) + ":" + Digits.pad2(root.time-seconds); font-size: 54px; font-weight: 300; letter-spacing: 1px; color: Palette.text; horizontal-alignment: center; }

            Rectangle {
                height: 4px; border-radius: 2px; background: Palette.track; Rectangle {
                    width: parent.width * root.progress; height: parent.height; border-radius: 2px; background: Palette.accent; animate width { duration: Motion.slow; easing: ease-out; }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                TimerButton {
                    icon: "reset";
                    size: 38px;
                    icon-size: 16px;
                    clicked => { root.reset(); }
                }

                TimerButton {
                    icon: root.running ? "pause" : "play";
                    size: 52px;
                    icon-size: 20px;
                    primary: true;
                    clicked => { root.start-pause(); }
                }

                TimerButton {
                    icon: "skip";
                    size: 38px;
                    icon-size: 16px;
                    clicked => { root.skip(); }
                }
            }
        }

        // ═══ MAIN ═══
        // The whole column scrolls when the window is short, so nothing can be
        // cut off at the bottom. The hero shrinks with the window instead of
        // holding a fixed 268px, which is what used to squeeze the task list
        // down to four pixels.
        if root.show-view == "main" && !root.compact-mode : Flickable {
            opacity: root.view-opacity;
            y: root.view-offset;
            vertical-stretch: 1;
            content-height: main-col.preferred-height;
            interactive: main-col.preferred-height > self.height;

            // No explicit height here: the Flickable measures the column's
            // preferred height itself. Setting `height: self.preferred-height`
            // on the child of a Flickable is a binding loop and collapsed the
            // whole column to a sliver.
            main-col := VerticalLayout {
            width: parent.width; padding-bottom: 14px; spacing: 0px; // view switcher
            HorizontalLayout {
                height: 40px; alignment: center; Segmented {
                    options: [Strings.nav-timer, Strings.nav-today, Strings.nav-stats]; current: 0; selected(i) => {
                        if (i == 1) { root.open-today(); }
                        if (i == 2) { root.open-report(); }
                    }
                }
            }

            // ---- hero: ring + time ----
            // Grows and shrinks with the window, within sane bounds.
            Rectangle {
                height: Math.max(150px, Math.min(268px, root.height - 430px));
                background: transparent;
                hero-ring := SunRing {
                    progress: root.progress;
                    d: Math.max(120px, Math.min(236px, parent.height - 32px));
                    t: 7px;
                    glow: root.running;
                    pulse: root.pulse-phase;
                    halo-alpha: Palette.dark ? 0.10 : 0.16;
                    track-color: Palette.track; fill-color: Palette.accent;
                    x: (parent.width - self.width) / 2; y: 6px; }

                VerticalLayout {
                    width: hero-ring.width * 0.85;
                    height: hero-ring.height * 0.85;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    spacing: 2px; alignment: center; Text {
                        text: root.session-name; font-size: 11px; font-weight: 700; color: Palette.accent; horizontal-alignment: center; }
                    Text {
                        text: Digits.pad2(root.time-minutes) + ":" + Digits.pad2(root.time-seconds); font-size: Math.max(34px, Math.min(62px, hero-ring.width * 0.26)); font-weight: 300; letter-spacing: 0.5px; color: Palette.text; horizontal-alignment: center; }
                    Text {
                        text: root.phase; font-size: 11px; color: Palette.text-dim; horizontal-alignment: center; }
                    // The day's goal, inside the ring rather than in a card of
                    // its own. It belongs to the timer — it is the same number
                    // the ring is filling towards — and a separate bar below
                    // was one more block competing with the clock.
                    Rectangle { height: 6px; }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: Math.min(hero-ring.width * 0.52, 120px);
                            height: 3px;
                            border-radius: 1.5px;
                            background: Palette.track;
                            Rectangle {
                                width: parent.width * clamp(root.goal-done-minutes / max(root.goal-minutes, 1), 0, 1);
                                height: parent.height;
                                border-radius: 1.5px;
                                background: Palette.accent;
                                animate width { duration: Motion.lazy; easing: ease-out; }
                            }
                        }
                    }
                    Text {
                        text: Digits.num(root.goal-done-minutes) + " / " + Digits.num(root.goal-minutes) + " " + Strings.minutes-short; font-size: 9px; color: Palette.text-faint; horizontal-alignment: center; }
                }
            }

            // ---- session dots ----
            HorizontalLayout {
                height: 22px; spacing: 6px; alignment: center; for i in max(root.session-total, 1) : Rectangle {
                    width: i < root.session-done ? 18px : 6px; height: 6px; border-radius: 3px; background: i < root.session-done ? Palette.accent : Palette.surface-3; animate width { duration: Motion.normal; easing: ease-out; }
                    animate background { duration: Motion.normal; }
                }
            }

            Rectangle { height: 10px; }

            // ---- controls ----
            HorizontalLayout {
                height: 64px;
                spacing: 16px;
                alignment: center;

                TimerButton {
                    icon: "reset";
                    size: 44px;
                    icon-size: 18px;
                    clicked => { root.reset(); }
                }

                TimerButton {
                    icon: root.running ? "pause" : "play";
                    size: 64px;
                    icon-size: 24px;
                    primary: true;
                    clicked => { root.start-pause(); }
                }

                TimerButton {
                    icon: "skip";
                    size: 44px;
                    icon-size: 18px;
                    clicked => { root.skip(); }
                }
            }

            Rectangle { height: 16px; }

            // ---- the day navigator ----
            // One block that says which day you are on and lets you walk to any
            // other. The date reads as a full date with the era year and a
            // "(today)" marker, the chevrons step a day at a time, and tapping
            // the date opens the month grid.
            Rectangle {
                height: 60px;
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: 16px;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;

                // The chevrons sit at the card's edges and the date block is
                // centred in what is left. Before, the date block stretched to
                // fill the gap, so its text was centred in the *gap* rather
                // than in the card, and the whole group drifted left whenever
                // the date string was short.
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 0px; alignment: center; DayStep {
                        clicked => { root.step-day(-1); }
                    }

                    Rectangle {
                        horizontal-stretch: 1; background: transparent; ta-day := TouchArea { clicked => { root.open-today(); } }

                        VerticalLayout {
                            alignment: center; spacing: 2px; Text {
                                text: root.day-headline; font-family: "Vazirmatn"; font-size: 16px; font-weight: 700; color: Palette.text; horizontal-alignment: center; overflow: elide; }

                            Text {
                                text: root.day-subline; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text-dim; horizontal-alignment: center; overflow: elide; }
                        }
                    }

                    DayStep {
                        forward: true; clicked => { root.step-day(1); }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ---- tasks ----
            // A fixed, comfortable height: the list scrolls inside the card, so
            // the card never collapses when the window is short.
            Rectangle {
                height: 200px;
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: 14px;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;

                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 14px;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 20px;
                        Text {
                            text: Strings.tasks;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 1.1px;
                            color: Palette.text-faint;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: Digits.num(root.tasks.length);
                            font-size: 10px;
                            color: Palette.text-faint;
                        }
                    }

                    if root.tasks.length == 0 : Rectangle {
                        height: 46px;
                        Text {
                            text: Strings.tasks-empty;
                            font-size: 12px;
                            color: Palette.text-faint;
                            x: 2px;
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.tasks.length * 42px;
                        interactive: root.tasks.length * 42px > self.height;

                        for t[i] in root.tasks : TaskRow {
                            y: i * 42px;
                            item: t;
                            last: i == root.tasks.length - 1;
                            toggle(id) => { root.toggle-task(id); }
                        }
                    }

                    // quick add
                    Rectangle {
                        height: 38px;
                        border-radius: 10px;
                        background: Palette.surface-2;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 6px;

                            // Two-way binding: a one-way `text:` binding is
                            // broken by the first keystroke, so clearing
                            // new-task-text from Rust never reached the field
                            // and the typed text stayed on screen after adding.
                            LineEdit {
                                text <=> root.new-task-text;
                                placeholder-text: Strings.task-placeholder;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                accepted(t) => {
                                    root.new-task-text = t;
                                    root.add-task();
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.new-task-text != "" ? Palette.accent : Palette.surface-3;
                                y: (parent.height - self.height) / 2;
                                ta6 := TouchArea { clicked => { root.add-task(); } }
                                states [
                                    h when ta6.has-hover && root.new-task-text != "" : {
                                        background: Palette.text;
                                        in { animate background { duration: Motion.quick; } }
                                    }
                                ]
                                Icon {
                                    kind: "plus";
                                    size: 14px;
                                    color: root.new-task-text != "" ? Palette.on-accent : Palette.text-faint;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ---- footer: sync ----
            HorizontalLayout {
                height: 18px;
                padding-left: 24px;
                padding-right: 24px;
                alignment: space-between;
                Text {
                    text: root.sync-status;
                    font-size: 10px;
                    color: Palette.text-faint;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: Strings.sync;
                    font-size: 10px;
                    color: Palette.text-dim;
                    ta7 := TouchArea {
                        clicked => { root.sync-now(); }
                        mouse-cursor: pointer;
                    }
                    states [
                        h when ta7.has-hover : {
                            color: Palette.accent;
                            in { animate color { duration: Motion.quick; } }
                        }
                    ]
                }
            }
            }
        }

        // ═══ STATS ═══
        // ═══ TODAY — Persian calendar ═══
        if root.show-view == "today" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px; spacing: 0px; // ---- title bar ----
            HorizontalLayout {
                height: 44px; padding-left: 14px; padding-right: 14px; spacing: 8px; IconButton {
                    icon: "back"; size: 30px; icon-size: 15px; clicked => { root.close-today(); }
                }
                Text {
                    text: Strings.today; font-family: "Vazirmatn"; font-size: 15px; font-weight: 600; color: Palette.text; horizontal-stretch: 1; }
                if root.refresh-status != "" : Text {
                    text: root.refresh-status; font-size: 9px; color: Palette.text-faint; vertical-alignment: center; }
                Rectangle {
                    width: 30px; height: 30px; border-radius: 15px; background: Palette.surface-2;
                    ta-ref := TouchArea { clicked => { root.refresh-events(); } }
                    states [
                        h when ta-ref.has-hover : { background: Palette.surface-3; in { animate background { duration: Motion.quick; } } }
                    ]
                    Icon { kind: "reset"; size: 14px; color: Palette.text-dim; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
            }

            Flickable {
                vertical-stretch: 1; content-height: today-content.preferred-height; interactive: true; today-content := VerticalLayout {
                    width: parent.width; height: self.preferred-height; padding-left: 18px; padding-right: 18px; padding-bottom: 20px; spacing: 10px;

                    // ---- the month calendar ----
                    // The point of the whole screen: pick a day, see that day's
                    // work, and add to a future day without leaving it.
                    Rectangle {
                        height: month-card.preferred-height + 24px;
                        border-radius: 14px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;

                        month-card := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            height: self.preferred-height;
                            spacing: 6px;

                            // month header: back, title, forward, today
                            HorizontalLayout {
                                height: 30px;
                                spacing: 4px;

                                IconButton {
                                    icon: "back";
                                    size: 26px;
                                    icon-size: 13px;
                                    clicked => { root.shift-month(-1); }
                                }
                                Text {
                                    text: root.month-title;
                                    font-family: "Vazirmatn";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    icon: "skip";
                                    size: 26px;
                                    icon-size: 13px;
                                    clicked => { root.shift-month(1); }
                                }
                                // Back to today, only when you have wandered off.
                                if !root.selected-is-today : Rectangle {
                                    width: 44px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: Palette.accent-soft;
                                    y: (parent.height - self.height) / 2;
                                    ta-today := TouchArea { clicked => { root.goto-today(); } }
                                    states [
                                        h when ta-today.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.today;
                                        font-family: "Vazirmatn";
                                        font-size: 9px;
                                        color: Palette.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // weekday initials, Saturday first
                            HorizontalLayout {
                                height: 16px;
                                for w in ["ش", "ی", "د", "س", "چ", "پ", "ج"] : Text {
                                    text: w;
                                    font-family: "Vazirmatn";
                                    font-size: 9px;
                                    color: Palette.text-faint;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            MonthGrid {
                                rows: root.month-rows;
                                picked(k) => { root.pick-day(k); }
                            }
                        }
                    }

                    // ---- the selected day's tasks ----
                    HorizontalLayout {
                        height: 22px;
                        padding-left: 2px;
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: root.selected-day-title;
                            font-family: "Vazirmatn";
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.selected-day-sub;
                            font-family: "Vazirmatn";
                            font-size: 10px;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: Digits.num(root.day-tasks.length);
                            font-size: 10px;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                    }

                    if root.day-tasks.length == 0 : Rectangle {
                        height: 48px;
                        border-radius: 12px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        Text {
                            text: Strings.tasks-none-day;
                            font-family: "Vazirmatn";
                            font-size: 11px;
                            color: Palette.text-faint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for t in root.day-tasks : Rectangle {
                        height: editing == t.id ? 76px : 42px;
                        border-radius: 12px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: editing == t.id ? Palette.accent : Palette.hairline;

                        animate height { duration: Motion.normal; }

                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 40px;
                                spacing: 10px;

                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    border-width: 1.5px;
                                    border-color: t.done ? Palette.accent : Palette.surface-3;
                                    background: t.done ? Palette.accent : transparent;
                                    y: (parent.height - self.height) / 2;
                                    transform-scale: t.done ? 1.0 : 0.92;
                                    animate transform-scale { duration: Motion.normal; easing: ease-out-back; }
                                    animate background { duration: Motion.normal; }

                                    if t.done : Icon {
                                        kind: "check";
                                        size: 10px;
                                        color: Palette.on-accent;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    TouchArea { clicked => { root.toggle-task(t.id); } }
                                }

                                Text {
                                    text: t.title;
                                    font-family: "Vazirmatn";
                                    font-size: 12px;
                                    color: t.done ? Palette.text-faint : Palette.text;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    animate color { duration: Motion.normal; }
                                }

                                if t.time != "" : Text {
                                    text: t.time;
                                    font-size: 10px;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }

                                // ── per-task controls ──
                                // Nudge the task a day either way, rename it, or
                                // delete it. These are what make the calendar a
                                // place to manage work rather than just look at it.
                                TaskAction {
                                    icon: "back";
                                    tip: Strings.move-earlier;
                                    clicked => { root.move-task(t.id, -1); }
                                }
                                TaskAction {
                                    icon: "skip";
                                    tip: Strings.move-later;
                                    clicked => { root.move-task(t.id, 1); }
                                }
                                TaskAction {
                                    icon: "edit";
                                    tip: Strings.rename;
                                    clicked => { editing = editing == t.id ? 0 : t.id; }
                                }
                                TaskAction {
                                    icon: "trash";
                                    tip: Strings.delete;
                                    destructive: true;
                                    clicked => { root.delete-task(t.id); }
                                }
                            }

                            // The rename field, only for the row being edited.
                            if editing == t.id : Rectangle {
                                height: 32px;
                                border-radius: 9px;
                                background: Palette.surface-2;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 4px;
                                    spacing: 4px;

                                    LineEdit {
                                        text <=> root.edit-text;
                                        font-size: 12px;
                                        horizontal-stretch: 1;
                                        accepted(v) => {
                                            root.rename-task(t.id, v);
                                            editing = 0;
                                        }
                                    }

                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: Palette.accent;
                                        y: (parent.height - self.height) / 2;
                                        ta-save := TouchArea {
                                            clicked => {
                                                root.rename-task(t.id, root.edit-text);
                                                editing = 0;
                                            }
                                        }
                                        Icon {
                                            kind: "check";
                                            size: 12px;
                                            color: Palette.on-accent;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- add to the selected day ----
                    Rectangle {
                        height: 38px;
                        border-radius: 10px;
                        background: Palette.surface-2;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 6px;

                            LineEdit {
                                text <=> root.new-task-text;
                                placeholder-text: root.selected-is-today
                                    ? Strings.task-placeholder
                                    : Strings.task-placeholder-day;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                accepted(t) => {
                                    root.new-task-text = t;
                                    root.add-task-on(root.cal-selected);
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.new-task-text != "" ? Palette.accent : Palette.surface-3;
                                y: (parent.height - self.height) / 2;
                                ta-add := TouchArea { clicked => { root.add-task-on(root.cal-selected); } }
                                states [
                                    h when ta-add.has-hover && root.new-task-text != "" : {
                                        background: Palette.text;
                                        in { animate background { duration: Motion.quick; } }
                                    }
                                ]
                                Icon {
                                    kind: "plus";
                                    size: 14px;
                                    color: root.new-task-text != "" ? Palette.on-accent : Palette.text-faint;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 146px; border-radius: 14px; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; // era emblem, faint, on the right
                        Rectangle {
                            width: 84px; height: 84px; x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; background: transparent; if root.era == "cyrus" : Shahbaz { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                            if root.era == "darius" : Faravahar { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                            if root.era == "parthian" : Derafsh { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                            if root.era == "sasanid" : Senmurv { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                        }

                        VerticalLayout {
                            padding-left: 16px; padding-top: 14px; padding-bottom: 14px; spacing: 4px; Text {
                                text: root.cal-weekday; font-family: "Vazirmatn"; font-size: 11px; color: Palette.accent; font-weight: 600; }
                            Text {
                                text: root.cal-date; font-family: "Vazirmatn"; font-size: 24px; font-weight: 600; color: Palette.text; }
                            Text {
                                text: root.cal-month-progress; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text-dim; }
                            Text {
                                text: Strings.heritage-title + " · " + Strings.heritage-sub;
                                font-family: "Vazirmatn"; font-size: 9px; color: Palette.accent; }
                        }
                    }

                    // ---- the Sasanian day-name ----
                    Rectangle {
                        height: 74px; border-radius: 14px; background: Palette.accent-soft; border-width: 1px; border-color: Palette.accent; VerticalLayout {
                            padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 12px; spacing: 2px; Text {
                                text: Strings.day-name-label; font-family: "Vazirmatn"; font-size: 11px; font-weight: 700; color: Palette.text-faint; }
                            HorizontalLayout {
                                spacing: 8px; Text {
                                    text: root.cal-day-name; font-family: "Vazirmatn"; font-size: 20px; font-weight: 600; color: Palette.accent; vertical-alignment: center; }
                                Text {
                                    text: root.cal-day-index; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text-dim; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                    }

                    // ---- feast badge, only when today is one ----
                    if root.cal-feast != "" : Rectangle {
                        height: root.cal-feast-note != "" ? 62px : 46px;
                        border-radius: 12px; background: Palette.surface-2; border-width: 1px; border-color: Palette.hairline; HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 8px; alignment: start; Boteh {
                                size: 20px; y: (parent.height - self.height) / 2; color: Palette.accent; fade: 0.9; }
                            VerticalLayout {
                                vertical-stretch: 0;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: Strings.feast-prefix + root.cal-feast; font-family: "Vazirmatn"; font-size: 13px; font-weight: 600; color: Palette.text; vertical-alignment: center; }
                                if root.cal-feast-note != "" : Text {
                                    text: root.cal-feast-note; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text-dim; overflow: elide; }
                            }
                        }
                    }

                    // ---- events ----
                    HorizontalLayout {
                        height: 20px; padding-left: 2px; spacing: 6px; alignment: start; Text {
                            text: Strings.iran-events; font-family: "Vazirmatn"; font-size: 11px; font-weight: 700; color: Palette.text-faint; vertical-alignment: center; }
                        Text {
                            text: root.cal-events.length > 0 ? "(" + root.cal-events.length + ")" : ""; font-size: 10px; color: Palette.text-faint; vertical-alignment: center; }
                    }

                    if root.cal-events.length == 0 : Rectangle {
                        height: 56px; border-radius: 12px; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; Text {
                            text: root.cal-empty; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text-faint; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                    }

                    for ev in root.cal-events : Rectangle {
                        height: ev-row.preferred-height + 22px; border-radius: 12px; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; ev-row := VerticalLayout {
                            x: 14px; y: 11px; width: parent.width - 28px; height: self.preferred-height; spacing: 4px; HorizontalLayout {
                                spacing: 6px; height: 14px; if ev.year != "" : Text {
                                    text: ev.year; font-family: "Vazirmatn"; font-size: 10px; font-weight: 700; color: Palette.accent; vertical-alignment: center; }
                                if ev.section != "" : Text {
                                    text: ev.section; font-family: "Vazirmatn"; font-size: 9px; color: Palette.text-faint; vertical-alignment: center; }
                            }

                            Text {
                                text: ev.text; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text; wrap: word-wrap; line-height-factor: 1.55; }
                        }
                    }

                    // ---- world history, folded away by default ----
                    if root.cal-world.length > 0 : Rectangle {
                        height: 40px; border-radius: 12px; background: Palette.surface; border-width: 1px; border-color: Palette.hairline;
                        ta-world := TouchArea { clicked => { root.cal-world-open = !root.cal-world-open; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 8px;
                            Text {
                                text: Strings.world-events; font-family: "Vazirmatn"; font-size: 11px; font-weight: 600; color: Palette.text-dim; vertical-alignment: center; horizontal-stretch: 1;
                            }
                            Text {
                                text: "(" + root.cal-world.length + ")"; font-size: 10px; color: Palette.text-faint; vertical-alignment: center;
                            }
                            Text {
                                text: root.cal-world-open ? Strings.show-less : Strings.show-more; font-size: 10px; color: Palette.accent; vertical-alignment: center;
                            }
                        }
                    }

                    if root.cal-world-open : VerticalLayout {
                        spacing: 10px;
                        for ev in root.cal-world : Rectangle {
                            height: wv-row.preferred-height + 22px; border-radius: 12px; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; wv-row := VerticalLayout {
                                x: 14px; y: 11px; width: parent.width - 28px; height: self.preferred-height; spacing: 4px; HorizontalLayout {
                                    spacing: 6px; height: 14px; if ev.year != "" : Text {
                                        text: ev.year; font-family: "Vazirmatn"; font-size: 10px; font-weight: 700; color: Palette.text-dim; vertical-alignment: center; }
                                }

                                Text {
                                    text: ev.text; font-family: "Vazirmatn"; font-size: 11px; color: Palette.text-dim; wrap: word-wrap; line-height-factor: 1.55; }
                            }
                        }
                    }
                }
            }
        }

        if root.show-view == "report" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px;
            spacing: 0px;

            // header row
            HorizontalLayout {
                height: 44px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: start;

                IconButton {
                    icon: "back";
                    size: 30px;
                    icon-size: 15px;
                    clicked => { root.close-report(); }
                }
                Text {
                    text: Strings.nav-stats;
                    font-size: 15px;
                    font-weight: 600;
                    color: Palette.text;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: "close";
                    size: 30px;
                    icon-size: 14px;
                    clicked => { root.close-report(); }
                }
            }

            Flickable {
                vertical-stretch: 1;
                content-height: 700px;
                interactive: true;

                VerticalLayout {
                    width: parent.width;
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-bottom: 18px;
                    spacing: 12px;

                    // headline
                    Rectangle {
                        height: 92px;
                        border-radius: 16px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: Strings.score-title;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.2px;
                                color: Palette.text-faint;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: Digits.num(root.today-score);
                                font-size: 38px;
                                font-weight: 300;
                                color: Palette.accent;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // week chart
                    Rectangle {
                        height: 190px;
                        border-radius: 16px;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            Text {
                                text: Strings.this-week;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.2px;
                                color: Palette.text-faint;
                            }
                            BarChart {
                                values: root.week-bars;
                                labels: root.week-labels;
                                highlight: 6;
                                vertical-stretch: 1;
                            }
                        }
                    }

                    // stat grid
                    HorizontalLayout {
                        spacing: 10px;
                        StatCard {
                            label: Strings.sessions;
                            value: Digits.num(root.today-sessions);
                            horizontal-stretch: 1;
                        }
                        StatCard {
                            label: Strings.focus;
                            value: Digits.num(root.today-minutes) + " " + Strings.minutes-short;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        StatCard {
                            label: Strings.streak;
                            value: Digits.num(root.today-streak) + (Strings.fa ? " روز" : "d");
                            horizontal-stretch: 1;
                        }
                        StatCard {
                            label: Strings.consistency;
                            value: Digits.pct(root.today-consistency / 100.0);
                            horizontal-stretch: 1;
                        }
                    }

                    // raw narrative, kept for parity with the report engine
                    Rectangle {
                        height: 1px;
                        background: Palette.hairline;
                    }
                    Text {
                        text: root.report-text;
                        font-size: 11px;
                        color: Palette.text-faint;
                        wrap: word-wrap;
                        line-height-factor: 1.5;
                    }
                }
            }
        }

        // ═══ SETTINGS ═══
        if root.show-view == "settings" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px;
            spacing: 0px;

            HorizontalLayout {
                height: 44px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                IconButton {
                    icon: "back";
                    size: 30px;
                    icon-size: 15px;
                    clicked => { root.close-settings(); }
                }
                Text {
                    text: Strings.settings;
                    font-size: 15px;
                    font-weight: 600;
                    color: Palette.text;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 62px;
                    height: 30px;
                    border-radius: 15px;
                    background: Palette.accent;
                    ta8 := TouchArea { clicked => { root.close-settings(); } }
                    states [
                        h when ta8.has-hover : {
                            background: Palette.text;
                            in { animate background { duration: Motion.quick; } }
                        }
                    ]
                    Text {
                        text: Strings.done;
                        font-size: 12px;
                        font-weight: 600;
                        color: Palette.on-accent;
                        horizontal-alignment: center;
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                // Bind to the real content height so nothing is ever clipped when
                // a section is added. (This used to be a hardcoded 1180px, which
                // silently hid the bottom sections.)
                content-height: settings-content.preferred-height;
                interactive: true;

                settings-content := VerticalLayout {
                    width: parent.width;
                    height: self.preferred-height;
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-bottom: 20px;
                    spacing: 8px;

                    // ── timer ──
                    SectionLabel { text: Strings.sec-timer; }
                    Card {
                        height: 174px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-work; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Stepper { value <=> root.work-minutes; min: 1; max: 180; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.work-minutes = v; } }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-short; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Stepper { value <=> root.short-break-minutes; min: 1; max: 60; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.short-break-minutes = v; } }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-long; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Stepper { value <=> root.long-break-minutes; min: 1; max: 90; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.long-break-minutes = v; } }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-long-every; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Stepper { value <=> root.long-break-interval; min: 1; max: 12; suffix: ""; changed(v) => { root.long-break-interval = v; } }
                            }
                        }
                    }

                    // ── goal ──
                    SectionLabel { text: Strings.sec-goal; }
                    Card {
                        height: 58px;
                        VerticalLayout {
                            padding: 14px;
                            HorizontalLayout {
                                alignment: center;
                                Text { text: Strings.lbl-goal; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Stepper { value <=> root.daily-goal-minutes; min: 15; max: 600; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.daily-goal-minutes = v; } }
                            }
                        }
                    }

                    // ── behaviour ──
                    SectionLabel { text: Strings.sec-behaviour; }
                    Card {
                        height: 118px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-autostart-next; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle { checked <=> root.auto-start-next; y: (parent.height - self.height) / 2; }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-autostart-launch; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle { checked <=> root.auto-start-on-launch; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    // ── appearance ──
                    SectionLabel { text: Strings.sec-heritage; }
                    Card {
                        height: 268px;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 9px;

                            HorizontalLayout {
                                height: 14px;
                                Text {
                                    text: root.era-label;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.6px;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: Strings.lbl-eras;
                                    font-size: 10px;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 7px;
                                EraCard {
                                    era-id: "cyrus";
                                    name: Strings.era-cyrus;
                                    blurb: Strings.era-cyrus-blurb;
                                    swatch: #D6A84E;
                                    active: root.era == "cyrus";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("cyrus"); }
                                }
                                EraCard {
                                    era-id: "darius";
                                    name: Strings.era-darius;
                                    blurb: Strings.era-darius-blurb;
                                    swatch: #C87941;
                                    active: root.era == "darius";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("darius"); }
                                }
                                EraCard {
                                    era-id: "parthian";
                                    name: Strings.era-parthian;
                                    blurb: Strings.era-parthian-blurb;
                                    swatch: #5B8FD6;
                                    active: root.era == "parthian";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("parthian"); }
                                }
                                EraCard {
                                    era-id: "sasanid";
                                    name: Strings.era-sasanid;
                                    blurb: Strings.era-sasanid-blurb;
                                    swatch: #4FA89B;
                                    active: root.era == "sasanid";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("sasanid"); }
                                }
                            }

                            // The selected dynasty's span and its place in history.
                            HorizontalLayout {
                                height: 14px;
                                spacing: 6px;
                                Text {
                                    text: root.era == "darius" ? Strings.era-darius-span
                                        : root.era == "parthian" ? Strings.era-parthian-span
                                        : root.era == "sasanid" ? Strings.era-sasanid-span
                                        : Strings.era-cyrus-span;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.era-blurb;
                                    font-size: 10px;
                                    color: Palette.text-dim;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: root.era == "darius" ? Strings.era-darius-note
                                    : root.era == "parthian" ? Strings.era-parthian-note
                                    : root.era == "sasanid" ? Strings.era-sasanid-note
                                    : Strings.era-cyrus-note;
                                font-size: 9px;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.45;
                                max-lines: 3;
                            }
                        }
                    }

                    SectionLabel { text: Strings.sec-appearance; }
                    Card {
                        height: 171px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-theme; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Segmented {
                                    options: [Strings.theme-system, Strings.theme-dark, Strings.theme-light];
                                    current: root.theme-pref == "dark" ? 1 : (root.theme-pref == "light" ? 2 : 0);
                                    item-height: 24px;
                                    font-size: 11px;
                                    y: (parent.height - self.height) / 2;
                                    selected(i) => {
                                        root.set-theme(i == 1 ? "dark" : (i == 2 ? "light" : "system"));
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-compact; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle {
                                    checked <=> root.compact-mode;
                                    y: (parent.height - self.height) / 2;
                                    // The window no longer binds its own size,
                                    // so switching compact mode has to ask Rust
                                    // to resize the window as well as swap the
                                    // layout — otherwise the compact view opens
                                    // inside a full-size window.
                                    toggled(v) => { root.set-compact-mode(v); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            // Motion on/off. Off makes every transition
                            // instant, which is what a slow machine or a
                            // reduced-motion preference actually needs.
                            HorizontalLayout {
                                height: 52px;
                                VerticalLayout {
                                    spacing: 1px;
                                    alignment: center;
                                    vertical-stretch: 0;
                                    Text { text: Strings.lbl-animations; font-size: 13px; color: Palette.text; horizontal-alignment: Strings.fa ? end : start; }
                                    Text { text: Strings.hint-animations; font-size: 11px; color: Palette.text-dim; overflow: elide; horizontal-alignment: Strings.fa ? end : start; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Toggle {
                                    checked <=> root.animations;
                                    y: (parent.height - self.height) / 2;
                                    toggled(v) => { root.set-animations(v); }
                                }
                            }
                        }
                    }

                    // ── language ──
                    SectionLabel { text: Strings.sec-language; }
                    Card {
                        height: 62px;
                        VerticalLayout {
                            padding: 14px;
                            HorizontalLayout {
                                height: 34px;
                                Text { text: Strings.lbl-language; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Segmented {
                                    options: [Strings.lang-fa, Strings.lang-en];
                                    current: Strings.lang == "fa" ? 0 : 1;
                                    item-height: 26px;
                                    font-size: 11px;
                                    y: (parent.height - self.height) / 2;
                                    selected(i) => { root.set-lang(i == 0 ? "fa" : "en"); }
                                }
                            }
                        }
                    }

                    // ── sound ──
                    SectionLabel { text: Strings.sec-sound; }
                    Card {
                        height: 214px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 26px;
                                Text { text: Strings.lbl-sound-on; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle { checked <=> root.sound-enabled; y: (parent.height - self.height) / 2; }
                            }

                            Text { text: Strings.lbl-chime; font-size: 11px; color: Palette.text-dim; horizontal-alignment: Strings.fa ? end : start; }

                            HorizontalLayout {
                                spacing: 6px;
                                for s[i] in ["santur", "daf", "tombak"] : Rectangle {
                                    height: 30px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: root.sound-theme == s ? Palette.accent : Palette.surface-2;
                                    ta9 := TouchArea { clicked => { root.sound-theme = s; } }
                                    states [
                                        h when ta9.has-hover && root.sound-theme != s : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: s == "santur" ? Strings.snd-santur : (s == "daf" ? Strings.snd-daf : (s == "tombak" ? Strings.snd-tombak : (s == "karn" ? Strings.snd-karn : (s == "sand" ? Strings.snd-sand : Strings.snd-cyrus))));
                                        font-size: 11px;
                                        font-weight: root.sound-theme == s ? 600 : 400;
                                        color: root.sound-theme == s ? Palette.on-accent : Palette.text-dim;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                for s[i] in ["karn", "sand", "cyrus"] : Rectangle {
                                    height: 30px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: root.sound-theme == s ? Palette.accent : Palette.surface-2;
                                    ta10 := TouchArea { clicked => { root.sound-theme = s; } }
                                    states [
                                        h when ta10.has-hover && root.sound-theme != s : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: s == "santur" ? Strings.snd-santur : (s == "daf" ? Strings.snd-daf : (s == "tombak" ? Strings.snd-tombak : (s == "karn" ? Strings.snd-karn : (s == "sand" ? Strings.snd-sand : Strings.snd-cyrus))));
                                        font-size: 11px;
                                        font-weight: root.sound-theme == s ? 600 : 400;
                                        color: root.sound-theme == s ? Palette.on-accent : Palette.text-dim;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // volume + preview
                            HorizontalLayout {
                                height: 30px;
                                spacing: 10px;

                                Rectangle {
                                    height: 6px;
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: Palette.track;

                                    Rectangle {
                                        width: parent.width * root.sound-volume / 100;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: Palette.accent;
                                    }

                                    TouchArea {
                                        moved => {
                                            if (self.pressed) {
                                                root.sound-volume = round(clamp(self.mouse-x / self.width * 100, 0, 100));
                                            }
                                        }
                                        clicked => {
                                            root.sound-volume = round(clamp(self.mouse-x / self.width * 100, 0, 100));
                                        }
                                    }
                                }

                                Text {
                                    text: Digits.num(root.sound-volume) + (Strings.fa ? "٪" : "%");
                                    font-size: 11px;
                                    color: Palette.text-dim;
                                    width: 34px;
                                    horizontal-alignment: end;
                                }

                                Rectangle {
                                    width: 72px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: Palette.surface-2;
                                    ta11 := TouchArea { clicked => { root.preview-sound(); } }
                                    states [
                                        h when ta11.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.preview;
                                        font-size: 11px;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ── system ──
                    SectionLabel { text: Strings.sec-system; }
                    Card {
                        height: 162px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-hotkeys; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle { checked <=> root.hotkey-enabled; y: (parent.height - self.height) / 2; }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-awake; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle { checked <=> root.inhibit-enabled; y: (parent.height - self.height) / 2; }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-overlay; font-size: 13px; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; }
                                Toggle { checked <=> root.overlay-enabled; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    // ── automation ──
                    SectionLabel { text: Strings.sec-automation; }
                    Card {
                        height: 132px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.automation-summary;
                                font-size: 11px;
                                horizontal-alignment: Strings.fa ? end : start;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                max-lines: 2;
                            }

                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 34px;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    LineEdit {
                                        text: root.new-task-text;
                                        placeholder-text: Strings.automation-placeholder;
                                        font-size: 11px;
                                        edited(t) => { root.new-task-text = t; }
                                    }
                                }

                                Rectangle {
                                    width: 58px;
                                    height: 34px;
                                    border-radius: 9px;
                                    background: Palette.accent;
                                    ta12 := TouchArea {
                                        clicked => { root.add-automation("focus_start", root.new-task-text); }
                                    }
                                    states [
                                        h when ta12.has-hover : {
                                            background: Palette.text;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.add;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.on-accent;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: Strings.automation-hint;
                                font-size: 11px;
                                horizontal-alignment: Strings.fa ? end : start;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── cloud ──
                    SectionLabel { text: Strings.sec-cloud; }

                    // Google account card. This is the whole sign-in flow: one
                    // button, then a short code the user types on whatever
                    // device already has a browser. No password ever touches
                    // the app, and no local port has to be reachable.
                    Card {
                        height: root.sync-signed-in ? 132px : (root.sync-device-code == "" ? 132px : 196px);
                        VerticalLayout {
                            padding: 14px;
                            spacing: 9px;

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    y: (parent.height - self.height) / 2;
                                    background: root.sync-signed-in ? Palette.accent : Palette.text-faint;
                                }
                                Text {
                                    text: root.sync-signed-in ? Strings.sync-connected : Strings.sync-off;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: root.sync-signed-in ? Palette.accent : Palette.text-dim;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.sync-account;
                                    font-size: 11px;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: Strings.sync-blurb;
                                font-size: 10px;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                visible: !root.sync-signed-in;
                            }

                            // The device code, shown only while waiting.
                            Rectangle {
                                height: 54px;
                                border-radius: 10px;
                                background: Palette.surface-2;
                                visible: root.sync-device-code != "";
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    alignment: center;
                                    Text {
                                        text: Strings.sync-code-hint;
                                        font-size: 9px;
                                        color: Palette.text-faint;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: root.sync-device-code;
                                        font-size: 20px;
                                        font-weight: 700;
                                        color: Palette.accent;
                                        horizontal-alignment: center;
                                        letter-spacing: 3px;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    visible: !root.sync-signed-in;
                                    ta-sync-connect := TouchArea {
                                        clicked => { if (root.sync-available && !root.sync-waiting) { root.sync-connect(); } }
                                    }
                                    states [
                                        h when ta-sync-connect.has-hover && root.sync-available : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: root.sync-waiting ? Strings.sync-waiting : (root.sync-available ? Strings.sync-connect : Strings.sync-no-client);
                                        font-size: 12px;
                                        color: root.sync-available ? Palette.text : Palette.text-faint;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Sync now, for a user who does not want to wait
                                // for the timer.
                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    visible: root.sync-signed-in;
                                    ta-sync-now := TouchArea { clicked => { root.sync-now(); } }
                                    states [
                                        h when ta-sync-now.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.sync-last;
                                        font-size: 12px;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    visible: root.sync-signed-in;
                                    ta-sync-off := TouchArea { clicked => { root.sync-disconnect(); } }
                                    states [
                                        h when ta-sync-off.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.sync-disconnect;
                                        font-size: 12px;
                                        color: Palette.text-dim;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Automatic sync switch.
                            HorizontalLayout {
                                height: 26px;
                                visible: root.sync-signed-in;
                                alignment: center;
                                Text {
                                    text: Strings.sync-auto;
                                    font-size: 12px;
                                    color: Palette.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: Strings.fa ? end : start;
                                }
                                Toggle {
                                    checked: root.sync-auto-on;
                                    toggled(v) => { root.set-sync-auto(v); }
                                }
                            }
                        }
                    }

                    Card {
                        height: 62px;
                        VerticalLayout {
                            padding: 14px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    ta13 := TouchArea { clicked => { root.backup-now(); } }
                                    states [
                                        h when ta13.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.backup;
                                        font-size: 12px;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    ta14 := TouchArea { clicked => { root.restore-now(); } }
                                    states [
                                        h when ta14.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.restore;
                                        font-size: 12px;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ── about ──
                    SectionLabel { text: Strings.sec-about; }
                    Card {
                        height: 132px;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 8px;
                                Boteh {
                                    size: 26px;
                                    y: (parent.height - self.height) / 2;
                                    color: Palette.accent;
                                    fade: 0.9;
                                }
                                Text {
                                    text: Strings.made-by;
                                    font-size: 11px;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Khosrowan";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                    ta15 := TouchArea {
                                        clicked => { root.open-url("https://khosrowan.ir"); }
                                        mouse-cursor: pointer;
                                    }
                                    states [
                                        h when ta15.has-hover : {
                                            color: Palette.text;
                                            in { animate color { duration: Motion.quick; } }
                                        }
                                    ]
                                }
                            }

                            Text {
                                text: "khosrowan.ir";
                                font-size: 11px;
                                color: Palette.text-dim;
                                ta16 := TouchArea {
                                    clicked => { root.open-url("https://khosrowan.ir"); }
                                    mouse-cursor: pointer;
                                }
                                states [
                                    h when ta16.has-hover : {
                                        color: Palette.accent;
                                        in { animate color { duration: Motion.quick; } }
                                    }
                                ]
                            }

                            // Free Art License 1.3 requires visible attribution for
                            // the Parthian emblem (Derafsh Kaviani, by Oneasy).
                            Text {
                                text: Strings.emblem-credit;
                                font-size: 9px;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: root.sync-status;
                        font-size: 10px;
                        color: Palette.text-faint;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: Strings.app-credit;
                        font-size: 10px;
                        color: Palette.text-faint;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
    // ─────────────────────────────────────────────────────────────────────
    // Resize handles — a frameless window gets no WM resize border, so these
    // eight invisible grab zones give the edges and corners back. They sit on
    // top of the content and are only 5px wide, so they never block a click.
    // ─────────────────────────────────────────────────────────────────────
}
