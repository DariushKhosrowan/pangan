import { LineEdit, TextEdit, SpinBox } from "std-widgets.slint";
import { Shahbaz, Faravahar, Derafsh, Senmurv, Boteh, BotehDivider, EmblemField, SteppedCrenellation, LotusRow, WingedDivider, ArchFrame } from "heritage.slint";
import { SunRing } from "ring.slint";
import { Digits } from "digits.slint";
import { Strings } from "strings.slint";
import { Motion } from "motion.slint";
export { Strings } from "strings.slint";
export { Digits } from "digits.slint";
export { Motion } from "motion.slint";

// ═══════════════════════════════════════════════════════════════════════════
// Pangan — پنگان
//
// Design language: calm, near-monochrome, generous whitespace. A single
// gilded accent carries the Persian identity without shouting it. The timer
// is the hero: a large light-weight numeral inside a true progress ring,
// flanked by three circular controls. Everything else recedes.
//
// Inspired by the restraint of FocusTimer (GNOME), rebuilt for Slint.
// ═══════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────
// Type — the app's type scale, in one place.
//
// The sizes used to be set per element, which had drifted into fifteen
// different values, several of them 8px and 9px. Text that small is not a
// hierarchy, it is a legibility problem: at 8px Persian letterforms lose their
// distinguishing strokes and the whole screen reads as smudged. The scale
// below has a floor of 10px for anything the user must read, and reserves the
// small end for true captions.
//
// Weights are limited to three: 400 for body, 600 for emphasis, 700 for the
// small-caps labels that carry a section.
// ───────────────────────────────────────────────────────────────────────────
export global Type {
    // Captions and metadata: the smallest text that still has to be read.
    out property <length> caption: 10px;
    // Secondary text: hints, sublines, helper copy.
    out property <length> small: 11px;
    // Body: task titles, setting labels, list rows.
    out property <length> body: 13px;
    // Emphasis: card headings and the selected item.
    out property <length> title: 15px;
    // Screen headings.
    out property <length> heading: 17px;
    // The hero clock and the big stat numbers.
    out property <length> display: 24px;

    // Letter-spacing for the small-caps section labels. Persian is a connected
    // script: spacing it out breaks the joins and looks broken, so tracking is
    // only ever applied to the Latin side.
    out property <length> tracking: 1.1px;
}

// ───────────────────────────────────────────────────────────────────────────
// Space — one spacing scale, so nothing has to guess.
//
// The layout used to carry its own numbers: screen gutters were 24px on the
// footer, 18px on the header, 18px on the Today screen and 14px on the other
// screens, and card padding was 13/15 in one place and 12/14 in another. Each
// value was defensible alone; together they meant no two screens lined up, and
// a card's text sat a pixel or two off-centre inside its own box. That is the
// "untidy" that is hard to point at and easy to feel.
//
// Four steps, used everywhere:
//   gutter  — the outer margin of a screen. One value, all screens.
//   pad     — inside a card.
//   gap     — between cards and between rows.
//   tight   — inside a row, between a label and its value.
//
// Asymmetric padding is reserved for one real case: a control that has a
// leading icon and a trailing chevron genuinely needs different ends. Every
// other left/right pair is equal.
// ───────────────────────────────────────────────────────────────────────────
export global Space {
    out property <length> gutter: 18px;
    out property <length> pad: 14px;
    out property <length> gap: 10px;
    out property <length> tight: 6px;
    // A screen's own header is shorter than a card header.
    out property <length> header-height: 44px;
}

// ───────────────────────────────────────────────────────────────────────────
// Palette — one source of truth for both themes.
// ───────────────────────────────────────────────────────────────────────────
export global Palette {
    in-out property <bool> dark: true;
    // Which dynasty's palette is active: cyrus | darius | parthian | sasanid
    // All four are pre-Islamic. No Islamic-era ornament is used in this app.
    in-out property <string> era: "cyrus"; // ── Era accents ────────────────────────────────────────────────────────
    // Cyrus: Achaemenid gold. Darius: Persepolis bronze. All pre-Islamic.
    // Parthian: lapis blue. Sasanid: verdigris silver.
    // The light-theme accents are deliberately darker than the dark-theme
    // ones. The same hue cannot serve both: gold at #A67A2B on an off-white
    // page is 3.5:1, which is not readable text, while the same gold on the
    // dark page is 8.7:1. Each theme gets the lightness its background needs,
    // and every value here clears 4.5:1 against both the page and a card.
    out property <brush> accent: era == "darius"
        ? (dark ? #C87941 : #8A4A1C)
        : era == "sasanid"
        ? (dark ? #4FA89B : #216158)
        : era == "parthian"
        ? (dark ? #5B8FD6 : #2A5495)
        : (dark ? #D6A84E : #8A6419); out property <brush> accent-soft: era == "darius"
        ? (dark ? #2A2018 : #F5E9DC)
        : era == "sasanid"
        ? (dark ? #14251F : #E2F0EC)
        : era == "parthian"
        ? (dark ? #141C2E : #E3E9F5)
        : (dark ? #2A2418 : #F3EAD8); out property <brush> on-accent: era == "darius"
        ? (dark ? #1A0F06 : #FFFFFF)
        : era == "sasanid"
        ? (dark ? #04120F : #FFFFFF)
        : era == "parthian"
        ? (dark ? #060B16 : #FFFFFF)
        : (dark ? #17120A : #FFFFFF); // ── Surfaces, tinted per era ───────────────────────────────────────────
    out property <brush> bg: era == "darius"
        ? (dark ? #12100C : #FAF6EF)
        : era == "sasanid"
        ? (dark ? #0A1413 : #F2F7F5)
        : era == "parthian"
        ? (dark ? #0B0F1A : #F3F5FA)
        : (dark ? #0E1016 : #F7F5F0); out property <brush> surface: era == "darius"
        ? (dark ? #1A1712 : #FFFFFF)
        : era == "sasanid"
        ? (dark ? #111D1B : #FFFFFF)
        : era == "parthian"
        ? (dark ? #131A28 : #FFFFFF)
        : (dark ? #15181F : #FFFFFF); out property <brush> surface-2: era == "darius"
        ? (dark ? #221D16 : #F2ECE1)
        : era == "sasanid"
        ? (dark ? #17251F : #E9F1EE)
        : era == "parthian"
        ? (dark ? #1A2334 : #E8EDF6)
        : (dark ? #1C2029 : #F0EDE6); out property <brush> surface-3: era == "darius"
        ? (dark ? #2A241B : #E8DFD0)
        : era == "sasanid"
        ? (dark ? #1E2E28 : #DCE8E4)
        : era == "parthian"
        ? (dark ? #212C40 : #DCE3F0)
        : (dark ? #232833 : #E7E2D8); out property <brush> border: era == "darius"
        ? (dark ? #2C261D : #E5DCCB)
        : era == "sasanid"
        ? (dark ? #20302A : #D9E5E1)
        : era == "parthian"
        ? (dark ? #232F45 : #D8E0EE)
        : (dark ? #262A35 : #E3DED3); out property <brush> hairline: era == "darius"
        ? (dark ? #221D15 : #EFE8DC)
        : era == "sasanid"
        ? (dark ? #182722 : #E8F0ED)
        : era == "parthian"
        ? (dark ? #1A2334 : #E7ECF5)
        : (dark ? #1E222B : #EDE9E1); out property <brush> text: dark ? #E9E7EF : #1B1A20; out property <brush> text-dim: dark ? #9A9DAD : #6B6774; out property <brush> text-faint: dark ? #868B9C : #726D7A; out property <brush> track: era == "darius"
        ? (dark ? #2A241B : #E8DFD0)
        : era == "sasanid"
        ? (dark ? #1E2E28 : #DCE8E4)
        : era == "parthian"
        ? (dark ? #212C40 : #DCE3F0)
        : (dark ? #232833 : #E7E2D8); // The accent, one step deeper. Used for the pressed/hover state of any
    // control filled with the accent, so the label keeps its contrast: white
    // on the light-theme gold goes from 5.36:1 to 6.12:1, where a lightened
    // hover dropped it to 4.40:1.
    out property <brush> accent-strong: era == "darius"
        ? (dark ? #D0834C : #7E4419)
        : era == "sasanid"
        ? (dark ? #5CB4A8 : #1E5950)
        : era == "parthian"
        ? (dark ? #6E9CDA : #264D89)
        : (dark ? #DAB263 : #7E5C17); // A shadow that works on both themes: a warm grey at low alpha in light, a
    // true black in dark. A grey shadow on a dark page reads as a smudge.
    out property <color> shadow: dark ? #00000066 : #2A211433; out property <brush> danger: dark ? #C9635B : #B04A42;
    // A kept block, drawn in the same muted manner as `danger` so the two read
    // as a matched pair of judgements rather than one being a status colour and
    // the other a warning. Deliberately not a saturated green: the app does not
    // celebrate a kept promise, it records one.
    out property <brush> success: dark ? #6FA97F : #3F7A52;
    // The dim behind a modal. Dark enough that the timer underneath reads as
    // unavailable, light enough that the window still feels like the same app
    // rather than a blackout.
    out property <color> scrim: dark ? #05060ACC : #14121E66; }

export struct TaskItem {
    id: int,
    title: string,
    time: string,
    done: bool,
}

// One "on this day" row.
export struct CalEvent {
    section: string,   // گروه: رخداد / زادروز / درگذشت / مناسبت
    year: string,      // "۱۱۹۲" or ""
    text: string,
}

// One square of the month grid.
export struct DayCell {
    day: int,          // 0 for the blanks that pad the first week
    label: string,     // the day in Persian digits, or ""
    key: string,       // "1405-08-07", or "" for a blank
    is-today: bool,
    selected: bool,
    has-tasks: bool,   // at least one open task on this day
    open-count: string, // how many, in Persian digits, or ""
}

// One week of the month grid. Slint's GridLayout has no explicit column count,
// so the grid is built as a list of rows of seven rather than one flat list.
export struct DayRow {
    cells: [DayCell],
}

// One planned block on the day's rota.
//
// `state` is a word rather than a bool pair so the row has one thing to read:
// "next" is the block Start Next will take, "started" one already begun, and
// "waiting" one queued behind the current block.
export struct RotaItem {
    id: int,
    /// The ordinal shown at the left, in the UI's digits ("۱", "۲", …).
    number: string,
    label: string,
    /// "25m", already formatted for the active language's digits.
    length: string,
    /// "next" | "waiting" | "started"
    state: string,
    /// The decree this block will open with, "" when it has none. Shown as a
    /// second line so the intention is visible before the block runs, which is
    /// the whole reason it was written down early.
    decree: string,
    /// What became of the block: "done" | "abandoned" | "missed" | "pending".
    ///
    /// Distinct from `state`, which says where the row stands in the queue.
    /// An entry can be `started` and `abandoned` at once — the block was taken
    /// up and did not finish — and that pair is the most useful thing the row
    /// can say, because it is the one the user cannot see for themselves.
    outcome: string,
}

// One saved plan: a day shape that can be given to another day.
//
// `summary` is prebuilt in Rust ("۴ بلوک · ۱۳۵ دقیقه") because the counts and
// the length both need the active language's digits, and Slint has no string
// interpolation.
export struct PlanItem {
    id: int,
    name: string,
    summary: string,
}

// One row of the inscription archive.
export struct InscriptionItem {
    id: string,
    /// The line that was written.
    text: string,
    /// "HH:MM" on the day it belongs to.
    time: string,
    /// The day heading it sits under ("۱۴ آبان ۱۴۰۵"), or "" when it continues
    /// the previous row's day — so the archive reads as day groups, not as a
    /// flat list where the same date repeats on every line.
    day: string,
    /// Which focus session it belongs to (Unix seconds), used to attach a
    /// deletion to the right row.
    session: int,
    /// The intention this inscription answers, "" when the block had none.
    /// Shown above the written line so the pair reads as promise then outcome.
    decree: string,
    /// What the user said this block was, already translated and formatted in
    /// Rust ("انجام شد"), or "" when nothing has been said about it yet.
    ///
    /// Empty is the common case and means *ask*: the row shows the five seals
    /// instead. A guess drawn the same as a stated fact is a guess the user
    /// will trust, which is why the app never fills this in from the shape.
    verdict: string,
    /// True when the user said it; false when the app inferred it. Drives the
    /// filled-vs-hollow seal, so the difference is visible at a glance rather
    /// than only in the wording.
    verdict-declared: bool,
    /// The verdict's storage key ("kept", "partial", …), so the row can tell
    /// which seal is the active one without comparing translated strings.
    verdict-kind: string,
    /// The rota entry this block was planned as, or "" when the block was
    /// started from the plain timer rather than from the day's list.
    ///
    /// Shown first on the row, above the decree: the plan is the outermost
    /// layer of what the block was for — the list said it, the decree refined
    /// it, the inscription says what came of it.
    planned: string,
}

// One decree the span made and did not answer.
//
// The most useful row in the archive: it is a block that was spoken for and then
// produced no words. Shown on the report because that is where the user is
// already asking what a period added up to.
export struct UnfulfilledItem {
    text: string,
    /// The day it was planned for, already in the active calendar's digits.
    day: string,
}

// One word that recurs across a span's decrees.
export struct ThemeItem {
    word: string,
    /// How many decrees used it, in the active script's digits.
    count: string,
    /// 0..1, how strongly to fill the bar — the count relative to the strongest
    /// theme, so the first row is always full and the shape is readable.
    weight: float,
}

// ───────────────────────────────────────────────────────────────────────────
// Radius — one corner scale for the whole app.
//
// The cards used to carry eleven different corner values (9, 10, 12, 13, 14,
// 15, 16, …). Each was chosen in isolation for the box of the moment, so a
// 14px task card could sit directly above a 16px date card and neither read as
// more important than the other. A rounded corner is the strongest "this is a
// container" signal the app has; spending eleven shades of it means the signal
// carries no information.
//
// Three steps is enough: tile, card, panel.
// ───────────────────────────────────────────────────────────────────────────
export global Radius {
    out property <length> tile: 10px;
    out property <length> card: 14px;
    out property <length> panel: 18px;
}

// ───────────────────────────────────────────────────────────────────────────
// Elevation — how far a surface sits above the page.
//
// Before this the app had exactly one shadow, on the play button, and every
// other surface — the date card, the task list, the settings cards, the
// report's headline — was a flat fill behind a 1px hairline. Flat-and-outlined
// is legible but it is also the look of a form, not of an app: nothing says
// which layer is in front, so a window full of cards reads as a grid of boxes.
//
// Two levels, and the rule is simple: anything that floats over the page gets a
// shadow, anything that is part of the page does not. The blur/offset values
// are deliberately small — on a 420px-wide window a 24px blur reads as a
// smudge, not as depth.
// ───────────────────────────────────────────────────────────────────────────
export global Elev {
    in-out property <bool> dark: true;

    // A raised card: present, but sitting close to the page.
    out property <length> card-blur: dark ? 10px : 8px;
    out property <length> card-y: dark ? 3px : 2px;
    out property <color> card-shadow: dark ? #00000055 : #2A21141F;

    // A floating surface: the hero date stepper and the primary control.
    out property <length> lift-blur: dark ? 18px : 14px;
    out property <length> lift-y: dark ? 6px : 4px;
    out property <color> lift-shadow: dark ? #00000070 : #2A211428;

    // The sheen that makes a flat fill read as a lit surface.
    //
    // A card painted one solid colour has no light on it, which is why the
    // cards looked like cut paper. This is a gradient overlay drawn on top of
    // the card's own fill: in the dark theme the top edge catches a little
    // light and fades out by the middle, and in the light theme the bottom
    // edge settles into a faint tint. Both are alpha-only, so they layer over
    // whichever era's surface colour is underneath without knowing what it is.
    out property <brush> sheen: dark
        ? @linear-gradient(180deg, #FFFFFF10 0%, #FFFFFF00 58%)
        : @linear-gradient(180deg, #FFFFFF00 42%, #0000000A 100%);

    // The page's own light: a wide, very faint radial wash behind the timer,
    // as if the room were lit from above the clock. Without it the background
    // is one flat rectangle of colour and the hero has nothing to sit in front
    // of. Kept under 6% so it never becomes a visible blob.
    //
    // Slint's radial gradient takes no `at` position, so it is centred by the
    // element that draws it rather than by the gradient itself.
    out property <brush> page-light: dark
        ? @radial-gradient(circle, #FFFFFF12 0%, #FFFFFF00 60%)
        : @radial-gradient(circle, #FFFFFFC0 0%, #FFFFFF00 60%);
}

// ───────────────────────────────────────────────────────────────────────────
// Icons — drawn, not glyphs, so they stay crisp and identical everywhere.
// ───────────────────────────────────────────────────────────────────────────
component Icon {
    in property <string> kind: "play";
    in property <length> size: 18px;
    in property <brush> color: Palette.text;

    width: size;
    height: size;

    if kind == "play" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 8 5 L 19 12 L 8 19 Z";
    }
    if kind == "pause" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 8 5 h 3 v 14 h -3 Z M 14 5 h 3 v 14 h -3 Z";
    }
    if kind == "skip" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 6 5 L 15 12 L 6 19 Z M 17 5 h 2 v 14 h -2 Z";
    }
    if kind == "reset" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 12 4 A 8 8 0 1 0 20 12 L 17.5 12 A 5.5 5.5 0 1 1 12 6.5 L 12 9.5 L 8 6 L 12 2.5 Z";
    }
    if kind == "sliders" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 4 7 h 16 M 4 12 h 16 M 4 17 h 16";
    }
    if kind == "close" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 6 6 L 18 18 M 18 6 L 6 18";
    }
    if kind == "plus" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 5 v 14 M 5 12 h 14";
    }
    if kind == "check" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 5 12.5 L 10 17.5 L 19 6.5";
    }
    if kind == "timer" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 4 A 8 8 0 1 0 20 12 A 8 8 0 0 0 12 4 Z M 12 8 v 4.5 l 3 2";
    }
    if kind == "chart" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 6 19 v -5 M 12 19 v -11 M 18 19 v -8";
    }
    if kind == "chevron" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 9 5 L 16 12 L 9 19";
    }
    if kind == "back" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 15 5 L 8 12 L 15 19";
    }
    if kind == "moon" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        fill: color;
        commands: "M 20 14.5 A 8.5 8.5 0 1 1 9.5 4 A 7 7 0 0 0 20 14.5 Z";
    }
    if kind == "sun" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 12 7.5 A 4.5 4.5 0 1 0 12 16.5 A 4.5 4.5 0 0 0 12 7.5 Z M 12 2 v 2 M 12 20 v 2 M 2 12 h 2 M 20 12 h 2 M 5 5 l 1.5 1.5 M 17.5 17.5 L 19 19 M 19 5 L 17.5 6.5 M 6.5 17.5 L 5 19";
    }
    // Pencil: a slanted nib with a baseline, for rename.
    if kind == "edit" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4 20 h 4 L 19 9 L 15 5 L 4 16 Z M 14 6 L 18 10";
    }
    // Bin: a lid, a body and two ribs, for delete.
    if kind == "trash" : Path {
        width: size; height: size;
        viewbox-width: 24; viewbox-height: 24;
        stroke: color;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: "M 4 7 h 16 M 9 7 V 4 h 6 v 3 M 6 7 l 1 13 h 10 l 1 -13 M 10 11 v 5 M 14 11 v 5";
    }
}

// ───────────────────────────────────────────────────────────────────────────
// TaskAction — one of the small per-task controls (move, rename, delete).
//
// Kept deliberately quiet: at rest it is barely visible, and it only takes on
// colour on hover. Four always-lit icons on every row would turn a task list
// into a toolbar.
// ───────────────────────────────────────────────────────────────────────────
component TaskAction inherits Rectangle {
    in property <string> icon: "edit";
    /// What this control does, in words. Icon-only buttons are invisible to a
    /// screen reader, so the label is what makes them usable without sight.
    in property <string> tip: "";
    /// Turns the icon red on hover. Used for delete, so the destructive action
    /// reads as destructive before it is clicked.
    in property <bool> destructive: false;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.tip;

    ta-act := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    states [
        hovered when ta-act.has-hover : {
            background: Palette.surface-3;
            in { animate background { duration: Motion.quick; } }
        }
    ]

    Icon {
        kind: root.icon;
        size: 13px;
        // text-faint was too pale to see against the card, which made the
        // controls look absent rather than quiet. text-dim is legible at rest
        // and still recedes behind the task title.
        color: root.destructive && ta-act.has-hover
            ? Palette.danger
            : (ta-act.has-hover ? Palette.text : Palette.text-dim);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ───────────────────────────────────────────────────────────────────────────
// DayStep — the previous/next-day button on the timer screen.
//
// A rounded square rather than a circle, so it reads as a control beside the
// date block instead of another round icon competing with the timer's own
// round buttons. The chevron is a single clean stroke; on hover the tile lifts
// to the accent tint and the chevron darkens, and on press it scales down a
// touch so the click is felt.
// ───────────────────────────────────────────────────────────────────────────
component DayStep inherits Rectangle {
    in property <bool> forward: false; callback clicked; width: 32px; height: 32px; border-radius: 16px; background: transparent; border-width: 1px; border-color: transparent; ta := TouchArea { clicked => { root.clicked(); } }

    states [
        hovered when ta.has-hover : {
            background: Palette.accent-soft; border-color: Palette.accent; in { animate background { duration: Motion.quick; } animate border-color { duration: Motion.quick; } }
        }
        pressed when ta.pressed : {
            background: Palette.accent; in { animate background { duration: Motion.instant; } }
        }
    ]

    // The chevron. `forward` mirrors it, so one path serves both directions.
    Icon {
        kind: root.forward ? "chevron" : "back"; size: 15px; color: ta.pressed ? Palette.on-accent : (ta.has-hover ? Palette.accent : Palette.text-dim); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

// ───────────────────────────────────────────────────────────────────────────
// IconButton — circular, quiet by default, warms on hover.
// ───────────────────────────────────────────────────────────────────────────
component IconButton inherits Rectangle {
    in property <string> icon: "play";
    in property <length> size: 34px;
    in property <length> icon-size: 17px;
    in property <brush> fg: Palette.text-dim;
    in property <brush> hover-bg: Palette.surface-2;
    // A disabled button still occupies its slot — the layout must not jump
    // when an arrow becomes unavailable — but it stops responding and its
    // glyph fades, so "there is nothing further this way" is visible rather
    // than something the user discovers by pressing a dead control.
    in property <bool> enabled: true;
    callback clicked;

    width: size;
    height: size;
    border-radius: size / 2;
    background: transparent;

    ta1 := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }

    Icon {
        kind: root.icon;
        size: root.icon-size;
        color: root.enabled ? root.fg : Palette.text-faint;
        opacity: root.enabled ? 1.0 : 0.35;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    states [
        hovered when ta1.has-hover && root.enabled : {
            background: root.hover-bg;
            in {
                animate background { duration: Motion.quick; easing: ease-out; }
            }
        }
    ]
}

// ───────────────────────────────────────────────────────────────────────────
// TimerButton — the transport controls under the clock.
//
// These used to be bare icons floating on the page with no surface at all,
// which is why they read as decoration rather than as buttons: nothing told
// you they were pressable. Each one now sits on a real surface with a hairline,
// and the primary (play/pause) is filled with the accent so the row has one
// obvious target. Hover deepens the fill instead of replacing it with
// Palette.text, which made the button look like it had changed identity.
// ───────────────────────────────────────────────────────────────────────────
component TimerButton inherits Rectangle {
    in property <string> icon: "reset";
    in property <length> size: 44px;
    in property <length> icon-size: 18px;
    in property <bool> primary: false;
    in property <bool> running: false;
    callback clicked;

    width: size;
    height: size;
    // A Rectangle in a HorizontalLayout stretches to fill by default, which
    // turned all three of these into full-width bars. Pin them to their size.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: size / 2;

    // Primary carries the accent and a shadow so it sits above the row;
    // secondary is a quiet tile that only wakes on hover.
    //
    // The secondary fill is `surface` (white in light, the card colour in
    // dark) rather than `surface-2`, because surface-2 is only 1.07:1 against
    // the page — the tiles were there but invisible, so the icons looked like
    // they were floating loose on the background. White plus a real hairline
    // gives them an edge without making them shout.
    background: primary ? Palette.accent : Palette.surface;
    border-width: primary ? 0px : 1px;
    border-color: primary ? transparent : Palette.border;
    // A tight shadow. At 10px blur on a light page the shadow spread wider
    // than the button and read as a pale rectangle behind the whole row.
    drop-shadow-blur: primary ? 5px : 0px;
    drop-shadow-color: primary ? Palette.shadow : transparent;
    drop-shadow-offset-y: primary ? 2px : 0px;

    ta := TouchArea { clicked => { root.clicked(); } }

    states [
        hovered when ta.has-hover && !primary : {
            background: Palette.surface-3;
            border-color: Palette.accent;
            in { animate background { duration: Motion.quick; } animate border-color { duration: Motion.quick; } }
        }
        hovered-primary when ta.has-hover && primary : {
            background: Palette.accent-strong;
            in { animate background { duration: Motion.quick; } }
        }
        pressed when ta.pressed : {
            drop-shadow-blur: 0px;
            drop-shadow-offset-y: 0px;
            in { animate drop-shadow-blur { duration: Motion.instant; } }
        }
    ]

    Icon {
        kind: root.icon;
        size: root.icon-size;
        // The play triangle is optically left-heavy, so it is nudged right to
        // sit in the circle's true centre. Pause is symmetric and is not.
        color: root.primary ? Palette.on-accent : (ta.has-hover ? Palette.accent : Palette.text-dim); x: (parent.width - self.width) / 2 + (root.primary && root.icon == "play" ? 2px : 0px); y: (parent.height - self.height) / 2; }
}

// ───────────────────────────────────────────────────────────────────────────
// Ring — a true arc progress ring with a rounded cap.
// ───────────────────────────────────────────────────────────────────────────
// Segmented — a quiet two-or-three way switch.
// ───────────────────────────────────────────────────────────────────────────
component Segmented inherits Rectangle {
    in property <[string]> options: ["زمان‌سنج", "آمار"];
    in property <int> current: 0;
    in property <length> item-height: 28px;
    in property <length> font-size: Type.small;
    callback selected(int);

    height: item-height + 8px;
    width: self.preferred-width;
    // 62px per item is comfortable for the Latin labels and tight for the
    // Persian ones, which are wider at the same point size. 70px is headroom
    // rather than a measurement, and the label below elides instead of
    // spilling if a translation ever outgrows it.
    preferred-width: (options.length * 70px) + 8px;
    border-radius: (item-height + 8px) / 2;
    background: Palette.surface-2;

    // sliding indicator
    Rectangle {
        width: (parent.width - 8px) / root.options.length;
        height: root.item-height;
        x: 4px + root.current * self.width;
        y: 4px;
        border-radius: root.item-height / 2;
        background: Palette.surface;
        border-width: 1px;
        border-color: Palette.border;
        animate x { duration: Motion.normal; easing: ease-out; }
    }

    HorizontalLayout {
        padding: 4px;
        spacing: 0px;

        for o[index] in root.options : Rectangle {
            width: (root.width - 8px) / root.options.length;
            height: root.item-height;
            background: transparent;
            border-radius: root.item-height / 2;

            ta2 := TouchArea {
                clicked => { root.selected(index); }
            }

            Text {
                text: o;
                font-size: root.font-size;
                font-weight: index == root.current ? 600 : 400;
                color: index == root.current ? Palette.text : Palette.text-dim;
                horizontal-alignment: center;
                width: parent.width;
                height: parent.height;
                // A label that outgrows its cell elides rather than spilling
                // over its neighbour; the switch keeps its even columns either
                // way.
                overflow: elide;
                animate color { duration: Motion.quick; }
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Toggle — pill switch with an animated knob.
// ───────────────────────────────────────────────────────────────────────────
component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Palette.accent : Palette.surface-3;

    animate background { duration: Motion.normal; easing: ease-out; }

    Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? parent.width - 21px : 3px;
        border-radius: 9px;
        background: root.checked ? Palette.on-accent : Palette.surface;
        animate x { duration: Motion.normal; easing: ease-out; }
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Stepper — minus / value / plus, for durations.
// ───────────────────────────────────────────────────────────────────────────
component Stepper inherits Rectangle {
    in-out property <int> value: 25;
    in property <int> min: 1;
    in property <int> max: 180;
    in property <string> suffix: "د";
    callback changed(int);

    height: 30px;
    // Width follows the widest value the control can show, not a guess.
    //
    // It was a hard 124px with a 66px value box inside, which fitted "25 min"
    // and clipped "180 دقیقه" — the longest value the timer card can produce —
    // so the right-hand end of the number sat under the plus button.
    width: self.preferred-width;
    preferred-width: 26px + 26px + Math.max(66px, value-text.preferred-width + 12px) + 6px;
    border-radius: 15px;
    background: Palette.surface-2;

    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        spacing: 0px;

        Rectangle {
            width: 26px;
            height: 26px;
            y: 2px;
            border-radius: 13px;
            background: transparent;
            ta3 := TouchArea {
                clicked => {
                    if (root.value > root.min) {
                        root.value = root.value - 1;
                        root.changed(root.value);
                    }
                }
            }
            states [
                hovered when ta3.has-hover : {
                    background: Palette.surface-3;
                    in { animate background { duration: Motion.instant; } }
                }
            ]
            Text {
                text: "−";
                // Matched to the plus below. These were 15px and 13px, so the
                // two ends of one control were visibly different sizes.
                font-size: Type.body;
                color: root.value > root.min ? Palette.text : Palette.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        value-text := Text {
            text: Digits.num(root.value) + root.suffix;
            font-size: Type.small;
            font-weight: 600;
            color: Palette.text;
            horizontal-alignment: center;
            // Slint defaults vertical-alignment to top. With a full-height
            // Text that pinned "25 دقیقه" to the top of the pill instead of
            // sitting it in the middle, which read as "the numbers drifted up".
            vertical-alignment: center;
            // Grows with the value instead of being pinned at 66px, which is
            // what cut off the longest suffix.
            width: Math.max(66px, self.preferred-width + 12px);
            height: parent.height;
        }

        Rectangle {
            width: 26px;
            height: 26px;
            y: 2px;
            border-radius: 13px;
            background: transparent;
            ta2 := TouchArea {
                clicked => {
                    if (root.value < root.max) {
                        root.value = root.value + 1;
                        root.changed(root.value);
                    }
                }
            }
            states [
                hovered when ta2.has-hover : {
                    background: Palette.surface-3;
                    in { animate background { duration: Motion.instant; } }
                }
            ]
            Text {
                text: "+";
                font-size: Type.body;
                color: root.value < root.max ? Palette.text : Palette.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// StatCard — label above, big value below. The FocusTimer stats idiom.
// ───────────────────────────────────────────────────────────────────────────
component StatCard inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <string> hint: "";

    // Measures itself rather than holding 78px. A fixed height was fine while
    // every label was one short word; the moment one wraps, or a value carries
    // a unit, the text ran past the bottom edge and was clipped by the card.
    height: self.preferred-height;
    border-radius: Radius.card;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.hairline;
    drop-shadow-blur: Elev.card-blur;
    drop-shadow-offset-y: Elev.card-y;
    drop-shadow-color: Elev.card-shadow;

    VerticalLayout {
        // Equal on all four sides. It used to be 13/15, which put the label a
        // pixel high and a pixel left of centre — the kind of offset that reads
        // as "sloppy" without anyone being able to say why.
        padding: Space.pad;
        spacing: 3px;
        alignment: start;

        Text {
            text: root.label;
            font-size: Type.caption;
            font-weight: 700;
            // Tracking is a Latin-only device here. It was applied to every
            // label unconditionally, so each Persian label on the report —
            // "نشست‌ها", "پیوستگی" — had its joins pulled apart and read as
            // broken text rather than as a heading.
            letter-spacing: Strings.fa ? 0px : Type.tracking;
            color: Palette.text-faint;
            overflow: elide;
        }
        Text {
            text: root.value;
            font-size: Type.display;
            font-weight: 400;
            color: Palette.text;
            overflow: elide;
        }
        Text {
            text: root.hint;
            font-size: Type.caption;
            color: Palette.text-faint;
            visible: root.hint != "";
            wrap: word-wrap;
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// VerdictSeal — one tappable judgement on an archive row.
//
// Hollow until pressed, filled in the accent once the user has said it. The
// shape carries the state on its own, before any word is read: an open outline
// asks, a filled chip answers. `active` is also what marks the current choice
// when the row is re-rendered, so the user can see which of the five they
// pressed without comparing labels.
// ───────────────────────────────────────────────────────────────────────────
component VerdictSeal inherits Rectangle {
    in property <string> kind: "";
    in property <string> label: "";
    in property <bool> active: false;
    /// The storage key of the seal that was pressed.
    callback picked(string);

    height: 22px;
    border-radius: 11px;
    background: active ? Palette.accent-soft : transparent;
    border-width: 1px;
    border-color: active ? Palette.accent : Palette.hairline;

    ta := TouchArea {
        clicked => { root.picked(root.kind); }
    }
    states [
        hot when ta.has-hover : {
            background: Palette.surface-2;
            border-color: Palette.accent;
        }
    ]

    // The layout is what gives the chip its width: a Rectangle has no padding,
    // so a bare Text child would sit at the origin and be clipped by the fixed
    // 22px height.
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.label;
            font-family: "Vazirmatn";
            font-size: Type.caption;
            color: (ta.has-hover || root.active) ? Palette.accent : Palette.text-faint;
            vertical-alignment: center;
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// VerdictChip — one verdict kind and how many blocks fell into it.
//
// A chip rather than a StatCard: five judgements side by side are a vocabulary,
// and giving each one a card would draw them as five separate metrics when the
// point is that together they cover what happened to a day.
//
// Zero is shown, not hidden. A tally with one chip silently missing its number
// reads as a rendering fault, and "none of the blocks were cut short" is a real
// fact about the week — one the user came to this card to learn. A zero chip is
// drawn dim and unfilled so it stays out of the way without being absent.
// ───────────────────────────────────────────────────────────────────────────
component VerdictChip inherits Rectangle {
    in property <string> label: "";
    in property <int> count: 0;
    in property <brush> tint: Palette.text-faint;

    height: 24px;
    border-radius: 12px;
    background: count > 0 ? Palette.surface-2 : transparent;
    border-width: 1px;
    border-color: count > 0 ? tint : Palette.hairline;

    // The count and the label are two Text nodes rather than one interpolated
    // string: in an RTL layout the bidi algorithm reorders a numeral followed
    // by Persian text, so "انجام شد ۲" written as one string renders as
    // "۲ انجام شد" — the count jumping in front of its own label. Separate
    // nodes are laid out by the HorizontalLayout, which cannot reorder them.
    //
    // Order matters here: the number goes first in the layout so it sits at the
    // visual start of the chip in both languages, the way a count reads.
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;

        Text {
            text: Digits.num(root.count);
            font-size: Type.caption;
            font-weight: 700;
            color: root.count > 0 ? root.tint : Palette.text-faint;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-family: "Vazirmatn";
            font-size: Type.caption;
            color: root.count > 0 ? root.tint : Palette.text-faint;
            vertical-alignment: center;
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// BarChart — the report's column chart.
//
// It used to be hard-wired to seven values and seven labels, which is why the
// Stats screen could only ever show a week. It now takes whatever the report
// produced: 24 hours for a day, 28–31 days for a Jalali month, 12 months for a
// year. Columns are equal-width and self-measuring so the same component works
// at every count without a special case.
//
// Two states carry meaning rather than decoration: the column containing today
// is drawn in the accent, and columns in the future are drawn as a faint floor
// so a half-finished week does not look like a week of failures.
// ───────────────────────────────────────────────────────────────────────────
component BarChart {
    in property <[float]> values: [];
    in property <[string]> labels: [];
    in property <int> current: -1;
    in property <int> future-from: 999;
    in property <int> label-every: 1;
    in property <length> bar-gap: 3px;

    // The plot height is a constant, not `parent.height`: reading the parent
    // inside a layout whose height comes from its children is a binding loop,
    // and Slint resolves that loop to zero.
    property <length> plot-height: 108px;

    height: plot-height + 30px;

    VerticalLayout {
        spacing: 6px;

        // No HorizontalLayout here. A horizontal layout with `alignment: end`
        // gives each child its preferred height and pushes it to the bottom,
        // and a Rectangle whose height is a binding has no preferred height —
        // so every column was laid out at zero and the chart drew nothing but
        // its labels. Positioning each column explicitly against a known plot
        // height is both simpler and immune to that.
        Rectangle {
            height: root.plot-height;
            background: transparent;

            for v[i] in root.values : Rectangle {
                x: i * ((root.width - (root.values.length - 1) * root.bar-gap) / root.values.length + root.bar-gap);
                width: (root.width - (root.values.length - 1) * root.bar-gap) / root.values.length;
                // Anchored to the bottom of the plot: top = plot − bar height.
                y: root.plot-height - max(3px, (root.plot-height - 4px) * v);
                height: max(3px, (root.plot-height - 4px) * v);
                border-radius: 4px;
                background: i == root.current
                    ? Palette.accent
                    : (i >= root.future-from ? Palette.hairline : Palette.surface-3);
                animate height { duration: Motion.slow; easing: ease-out; }
                animate y { duration: Motion.slow; easing: ease-out; }
                animate background { duration: Motion.normal; }
            }
        }

        Rectangle {
            height: 18px;
            background: transparent;

            for l[i] in root.labels : Text {
                x: i * ((root.width - (root.labels.length - 1) * root.bar-gap) / root.labels.length + root.bar-gap);
                width: (root.width - (root.labels.length - 1) * root.bar-gap) / root.labels.length;
                height: 18px;
                text: Math.mod(i, root.label-every) == 0 ? l : "";
                font-size: Type.caption;
                font-weight: i == root.current ? 700 : 400;
                color: i == root.current ? Palette.text : Palette.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// HourStrip — the 24-hour profile.
//
// A single row of thin columns, no labels. It answers a different question
// from the main chart: not "which day" but "what time of day do I actually
// work", which is the one thing a daily total can never show.
// ───────────────────────────────────────────────────────────────────────────
component HourStrip {
    in property <[float]> values: [];

    property <length> plot-height: 38px;
    height: plot-height;

    Rectangle {
        height: root.plot-height;
        background: transparent;

        for v[i] in root.values : Rectangle {
            x: i * ((root.width - (root.values.length - 1) * 2px) / root.values.length + 2px);
            width: (root.width - (root.values.length - 1) * 2px) / root.values.length;
            y: root.plot-height - max(2px, (root.plot-height - 2px) * v);
            height: max(2px, (root.plot-height - 2px) * v);
            border-radius: 2px;
            // Dawn, day, dusk, night: the accent fades as the hour gets later,
            // so the strip reads as a clock rather than as 24 identical bars.
            background: i < 6 ? Palette.surface-3
                : i < 18 ? Palette.accent
                : Palette.surface-3;
            opacity: i < 6 || i >= 18 ? 0.55 : 1.0;
            animate height { duration: Motion.slow; easing: ease-out; }
            animate y { duration: Motion.slow; easing: ease-out; }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// PeriodPicker — the Stats screen's five-way period switch.
//
// Five mutually exclusive choices in one control. A row of separate buttons
// would read as five actions; a segmented control reads as one choice, which
// is what it is. Separate from `Segmented` above because that one sizes itself
// to a fixed 70px per item for the two-item nav switch, while this one has to
// share the full card width evenly across five labels.
// ───────────────────────────────────────────────────────────────────────────
component PeriodPicker inherits Rectangle {
    in property <[string]> options: []; in property <int> current: 0; callback selected(int); height: 32px; border-radius: 16px; background: Palette.surface-2; border-width: 1px; border-color: Palette.hairline; HorizontalLayout {
        padding: 3px; spacing: 2px; for o[i] in root.options : Rectangle {
            horizontal-stretch: 1; border-radius: 13px; background: i == root.current ? Palette.surface : transparent; border-width: i == root.current ? 1px : 0px; border-color: Palette.hairline; seg-ta := TouchArea {
                clicked => { root.selected(i); }
            }

            Text {
                text: o; font-size: Type.small; font-weight: i == root.current ? 700 : 400; color: i == root.current ? Palette.text : Palette.text-dim; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }

            states [
                hovered when seg-ta.has-hover && i != root.current : {
                    background: Palette.surface-3; in { animate background { duration: Motion.quick; } }
                }
            ]
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// RotaRow — one planned block: its number, what it is, how long, and the line
// it opens with.
//
// The row says its own state rather than relying on colour alone: a block that
// has been started is dimmed and struck through by label, and the next one to
// run is marked "next" so the queue's head is never ambiguous.
// ───────────────────────────────────────────────────────────────────────────
component RotaRow inherits Rectangle {
    in property <RotaItem> item;
    in property <bool> last: false;
    /// True when this row may be removed — the block has not been started.
    in property <bool> removable: true;
    callback start-entry(int);
    callback remove-entry(int);

    // Two lines for an entry with a decree, one for an entry without: the
    // decree is the point, so it gets room rather than being elided away.
    height: item.decree == "" ? 40px : 54px;

    Rectangle {
        width: parent.width;
        height: 1px;
        y: parent.height - 1px;
        background: Palette.hairline;
        visible: !root.last;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 10px;
        alignment: start;

        // The ordinal. A rota is a sequence, so its position is the most
        // important thing about an entry after its text.
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            y: (parent.height - self.height) / 2;
            background: item.state == "next" ? Palette.accent : Palette.surface-3;
            Text {
                text: item.number;
                font-size: Type.small;
                font-weight: 700;
                color: item.state == "next" ? Palette.on-accent : Palette.text-dim;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            // No explicit `width: parent.width` on these: a Text inside a
            // layout that is itself sized by the layout creates a binding loop
            // (layoutinfo -> width -> layoutinfo). `horizontal-stretch` on the
            // enclosing layout is what gives them the room.
            Text {
                text: item.label;
                font-size: Type.body;
                color: item.state == "started" ? Palette.text-faint : Palette.text;
                overflow: elide;
            }

            if item.decree != "" : Text {
                text: item.decree;
                font-size: Type.caption;
                color: Palette.text-faint;
                overflow: elide;
            }
        }

        Text {
            text: item.length;
            font-size: Type.small;
            color: Palette.text-faint;
            y: (parent.height - self.height) / 2;
        }

        // A block already begun. This is the "taken up" mark the row has
        // instead of a strikeout, and it stays for the rest of the day so the
        // rota reads as a record of what was planned and what was started.
        //
        // Two marks rather than one, because "begun" and "finished" are the
        // distinction the whole outcome record exists to draw: a filled tick
        // means a session landed, a hollow ring means the block was opened and
        // given up. Drawing both identically would hide the only fact the user
        // cannot recover from memory.
        if item.outcome == "done" : Icon {
            kind: "check";
            size: 12px;
            color: Palette.accent;
            y: (parent.height - self.height) / 2;
        }

        if item.state == "started" && item.outcome == "abandoned" : Rectangle {
            width: 11px;
            height: 11px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.text-faint;
            background: transparent;
            y: (parent.height - self.height) / 2;
        }

        if item.outcome == "missed" : Icon {
            kind: "close";
            size: 10px;
            color: Palette.text-faint;
            y: (parent.height - self.height) / 2;
        }

        // Remove. Only offered for a block that has not been started: taking
        // away a block that already ran would leave the day's record claiming
        // work it did not do.
        if root.removable && item.state != "started" : Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            y: (parent.height - self.height) / 2;
            background: transparent;
            ta := TouchArea {
                clicked => { root.remove-entry(item.id); }
            }
            states [
                h when ta.has-hover : { background: Palette.surface-2; in { animate background { duration: Motion.quick; } } }
            ]
            Icon {
                kind: "close";
                size: 11px;
                color: Palette.text-faint;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// PlanRow — one saved day shape, with the two things you can do to it.
//
// Apply is the primary action and sits on the row itself: a plan exists to be
// used, and putting "apply" behind a menu would make the list a museum. Delete
// is the smaller, dimmer control, because a plan is cheap to write again and a
// mistimed apply is not cheap to undo.
// ───────────────────────────────────────────────────────────────────────────
component PlanRow inherits Rectangle {
    in property <PlanItem> item;
    in property <bool> last: false;
    in property <string> apply-label: "";
    callback apply-plan(int);
    callback delete-plan(int);

    height: 42px;

    Rectangle {
        width: parent.width;
        height: 1px;
        y: parent.height - 1px;
        background: Palette.hairline;
        visible: !root.last;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: item.name;
                font-size: Type.small;
                font-weight: 600;
                color: Palette.text;
                overflow: elide;
            }

            Text {
                text: item.summary;
                font-size: Type.caption;
                color: Palette.text-faint;
                overflow: elide;
            }
        }

        Rectangle {
            width: 62px;
            height: 26px;
            border-radius: 13px;
            y: (parent.height - self.height) / 2;
            background: Palette.accent-soft;
            border-width: 1px;
            border-color: Palette.accent;
            ta-apply := TouchArea {
                clicked => { root.apply-plan(item.id); }
            }
            states [
                h when ta-apply.has-hover : { background: Palette.accent; }
            ]
            Text {
                text: root.apply-label;
                font-size: Type.caption;
                font-weight: 600;
                color: ta-apply.has-hover ? Palette.on-accent : Palette.accent;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        // Delete: a bare glyphed target, not a labelled button. Two labelled
        // controls on one row would compete, and the destructive one should
        // never be the easier thing to hit.
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            y: (parent.height - self.height) / 2;
            background: transparent;
            ta-del := TouchArea {
                clicked => { root.delete-plan(item.id); }
            }
            states [
                h when ta-del.has-hover : { background: Palette.surface-2; }
            ]
            Icon {
                kind: "close";
                size: 11px;
                color: Palette.text-faint;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// TaskRow — a single line with a check circle.
// ───────────────────────────────────────────────────────────────────────────
component TaskRow inherits Rectangle {
    in property <TaskItem> item;
    in property <bool> last: false;
    callback toggle(int);

    height: 42px;

    Rectangle {
        width: parent.width;
        height: 1px;
        y: parent.height - 1px;
        background: Palette.hairline;
        visible: !root.last;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 11px;
        alignment: start;

        // The checkbox. Completing a task is the one moment in the list that
        // deserves a flourish, so the ring scales up a touch and settles as
        // the check appears. It is a transform, not a size change, so nothing
        // around it reflows — the row stays exactly as tall as it was.
        Rectangle {
            width: 19px;
            height: 19px;
            border-radius: 9.5px;
            border-width: 1.5px;
            border-color: item.done ? Palette.accent : Palette.surface-3;
            background: item.done ? Palette.accent : transparent;
            y: (parent.height - self.height) / 2;
            transform-scale: item.done ? 1.0 : 0.92;
            animate transform-scale { duration: Motion.normal; easing: ease-out-back; }
            animate background { duration: Motion.normal; }
            animate border-color { duration: Motion.normal; }

            if item.done : Icon {
                kind: "check";
                size: 11px;
                color: Palette.on-accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            TouchArea { clicked => { root.toggle(item.id); } }
        }

        // Done tasks dim rather than vanish, and the dimming is animated so
        // ticking a box reads as the row settling back instead of blinking.
        //
        // `vertical-alignment: center` is not optional here: a Text given the
        // full row height lays its glyphs out from the top, which left every
        // title floating well above the checkbox it belongs to. Centering the
        // text box is what actually lines the two up.
        Text {
            text: item.title;
            font-size: Type.body;
            color: item.done ? Palette.text-faint : Palette.text;
            overflow: elide;
            horizontal-stretch: 1;
            height: parent.height;
            vertical-alignment: center;
            animate color { duration: Motion.normal; }
        }

        Text {
            text: item.time;
            font-size: Type.small;
            color: Palette.text-faint;
            visible: item.time != "";
            height: parent.height;
            vertical-alignment: center;
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// MonthGrid — the Jalali month as weeks of seven, Saturday first.
//
// This is what makes the task list a calendar rather than a list: a day with
// open work carries a dot, and clicking a square shows that day's tasks. The
// grid is a list of weeks of seven (Slint's GridLayout has no explicit column
// count), and the leading blanks come from Rust as cells with day == 0, so the
// 1st always lands under the right weekday.
// ───────────────────────────────────────────────────────────────────────────
component MonthGrid inherits Rectangle {
    in property <[DayRow]> rows: [];
    callback picked(string);

    height: rows.length * 34px;
    background: transparent;

    VerticalLayout {
        spacing: 2px;

        for r in root.rows : HorizontalLayout {
            height: 32px;
            spacing: 2px;

            for c in r.cells : Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 9px;
                // A day square is a button. The dot says "work here" visually;
                // the label says it in words, which is the only way a screen
                // reader can report it at all.
                accessible-role: button;
                accessible-label: c.day == 0
                    ? ""
                    : (c.label + (c.has-tasks ? ", " + c.open-count : ""));
                background: c.day == 0
                    ? transparent
                    : (c.selected ? Palette.accent : (c.is-today ? Palette.accent-soft : transparent));
                border-width: c.is-today && !c.selected ? 1px : 0px;
                border-color: Palette.accent;

                animate background { duration: Motion.quick; }

                if c.day != 0 : Text {
                    text: c.label;
                    font-family: "Vazirmatn";
                    font-size: Type.small;
                    font-weight: c.is-today || c.selected ? 700 : 400;
                    color: c.selected ? Palette.on-accent : (c.is-today ? Palette.accent : Palette.text);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // The dot: this day has open work. A dot rather than a number,
                // so a full month still reads at a glance.
                if c.has-tasks : Rectangle {
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 7px;
                    background: c.selected ? Palette.on-accent : Palette.accent;
                }

                if c.day != 0 : TouchArea {
                    clicked => { root.picked(c.key); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
// SectionLabel — small caps group heading.
// ───────────────────────────────────────────────────────────────────────────
component SectionLabel {
    in property <string> text: "";
    // Breathing room above each section heading.
    //
    // The settings list uses one uniform 8px spacing, so a heading sat the same
    // distance from the card above it as the rows inside a card sit from each
    // other — the sections read as one undifferentiated stack. The gap belongs
    // to the heading, not to the list, so it is added here once instead of at
    // twelve call sites.
    in property <length> top: 10px;
    height: 20px + self.top;
    Text {
        text: root.text;
        y: root.top;
        height: 20px;
        font-size: Type.caption;
        font-weight: 700;
        // Tracking only in Latin. Persian is a connected script: spacing the
        // letters apart breaks the joins and reads as a rendering fault.
        letter-spacing: Strings.fa ? 0px : Type.tracking;
        color: Palette.text-faint;
        vertical-alignment: center;
    }
}

// ───────────────────────────────────────────────────────────────────────────
// Card — grouped container for settings rows.
// ───────────────────────────────────────────────────────────────────────────
component Card inherits Rectangle {
    in property <length> pad: 0px;
    // Cards float above the page now: a corner from the Radius scale, a real
    // shadow, and a sheen across the fill. The hairline stays, but at a lower
    // contrast, because the shadow is doing the separating work now — keeping
    // both at full strength double-outlined every card.
    border-radius: Radius.card;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.hairline;
    drop-shadow-blur: Elev.card-blur;
    drop-shadow-offset-y: Elev.card-y;
    drop-shadow-color: Elev.card-shadow;
    // Size to the content. Every settings card used to carry a hand-measured
    // pixel height, so adding a row silently clipped the card and the number
    // went stale the moment a label wrapped. A card that measures itself
    // cannot be wrong, and it is what lets the whole screen reflow when the
    // window changes size.
    height: self.preferred-height;
    // Fill the column. Without this a Card sizes to its own preferred width,
    // which is the width of its widest row — so the settings cards came out
    // 260px wide inside a 384px column and every one of them stopped short of
    // the right gutter. The sheen overlay below has no preferred width of its
    // own, so nothing was pulling the card out to full width either.
    horizontal-stretch: 1;

    // The sheen sits on top of the fill and is pinned to the card's own
    // top and bottom edges, so it never affects the height the card measures.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        border-radius: Radius.card;
        background: Elev.sheen;
    }

    @children
}

// ═══════════════════════════════════════════════════════════════════════════
// The window
// ═══════════════════════════════════════════════════════════════════════════
// ───────────────────────────────────────────────────────────────────────────
// EraPicker — four dynasty cards, each showing that era's emblem and colour.
// Selecting one repaints the entire app through the Palette global.
// ───────────────────────────────────────────────────────────────────────────
component EraCard inherits Rectangle {
    in property <string> era-id: "cyrus"; in property <string> name: "Cyrus"; in property <string> blurb: "Achaemenid gold on lapis"; in property <brush> swatch: #D6A84E; in property <bool> active: false; callback picked(); height: 88px; border-radius: Radius.card; background: active ? Palette.accent-soft : Palette.surface-2; border-width: active ? 1.5px : 1px; border-color: active ? Palette.accent : Palette.hairline; ta := TouchArea {
        clicked => { root.picked(); }
        mouse-cursor: pointer; }

    VerticalLayout {
        padding-left: 10px; padding-right: 10px; padding-top: 9px; padding-bottom: 9px; spacing: 4px; // emblem row
        Rectangle {
            height: 26px; background: transparent;
            if root.era-id == "cyrus" : Shahbaz {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }
            if root.era-id == "darius" : Faravahar {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }
            if root.era-id == "parthian" : Derafsh {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }
            if root.era-id == "sasanid" : Senmurv {
                width: 26px; height: 26px; color: root.swatch; x: 0px; y: 0px; }

            // active check
            if root.active : Rectangle {
                width: 14px; height: 14px; border-radius: 7px; background: Palette.accent; x: parent.width - self.width; y: (parent.height - self.height) / 2; Icon {
                    kind: "check"; size: 9px; color: Palette.on-accent; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }

        Text {
            text: root.name; font-size: Type.small; font-weight: 600; color: active ? Palette.accent : Palette.text; overflow: elide; }
        Text {
            text: root.blurb; font-size: Type.caption; color: Palette.text-faint; overflow: elide; }
    }
}


// ───────────────────────────────────────────────────────────────────────────
// DynastyRow — one reign in the chronicle.
//
// The row is built as a table, not prose: name and span on the ruling line,
// then capital, notable figure and legacy stacked beneath. A vertical rule on
// the leading edge ties the rows into one continuous line, which is the whole
// point of the view — the dynasties are a sequence, not a list.
// ───────────────────────────────────────────────────────────────────────────
// One reign, as data. A struct rather than a component so the list can be a
// model built in Rust: the facts then live in one place and follow the UI
// language without being duplicated in the markup.
export struct Dynasty {
    name: string,
    span: string,
    capital: string,
    figure: string,
    legacy: string,
}

component DynastyRow inherits Rectangle {
    in property <string> name: "";
    in property <string> span: "";
    in property <string> capital: "";
    in property <string> figure: "";
    in property <string> legacy: "";
    in property <string> capital-label: "";
    in property <string> figure-label: "";
    in property <string> legacy-label: "";
    in property <bool> first: false;
    in property <bool> last: false;
    in property <int> index: 0;

    // Entrance: each row fades and lifts into place, staggered by its index so
    // the chronicle assembles top-down instead of appearing all at once.
    in-out property <float> reveal: 0;
    animate reveal { duration: 420ms; easing: ease-out; delay: root.index * 55ms; }

    height: row-col.preferred-height + 26px;
    border-radius: Radius.card;
    background: row-ta.has-hover ? Palette.surface-2 : transparent;

    row-ta := TouchArea { }

    states [
        hover when row-ta.has-hover : {
            background: Palette.surface-2;
            in { animate background { duration: Motion.quick; } }
        }
    ]

    // The spine: a hairline running the full height, broken at the first and
    // last rows so the sequence has a clear beginning and end.
    Rectangle {
        x: 13px;
        y: root.first ? 18px : 0px;
        width: 1px;
        height: root.first
            ? parent.height - 18px
            : root.last
            ? 18px
            : parent.height;
        background: Palette.hairline;
    }

    // The node: a small diamond on the spine, gilded. Diamonds rather than
    // dots because the Achaemenid window motif is a diamond.
    Rectangle {
        x: 9px;
        y: 15px;
        width: 9px;
        height: 9px;
        background: Palette.accent;
        opacity: 0.85;
    }

    row-col := VerticalLayout {
        x: 34px;
        width: parent.width - 34px - 10px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 3px;
        opacity: root.reveal;
        y: (1 - root.reveal) * 10px;

        // Ruling line: name, then the span pushed to the far edge.
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.name;
                font-family: "Vazirmatn";
                font-size: Type.body;
                font-weight: 700;
                color: Palette.text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.span;
                font-family: "Vazirmatn";
                font-size: Type.caption;
                color: Palette.accent;
                vertical-alignment: center;
            }
        }

        // Capital and figure share a line: two short facts, side by side.
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.capital-label + " ";
                font-family: "Vazirmatn";
                font-size: Type.caption;
                color: Palette.text-faint;
                vertical-alignment: center;
            }
            Text {
                text: root.capital;
                font-family: "Vazirmatn";
                font-size: Type.caption;
                color: Palette.text-dim;
                vertical-alignment: center;
            }
            Rectangle { width: 8px; }
            Text {
                text: root.figure-label + " ";
                font-family: "Vazirmatn";
                font-size: Type.caption;
                color: Palette.text-faint;
                vertical-alignment: center;
            }
            Text {
                text: root.figure;
                font-family: "Vazirmatn";
                font-size: Type.caption;
                color: Palette.text-dim;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // Legacy: the one sentence that says why the reign mattered.
        Text {
            text: root.legacy;
            font-family: "Vazirmatn";
            font-size: Type.caption;
            color: Palette.text-faint;
            wrap: word-wrap;
            line-height-factor: 1.55;
        }
    }
}


// ───────────────────────────────────────────────────────────────────────────
// Dynasties — the chronicle's data, in one place.
//
// Kept as a global rather than inlined in the view so the order and the facts
// can be read at a glance, and so a future "jump to dynasty" control has
// something to index into. Every entry is pre-Islamic or later Iranian rule; // the list is deliberately continuous, because that continuity is the point.
// ───────────────────────────────────────────────────────────────────────────
export component PanganWindow inherits Window {
    // ---- Live timer state (pushed from Rust each tick) ----
    in property <string> time-left; in property <int> time-minutes; in property <int> time-seconds; in property <string> session-name; in property <float> progress; in property <string> phase; in property <bool> running; in property <int> work-done; in property <string> session-counter; // ---- Theme ----
    in property <string> theme-label: "سامانه"; in property <string> resolved-theme: "dark"; in-out property <string> theme-pref: "system"; // Heritage era identity
in property <string> era: "cyrus"; in property <string> era-label: "کوروش"; in property <string> era-blurb: "زر آخامنشی بر لاجورد";

    // ---- Today (Persian calendar) ----
    in property <string> cal-date: "";        // "۱۲ آبان ۱۴۰۵"
    in property <string> cal-weekday: "";     // "چهارشنبه"
    in property <string> cal-day-name: "";    // "خور" — the Sasanian day-name
    in property <string> cal-day-index: "";   // "روز یازدهم ماه"
    in property <string> cal-feast: "";       // "مهرگان" or empty
    in property <string> cal-feast-note: "";  // one-line gloss under the name
    in property <string> cal-month-progress: ""; // "روز ۱۲ از ۳۰"
    in property <[CalEvent]> cal-events: [];
    in property <[CalEvent]> cal-world: [];
    in-out property <bool> cal-world-open: false;
    in-out property <string> refresh-status: "";
    in property <string> cal-empty: "برای این روز رویدادی ثبت نشده است."; // ---- Reports / status / sync / task input ----
    in property <string> status-line; in property <string> report-text; in property <string> sync-status;
    // ---- Google account sync ----
    in property <bool> sync-signed-in: false;
    in property <string> sync-account: "";
    in property <bool> sync-auto-on: false;
    in property <string> sync-device-code: "";
    in property <string> sync-device-url: "https://www.google.com/device";
    in property <bool> sync-waiting: false;
    in property <bool> sync-available: true;
    // What this device is, and what the last sync actually moved. The status
    // line alone says "synced"; these say *what* synced and *from where*, which
    // is what a user needs when a setting changed on its own.
    in property <string> sync-device-name: "";
    in property <string> sync-detail: "";
    in-out property <string> sync-client-id: ""; in-out property <bool> code-copied: false;
    // The chronicle rows, built in Rust so the facts live in one place and
    // follow the UI language.
    in property <[Dynasty]> dynasties;
    in-out property <string> new-task-text;
    // The automation card's own field.
    //
    // It used to bind straight to `new-task-text`, the same property the two
    // task quick-add fields use. Typing a routine command therefore leaked into
    // the task box on the main screen — press Add Task there afterwards and the
    // command was added as a task. Clearing the task field on either screen also
    // wiped a half-typed command.
    in-out property <string> new-automation-text; in-out property <string> show-view: "main"; // ---- Settings (edited in the Settings screen) ----
    in-out property <int> work-minutes: 25; in-out property <int> short-break-minutes: 5; in-out property <int> long-break-minutes: 15; in-out property <int> long-break-interval: 4; in-out property <int> daily-goal-minutes: 120; in-out property <bool> auto-start-next: true; in-out property <bool> auto-start-on-launch: false; in-out property <bool> sound-enabled: true; in-out property <string> sound-theme: "santur"; in-out property <bool> hotkey-enabled: true; in-out property <bool> inhibit-enabled: true; in-out property <bool> overlay-enabled: true; in-out property <bool> compact-mode: false; in-out property <bool> animations: true; in-out property <int> sound-volume: 80; in property <string> automation-summary; // ---- Rich data (pushed from Rust) ----
    in property <[TaskItem]> tasks: []; in property <[DayRow]> month-rows: []; in property <[TaskItem]> day-tasks: []; in property <string> month-title: ""; in property <string> selected-day-title: ""; in property <string> selected-day-sub: ""; in property <bool> selected-is-today: false; in-out property <string> cal-selected: "";
    // Which task row is open for renaming (its id), or 0 for none. Only one row
    // can be edited at a time, so this is a single id rather than a set.
    in-out property <int> editing: 0;
    // The day navigator on the timer screen: the headline date, a subline with
    // the day-name and how much work sits on it, and whether it is today.
    in property <string> day-headline: "";
    in property <string> day-subline: "";
    in property <bool> day-is-today: true;
    in-out property <string> edit-text: "";
    in property <[float]> week-bars: [0, 0, 0, 0, 0, 0, 0]; in property <[string]> week-labels: ["ش", "ی", "د", "س", "چ", "پ", "ج"]; in property <int> week-current: -1; in property <int> today-sessions: 0; in property <int> today-minutes: 0; in property <int> today-score: 0; in property <int> today-streak: 0; in property <int> today-consistency: 0; in property <int> today-best: 0; in property <int> session-total: 4; in property <int> session-done: 0; in property <int> goal-minutes: 120; in property <int> goal-done-minutes: 0;

    // ---- The Stats screen ----
    //
    // Every figure here is computed in Rust and pushed in; the screen never
    // derives a number of its own. `report-period-index` is the selected shape
    // (0 day, 1 week, 2 month, 3 year, 4 all) and `report-offset` is how many
    // periods back it is looking — 0 is the current one, −1 the previous.
    in property <int> report-period-index: 1;
    in property <int> report-offset: 0;
    in property <string> report-title: "";
    in property <string> report-span: "";
    in property <string> report-narrative: "";
    in property <int> report-score: 0;
    in property <int> report-prev-score: 0;
    in property <int> report-minutes: 0;
    in property <int> report-sessions: 0;
    in property <int> report-avg: 0;
    in property <int> report-active-days: 0;
    in property <int> report-days: 0;
    in property <int> report-consistency: 0;
    in property <int> report-best: 0;
    in property <string> report-best-label: "";
    in property <string> report-honest-hour: "";
    in property <string> report-honest-gap: "";
    in property <int> report-streak: 0;
    in property <int> report-longest: 0;
    in property <int> report-prev-minutes: 0;
    in property <int> report-delta: 0;
    in property <bool> report-has-prev: false;
    in property <bool> report-empty: true;

    // ---- the reckoning: what the written record adds up to ----
    //
    // The journal was write-only: a decree in, an inscription out, both then
    // filed away. These properties are the read-back. They are pushed from Rust
    // with the same span the rest of the report uses, so the reckoning cannot
    // disagree with the numbers above it about where a week starts.
    in property <int> reck-spoken: 0;
    in property <int> reck-answered: 0;
    in property <int> reck-written: 0;
    in property <int> reck-unanswered: 0;
    /// Blocks that produced words with no promise in front of them.
    in property <int> reck-unspoken: 0;
    in property <[UnfulfilledItem]> reck-unfulfilled: [];
    /// How many there were in total, of which the list names a few.
    in property <int> reck-unfulfilled-total: 0;
    in property <[ThemeItem]> reck-themes: [];
    /// A one-line verdict on the span, built in Rust where the digits are.
    in property <string> reck-summary: "";
    // ── the same span's blocks, judged ────────────────────────────────────
    //
    // The counts above say what was written. These say what the writing was
    // *worth*, in the only judgement that is not the app's to make. Kept
    // separate from the decree/inscription counts on purpose: those measure
    // whether words exist, and a block can have its words and still have been
    // abandoned. Merging the two would hide exactly the gap the user came to
    // the report to see.
    in property <int> verdict-kept: 0;
    in property <int> verdict-partial: 0;
    in property <int> verdict-broken: 0;
    in property <int> verdict-extended: 0;
    in property <int> verdict-short: 0;
    /// How many of the judged blocks the user actually judged, and how many
    /// the app inferred. Stated as a ratio so the confidence is visible.
    in property <int> verdict-declared: 0;
    in property <int> verdict-total: 0;
    /// Blocks that met what they were for — kept, or outgrew their decree.
    /// The one number in this card that is a summary rather than a count, so
    /// it is shown as a sentence, not as a sixth chip.
    in property <int> verdict-met: 0;
    /// True when there is nothing to judge in this span.
    in property <bool> verdict-empty: true;
    in property <bool> reck-empty: true;
    in property <[float]> chart-bars: [];
    in property <[string]> chart-labels: [];
    in property <[string]> chart-details: [];
    in property <int> chart-current: -1;
    in property <int> chart-future-from: 999;
    in property <[float]> hour-bars: [];
    in property <bool> has-hour-profile: false;

    // ---- The inscription (what this session actually produced) ----
    //
    // A finished focus block drains into the store, and the dialog opens with
    // the session's timestamp. `inscription-session` is what ties the typed
    // line to the right session: it is set from Rust at open time, and the
    // callback sends it back, so a second session finishing while the dialog is
    // up cannot have its line written onto the first one.
    in-out property <bool> inscription-open: false;
    in-out property <string> inscription-text: "";
    in property <string> inscription-prompt: "";
    in property <string> inscription-placeholder: "";
    in property <int> inscription-limit: 280;
    in property <string> inscription-error: "";
    /// "12 / 280" — built in Rust because this Slint version has no string length.
    in property <string> inscription-count: "";
    /// True when the field holds something other than whitespace.
    in property <bool> can-inscribe: false;
    in-out property <string> inscription-search: "";
    in property <[InscriptionItem]> inscriptions: [];
    in property <string> archive-empty: "";
    /// "N of your sessions began with a stated intention", "" when none have.
    /// The proportion the pair exists to make visible.
    in property <string> archive-decree-count: "";
    /// The session the open dialog belongs to (Unix seconds, 0 = none).
    in property <int> inscription-session: 0;
    /// The storage key of the verdict already declared for that session ("kept",
    /// "partial", …), "" when none. Pushed from Rust so the quick-judge row can
    /// show which seal is already filled.
    in property <string> inscription-verdict-kind: "";
    /// Set by Rust when the last write succeeded, so the dialog can close.
    in-out property <bool> inscription-saved: false;

    // ---- The decree (what this session is for) ----
    //
    // Asked *before* the block, not after. The dialog appears when the user
    // starts a focus session from a paused state — the only moment the app knows
    // a block is about to begin and the user is still at the keyboard. A block
    // started from the tray or a hotkey simply begins without one, because
    // interrupting an already-started countdown to ask a question is worse than
    // an unwritten intention.
    in-out property <bool> decree-open: false;
    in-out property <string> decree-text: "";
    in property <string> decree-prompt: "";
    in property <string> decree-placeholder: "";
    in property <int> decree-limit: 120;
    in property <string> decree-error: "";
    in property <string> decree-count: "";
    in property <bool> can-issue: false;
    /// The intention currently governing the running block, "" when none.
    /// Pushed from Rust so the 300 ms tick never has to reach into the store.
    in property <string> current-decree: "";
    /// The coaching line: the active prescription if one is live, else the
    /// current season's live intention. "" when neither exists. Pushed from
    /// Rust like current-decree, and rendered as a quiet line under the block's
    /// decree so the coaching never competes with the ring.
    in property <string> coach-line: "";

    // ---- The day's rota ----
    //
    // The blocks this day is meant to hold, in the order they were planned.
    // `rota` feeds the card on the main screen; `rota-next-enabled` gates the
    // Start Next button, which is disabled rather than hidden so the layout
    // does not jump when the last block is taken up.
    in property <[RotaItem]> rota: [];
    in property <bool> rota-next-enabled: false;
    /// The label of the block Start Next will take, shown on the button so the
    /// press is informed rather than a leap.
    in property <string> rota-next-label: "";
    /// "3 of 5 of the plan left" — built in Rust, where the Persian digits are.
    in property <string> rota-remaining: "";
    /// Summed height of the rota rows, pushed from Rust.
    ///
    /// A Flickable's `content-height` must not be derived from its own child —
    /// that is a binding loop — and the rows are 40 or 54 px depending on
    /// whether they carry a decree, so the sum belongs where that is known.
    in property <length> rota-list-height: 0px;
    /// Unstarted blocks planned for earlier days, offered back explicitly.
    /// Carrying work forward is the user's decision, never automatic.
    in property <int> rota-carry-count: 0;
    in property <string> rota-carry-label: "";
    in-out property <string> rota-new-label: "";
    in-out property <int> rota-new-minutes: 25;
    in property <bool> rota-can-add: false;
    /// What the day's plans came to: "۲ انجام · ۱ رهاشده · ۲ مانده".
    ///
    /// Built in Rust because the digits are Persian and Slint cannot
    /// interpolate. Empty on a day with no plans, and `rota-tally-visible`
    /// carries the same fact as a bool so the `if` above needs no inversion.
    in property <string> rota-tally-label: "";
    in property <bool> rota-tally-visible: false;

    // ---- Saved plans ----
    //
    // A day shape kept and re-applied. Lives under the rota card on the main
    // screen rather than behind settings, because a plan is used *while
    // planning the day* — one screen, one moment, one decision.
    in property <[PlanItem]> plans: [];
    /// Summed height of the plan rows, pushed from Rust (a Flickable's
    /// content-height must not be derived from its own child).
    in property <length> plans-list-height: 0px;
    in-out property <string> plan-name: "";
    in property <bool> plan-can-save: false;
    /// Whether today's rota has anything on it to save at all.
    in property <bool> plan-save-visible: false;
    /// The refusal reason from the last save/apply, "" when there was none.
    /// Shown in the card rather than as a dialog: nothing was lost, and a modal
    /// for "the day is too full" would be louder than the fact.
    in property <string> plan-error: "";

    // ---- Callbacks to Rust ----
    callback start-pause; callback skip; callback reset; callback open-report; callback close-report; callback open-today; callback close-today; callback open-chronicle; callback close-chronicle; callback copy-code(string); callback open-settings; callback close-settings; callback cycle-theme; callback toggle-sound; callback preview-sound; callback sync-now; callback sync-connect; callback sync-disconnect; callback set-client-id(string); callback set-sync-auto(bool); callback add-task; callback backup-now; callback restore-now; callback add-automation(string, string); callback toggle-task(int); callback set-theme(string); callback set-era(string); callback set-lang(string); callback refresh-events; callback open-url(string); callback window-drag-start; callback set-compact-mode(bool); callback set-animations(bool); callback pick-day(string); callback shift-month(int); callback goto-today; callback add-task-on(string); callback delete-task(int); callback rename-task(int, string); callback move-task(int, int); callback step-day(int); callback set-report-period(int); callback step-report(int); callback report-today;
    // ---- Inscription callbacks ----
    callback inscribe(int, string);
    callback skip-inscription(int);
    callback dismiss-inscription;
    callback delete-inscription(string);
    /// The user judged a block: (session seconds, the kind's storage key).
    ///
    /// The kind travels as its stable string rather than an enum, because the
    /// storage form is the one identity that survives a rename of the UI copy
    /// and a round-trip through `data.json`.
    callback declare-verdict(int, string);
    callback search-inscriptions(string);
    callback inscription-text-changed(string);
    callback open-inscriptions;
    callback close-inscriptions;
    callback export-inscriptions;
    callback copy-inscriptions;
    // ---- Decree callbacks ----
    /// The user stated an intention and pressed Issue. Rust starts the block.
    callback issue-decree(string);
    /// The user chose to start without one. Rust starts the block anyway.
    callback skip-decree;
    /// Dismissed without starting — the countdown stays paused.
    callback dismiss-decree;
    /// The field's text, so Rust can decide whether Issue is enabled.
    callback decree-text-changed(string);
    // ---- Rota callbacks ----
    /// Plan a block: label, length in minutes, and the decree it opens with.
    callback add-rota-entry(string, int, string);
    /// Start the next planned block (marks it taken up and seeds the session).
    callback start-rota-next;
    /// Start one specific entry, by id.
    callback start-rota-entry(int);
    /// Take an entry off the rota.
    callback remove-rota-entry(int);
    /// The label field's text, so Rust can enable/disable Add.
    callback rota-label-changed(string);
    /// Re-plan one stale entry onto today, by id.
    callback carry-rota-entry(int);
    /// Re-plan every stale entry onto today at once.
    callback carry-rota-entries;
    // ---- Saved-plan callbacks ----
    /// Save today's rota under the typed name.
    callback save-plan(string);
    /// Write a saved plan's blocks onto today.
    callback apply-plan(int);
    /// Take a saved plan off the list.
    callback delete-plan(int);
    /// The name field's text, so Rust can enable/disable Save.
    callback plan-name-changed(string);
    // Resize: the edge/corner grab zones report the pointer's screen position
    // and which edge is being dragged; Rust turns that into a new window size.

    // Frameless drag: window position that keeps the pointer over the grab point.
    out property <length> drag-origin-x: self.absolute-position.x - root.drag-start-x;
    out property <length> drag-origin-y: self.absolute-position.y - root.drag-start-y;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;

    // Breathing phase for the ring's halo, 0..1. Advanced by a timer only
    // while a session is running and motion is enabled, so an idle window
    // costs nothing. A full breath is about 5.5s: slow enough to read as
    // breathing rather than blinking, which is the point of it.
    in-out property <float> pulse-phase: 0; timer := Timer {
        interval: 60ms; running: root.running && Motion.enabled; triggered => {
            root.pulse-phase = Math.mod(root.pulse-phase + 0.011, 1.0); }
    }

    // ── view transition ──────────────────────────────────────────────────
    // Navigating between screens fades the incoming view up and lifts it a
    // few pixels, so a switch reads as a change of place rather than a hard
    // cut. `view-enter` runs 0 → 1 over ~260ms; every screen binds its own
    // opacity and offset to it, which keeps the whole thing to one animated
    // property instead of one per screen.
    in-out property <float> view-enter: 1;
    // With motion off the transition never runs, so the screens must not be
    // left transparent: both derived properties fall back to the settled
    // state when `Motion.enabled` is false.
    // `view-enter` is the animation progress. It must be a real 0 -> 1 ramp
    // even when motion is off, because *opacity* is bound to it too: leaving it
    // at 0 with Motion disabled made every screen after the first fully
    // transparent and therefore invisible. Motion only shortens the ramp, it
    // never skips it.
    animate view-enter { duration: Motion.enabled ? Motion.normal : 1ms; }
    private property <float> view-opacity: root.view-enter;
    // With motion off the view must sit exactly where it belongs. `enter-rise`
    // is 0 in that case, so the offset is 0 whatever `view-enter` holds — but
    // the offset is also *frozen* at whatever it was when motion was switched
    // off, because the timer below stops running. Binding it to the settled
    // state when motion is off is what makes the screen actually appear.
    private property <length> view-offset: Motion.enter-rise * (1 - root.view-enter);
    changed show-view => {
        // Only start the entrance when there is an entrance to run. Leaving
        // `view-enter` at 0 with motion off left the incoming screen offset by
        // a full `enter-rise` and never advanced it, so every screen after the
        // first rendered shifted down and clipped — the settings panel looked
        // blank.
        root.view-enter = 0;
    }
    enter-timer := Timer {
        interval: 16ms;
        running: root.view-enter < 1;
        triggered => {
            root.view-enter = Math.min(1, root.view-enter + 0.062);
        }
    }


    title: "Pangan";
    // A real window frame, not a frameless one.
    //
    // The app used to be `no-frame: true` and drew its own chrome, which meant
    // the window manager gave it no resize border at all — that is why the
    // window could not be resized. Hand-rolled edge grab zones were fragile
    // (the release event is lost as soon as the window shrinks out from under
    // the pointer). Letting the platform own the frame gives real, reliable
    // resizing on every desktop, the way a normal app behaves.
    no-frame: false;
    // No width/height binding here on purpose.
    //
    // A binding like `width: 420px` makes Slint re-apply that size on every
    // resize, so the window manager's resize is immediately undone — which is
    // exactly why the window could not be resized. The initial size is set
    // once from Rust instead, leaving the WM free to resize afterwards.
    min-width: 340px; min-height: 400px; background: Palette.bg; 
    // Vazirmatn is the Persian face the whole app is set in; Inter carries
    // the Latin side. Both are named so the platform picks the right one per
    // script instead of falling back to a system default that mangles Persian.
    default-font-family: Strings.fa ? "Vazirmatn" : "Inter";

    // ─────────────────────────────────────────────────────────────────────
    // Heritage texture
    //
    // This used to be a 6×9 tiling of the era emblem across the whole window,
    // including behind the header. At that density it stopped reading as paper
    // grain and started competing with the wordmark and the controls, which is
    // exactly what made the top of the window feel cluttered.
    //
    // It is now a single large watermark, centred in the body and kept well
    // below the header, so the emblem is present as a quiet ground without
    // ever sitting behind text. One mark at low opacity reads as intent; a
    // grid of them reads as noise.
    // ─────────────────────────────────────────────────────────────────────
    Rectangle {
        y: 56px;
        width: root.width;
        height: root.height - 56px;
        background: transparent;
        clip: true;

        // The page's light. A single wide radial wash, centred on the hero,
        // sitting above the flat background and below every control. It is the
        // cheapest way to stop a large empty area reading as a void: the eye
        // reads a lit room rather than a coloured rectangle.
        Rectangle {
            width: Math.max(parent.width * 1.5, 520px);
            height: self.width;
            x: (parent.width - self.width) / 2;
            // Centred on the ring, which sits just under the header.
            y: (parent.height - self.height) / 2 - 40px;
            border-radius: self.width / 2;
            background: Elev.page-light;
        }

        // The watermark is deliberately oversized and offset so its edges fall
        // outside the body and it reads as a cropped detail rather than a
        // centred logo. Pushed well down the body so it never crowds the
        // header above it.
        Rectangle {
            width: root.width * 1.15;
            height: root.width * 1.15;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + 64px;
            background: transparent;

            if root.era == "cyrus" : Shahbaz {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
            if root.era == "darius" : Faravahar {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
            if root.era == "parthian" : Derafsh {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
            if root.era == "sasanid" : Senmurv {
                width: 100%; height: 100%; color: Palette.accent;
                fade: root.resolved-theme == "light" ? 0.045 : 0.035; }
        }
    }
  // ─────────────────────────────────────────────────────────────────────
    // Header — draggable, minimal. Title left, controls right.
    // ─────────────────────────────────────────────────────────────────────
    Rectangle {
        height: 56px; y: 0px; background: transparent; // drag handle covering the header, behind the buttons
        TouchArea {
            width: parent.width - 130px;
            height: parent.height;
            mouse-cursor: move;

            moved => {
                if (self.pressed) {
                    if (root.drag-start-x == 0px && root.drag-start-y == 0px) {
                        root.drag-start-x = self.mouse-x;
                        root.drag-start-y = self.mouse-y;
                    }
                    root.window-drag-start();
                }
            }

            // remember where inside the header the drag began
            init => {
                root.drag-start-x = 0px;
                root.drag-start-y = 0px;
            }
        }

        HorizontalLayout {
            padding-left: Space.gutter; padding-right: Space.gutter; spacing: 8px; alignment: space-between; // wordmark
            HorizontalLayout {
                spacing: 9px;
                alignment: start;

                // The mark: the active era's authentic emblem.
                Rectangle {
                    width: 30px; height: 30px; y: (parent.height - self.height) / 2; background: transparent; if root.era == "cyrus" : Shahbaz { width: 30px; height: 30px; color: Palette.accent; }
                    if root.era == "darius" : Faravahar { width: 30px; height: 30px; color: Palette.accent; }
                    if root.era == "parthian" : Derafsh { width: 30px; height: 30px; color: Palette.accent; }
                    if root.era == "sasanid" : Senmurv { width: 30px; height: 30px; color: Palette.accent; }
                }

                VerticalLayout {
                    spacing: 0px;
                    alignment: center;
                    vertical-stretch: 0;
                    Text {
                        text: Strings.app-name;
                        font-size: Type.body;
                        font-weight: 600;
                        letter-spacing: Strings.fa ? 0px : Type.tracking;
                        color: Palette.text;
                        vertical-alignment: center;
                    }
                    Text {
                        text: Strings.app-tagline;
                        font-family: "Vazirmatn";
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px; alignment: end; IconButton {
                    icon: root.resolved-theme == "light" ? "moon" : "sun"; icon-size: 16px; clicked => { root.cycle-theme(); }
                }
                IconButton {
                    icon: "sliders"; icon-size: 16px; clicked => { root.open-settings(); }
                }
            }
        }

        // No ornament along the header edge.
        //
        // There used to be a decorative band here (first a stepped sawtooth,
        // then the Apadana lotus frieze). Both were wrong: the header already
        // carries the era emblem, the wordmark, the tagline and two controls,
        // and a patterned edge on top of that made the top of the window read
        // as clutter. The header is now just the mark and the controls, with
        // a single hairline to separate it from the body.
        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Palette.hairline;
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Body
    // ─────────────────────────────────────────────────────────────────────
    Rectangle {
        y: 56px; width: parent.width; height: parent.height - 56px; background: transparent;
        // ═══ COMPACT ═══
        if root.show-view == "main" && root.compact-mode : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 16px; spacing: 10px; HorizontalLayout {
                spacing: 8px; alignment: space-between; Text {
                    text: root.session-name; font-size: Type.small; font-weight: 700; color: Palette.text-faint; vertical-alignment: center; }
                Text {
                    text: root.session-counter; font-size: Type.caption; color: Palette.text-faint; vertical-alignment: center; }
            }

            Text {
                text: Digits.pad2(root.time-minutes) + ":" + Digits.pad2(root.time-seconds); font-size: 54px; font-weight: 300; letter-spacing: 0.5px; color: Palette.text; horizontal-alignment: center; }

            Rectangle {
                height: 4px; border-radius: 2px; background: Palette.track; Rectangle {
                    width: parent.width * root.progress; height: parent.height; border-radius: 2px; background: Palette.accent; animate width { duration: Motion.slow; easing: ease-out; }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                TimerButton {
                    icon: "reset";
                    size: 38px;
                    icon-size: 16px;
                    clicked => { root.reset(); }
                }

                TimerButton {
                    icon: root.running ? "pause" : "play";
                    size: 52px;
                    icon-size: 20px;
                    primary: true;
                    clicked => { root.start-pause(); }
                }

                TimerButton {
                    icon: "skip";
                    size: 38px;
                    icon-size: 16px;
                    clicked => { root.skip(); }
                }
            }
        }

        // ═══ MAIN ═══
        // The whole column scrolls when the window is short, so nothing can be
        // cut off at the bottom. The hero shrinks with the window instead of
        // holding a fixed 268px, which is what used to squeeze the task list
        // down to four pixels.
        if root.show-view == "main" && !root.compact-mode : Flickable {
            opacity: root.view-opacity;
            y: root.view-offset;
            vertical-stretch: 1;
            content-height: main-col.preferred-height;
            interactive: main-col.preferred-height > self.height;

            // No explicit height here: the Flickable measures the column's
            // preferred height itself. Setting `height: self.preferred-height`
            // on the child of a Flickable is a binding loop and collapsed the
            // whole column to a sliver.
            main-col := VerticalLayout {
            width: parent.width; padding-bottom: 14px; spacing: 0px; // view switcher
            HorizontalLayout {
                height: 40px; alignment: center; Segmented {
                    options: [Strings.nav-timer, Strings.nav-today, Strings.nav-chronicle, Strings.nav-inscriptions, Strings.nav-stats]; current: 0; selected(i) => {
                        if (i == 1) { root.open-today(); }
                        if (i == 2) { root.open-chronicle(); }
                        if (i == 3) { root.open-inscriptions(); }
                        if (i == 4) { root.open-report(); }
                    }
                }
            }

            // ---- hero: ring + time ----
            // Grows and shrinks with the window, within sane bounds.
            Rectangle {
                height: Math.max(150px, Math.min(268px, root.height - 430px));
                background: transparent;
                hero-ring := SunRing {
                    progress: root.progress;
                    d: Math.max(120px, Math.min(236px, parent.height - 32px));
                    t: 7px;
                    glow: root.running;
                    pulse: root.pulse-phase;
                    halo-alpha: Palette.dark ? 0.10 : 0.16;
                    track-color: Palette.track; fill-color: Palette.accent;
                    x: (parent.width - self.width) / 2; y: 6px; }

                VerticalLayout {
                    width: hero-ring.width * 0.85;
                    height: hero-ring.height * 0.85;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    spacing: 2px; alignment: center; Text {
                        text: root.session-name; font-size: Type.small; font-weight: 700; color: Palette.accent; horizontal-alignment: center; }
                    Text {
                        text: Digits.pad2(root.time-minutes) + ":" + Digits.pad2(root.time-seconds); font-size: Math.max(34px, Math.min(62px, hero-ring.width * 0.26)); font-weight: 300; letter-spacing: 0.5px; color: Palette.text; horizontal-alignment: center; }
                    Text {
                        text: root.phase; font-size: Type.small; color: Palette.text-dim; horizontal-alignment: center; }
                    // The day's goal, inside the ring rather than in a card of
                    // its own. It belongs to the timer — it is the same number
                    // the ring is filling towards — and a separate bar below
                    // was one more block competing with the clock.
                    Rectangle { height: 6px; }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: Math.min(hero-ring.width * 0.52, 120px);
                            height: 3px;
                            border-radius: 1.5px;
                            background: Palette.track;
                            Rectangle {
                                width: parent.width * clamp(root.goal-done-minutes / max(root.goal-minutes, 1), 0, 1);
                                height: parent.height;
                                border-radius: 1.5px;
                                background: Palette.accent;
                                animate width { duration: Motion.lazy; easing: ease-out; }
                            }
                        }
                    }
                    Text {
                        text: Digits.num(root.goal-done-minutes) + " / " + Digits.num(root.goal-minutes) + " " + Strings.minutes-short; font-size: Type.caption; color: Palette.text-faint; horizontal-alignment: center; }
                }
            }

            // ---- the decree strip ----
            // One line under the clock saying what this block is for. It sits
            // above the session dots rather than in a card because it is not a
            // statistic: it is the sentence the user is working against, and it
            // should be readable in a glance without leaving the ring.
            //
            // Collapses entirely when no decree governs the block, so a user who
            // never writes one sees the timer exactly as before.
            if root.current-decree != "" : Rectangle {
                height: 30px;
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: Radius.tile;
                background: Palette.accent-soft;
                border-width: 1px;
                border-color: Palette.accent;

                HorizontalLayout {
                    padding-left: Space.tight;
                    padding-right: Space.tight;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: Strings.dec-strip + ":";
                        font-size: Type.caption;
                        font-weight: 600;
                        color: Palette.accent;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.current-decree;
                        font-family: "Vazirmatn";
                        font-size: Type.caption;
                        color: Palette.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            // ---- the coaching line ----
            // One quiet line under the block's decree: the active prescription
            // if one is live, else the current season's live intention. It is
            // deliberately quieter than the decree strip — the coaching is
            // context, not the work — and collapses entirely when there is
            // nothing to say, like the decree strip above it.
            if root.coach-line != "" : Text {
                height: 18px;
                x: 22px;
                width: parent.width - 22px - 22px;
                text: root.coach-line;
                font-family: "Vazirmatn";
                font-size: Type.caption;
                color: Palette.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            // ---- session dots ----
            HorizontalLayout {
                height: 22px; spacing: 6px; alignment: center; for i in max(root.session-total, 1) : Rectangle {
                    width: i < root.session-done ? 18px : 6px; height: 6px; border-radius: 3px; background: i < root.session-done ? Palette.accent : Palette.surface-3; animate width { duration: Motion.normal; easing: ease-out; }
                    animate background { duration: Motion.normal; }
                }
            }

            Rectangle { height: 10px; }

            // ---- controls ----
            HorizontalLayout {
                height: 64px;
                spacing: 16px;
                alignment: center;

                TimerButton {
                    icon: "reset";
                    size: 44px;
                    icon-size: 18px;
                    clicked => { root.reset(); }
                }

                TimerButton {
                    icon: root.running ? "pause" : "play";
                    size: 64px;
                    icon-size: 24px;
                    primary: true;
                    clicked => { root.start-pause(); }
                }

                TimerButton {
                    icon: "skip";
                    size: 44px;
                    icon-size: 18px;
                    clicked => { root.skip(); }
                }
            }

            Rectangle { height: 16px; }

            // ---- Start Next ----
            // The whole point of the rota: one press begins the next planned
            // block, with its length and its decree already attached. It sits
            // directly under the transport controls because it is a way of
            // pressing play, not a separate destination.
            //
            // Disabled rather than hidden when the queue is empty, so the row
            // does not reflow — and so "there is nothing planned" reads as a
            // state of the same control rather than as a missing one.
            Rectangle {
                height: 34px;
                width: Math.min(parent.width - 60px, 320px);
                x: (parent.width - self.width) / 2;
                border-radius: 17px;
                background: root.rota-next-enabled ? Palette.accent-soft : Palette.surface-2;
                border-width: 1px;
                border-color: root.rota-next-enabled ? Palette.accent : Palette.hairline;

                ta-next := TouchArea {
                    clicked => {
                        if (root.rota-next-enabled) { root.start-rota-next(); }
                    }
                }
                states [
                    h when ta-next.has-hover && root.rota-next-enabled : {
                        background: Palette.accent;
                        in { animate background { duration: Motion.quick; } }
                    }
                ]

                HorizontalLayout {
                    alignment: center;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 7px;

                    Icon {
                        kind: "chevron";
                        size: 11px;
                        color: root.rota-next-enabled
                            ? (ta-next.has-hover ? Palette.on-accent : Palette.accent)
                            : Palette.text-faint;
                    }

                    Text {
                        // The next block's label, not a generic "Start next":
                        // the press should say what it is about to begin.
                        text: root.rota-next-enabled ? root.rota-next-label : Strings.rota-empty;
                        font-size: Type.small;
                        font-weight: 700;
                        color: root.rota-next-enabled
                            ? (ta-next.has-hover ? Palette.on-accent : Palette.accent)
                            : Palette.text-faint;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }

            Rectangle { height: 16px; }

            // ---- the day navigator ----
            // One block that says which day you are on and lets you walk to any
            // other. The date reads as a full date with the era year and a
            // "(today)" marker, the chevrons step a day at a time, and tapping
            // the date opens the month grid.
            Rectangle {
                height: 60px;
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: Radius.panel;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;
                // The date block is the one control on this screen you are
                // meant to reach for, so it gets the higher elevation rather
                // than the card level.
                drop-shadow-blur: Elev.lift-blur;
                drop-shadow-offset-y: Elev.lift-y;
                drop-shadow-color: Elev.lift-shadow;

                // The chevrons sit at the card's edges and the date block is
                // centred in what is left. Before, the date block stretched to
                // fill the gap, so its text was centred in the *gap* rather
                // than in the card, and the whole group drifted left whenever
                // the date string was short.
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px; spacing: 0px; alignment: center; DayStep {
                        clicked => { root.step-day(-1); }
                    }

                    Rectangle {
                        horizontal-stretch: 1; background: transparent; ta-day := TouchArea { clicked => { root.open-today(); } }

                        VerticalLayout {
                            alignment: center; spacing: 2px; Text {
                                text: root.day-headline; font-family: "Vazirmatn"; font-size: Type.heading; font-weight: 700; color: Palette.text; horizontal-alignment: center; overflow: elide; }

                            Text {
                                text: root.day-subline; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text-dim; horizontal-alignment: center; overflow: elide; }
                        }
                    }

                    DayStep {
                        forward: true; clicked => { root.step-day(1); }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ---- the day's rota ----
            // The blocks this day is meant to hold, in the order they were
            // planned. It sits above the task list because it is more specific
            // than a task: a task is something that needs doing, an entry here
            // is a decision about *this afternoon*.
            //
            // The card is always present, but when the day has no plan it
            // collapses to one line — a bare "plan a block" prompt — rather than
            // disappearing. A feature nobody can find is a feature nobody uses,
            // and a whole card that appears and vanishes would reflow the screen
            // under the user's pointer.
            Rectangle {
                height: root.rota.length == 0
                    ? (root.rota-carry-count > 0 ? 128px : 96px)
                    : Math.min(60px + root.rota-list-height
                        + (root.rota-carry-count > 0 ? 40px : 0px), 300px);
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: Radius.card;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;
                drop-shadow-blur: Elev.card-blur;
                drop-shadow-offset-y: Elev.card-y;
                drop-shadow-color: Elev.card-shadow;

                VerticalLayout {
                    padding: Space.pad;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 18px;
                        Text {
                            text: Strings.rota-title;
                            font-size: Type.caption;
                            font-weight: 700;
                            letter-spacing: Strings.fa ? 0px : Type.tracking;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // "2 of 5 left": the plan's remaining size, which is
                        // the number that decides whether to start another.
                        Text {
                            text: root.rota-remaining;
                            font-size: Type.caption;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                    }

                    // "2 done · 1 abandoned": what the day's plans came to.
                    // Built in Rust — the digits are Persian here — and said as
                    // a sentence rather than a score, because the point is to
                    // read back what happened, not to be graded on it.
                    //
                    // Gated on a bool pushed from Rust rather than on the string
                    // being non-empty: an inverted condition inside `if` is a
                    // Slint syntax error, and comparing strings there is how the
                    // same mistake gets written a second time.
                    if root.rota-tally-visible : Text {
                        height: 18px;
                        text: root.rota-tally-label;
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.rota.length == 0 : Text {
                        height: 26px;
                        text: Strings.rota-empty;
                        font-size: Type.small;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.rota.length > 0 : Flickable {
                        vertical-stretch: 1;
                        content-height: root.rota-list-height;
                        interactive: root.rota-list-height > self.height;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 0px;
                            for r[i] in root.rota : RotaRow {
                                item: r;
                                last: i == root.rota.length - 1;
                                start-entry(id) => { root.start-rota-entry(id); }
                                remove-entry(id) => { root.remove-rota-entry(id); }
                            }
                        }
                    }

                    // Leftovers from earlier days, offered explicitly. Never
                    // merged in silently: a list that refills itself is a list
                    // that can never be finished.
                    if root.rota-carry-count > 0 : Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: Palette.accent-soft;
                        ta-carry := TouchArea {
                            clicked => { root.carry-rota-entries(); }
                        }
                        states [
                            h when ta-carry.has-hover : { background: Palette.accent; }
                        ]
                        Text {
                            text: root.rota-carry-label;
                            font-size: Type.caption;
                            color: ta-carry.has-hover ? Palette.on-accent : Palette.accent;
                            x: 8px;
                            width: parent.width - 26px;
                            height: parent.height;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Icon {
                            kind: "chevron";
                            size: 11px;
                            color: ta-carry.has-hover ? Palette.on-accent : Palette.accent;
                            x: parent.width - 20px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Rectangle { height: 8px; }

                    // Quick add. Length and the block's opening line are set
                    // after the fact in the rota, not here: the point of this
                    // row is to get the day written down fast, and a four-field
                    // form is what stops people doing it.
                    Rectangle {
                        height: 32px;
                        border-radius: 9px;
                        background: Palette.surface-2;

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 4px;
                            spacing: 8px;

                            // Two-way binding, for the same reason the task
                            // field uses one: a one-way `text:` is broken by the
                            // first keystroke, so clearing it from Rust never
                            // reaches the field.
                            LineEdit {
                                text <=> root.rota-new-label;
                                placeholder-text: Strings.rota-add-hint;
                                font-size: Type.small;
                                horizontal-stretch: 1;
                                accepted(t) => {
                                    root.rota-new-label = t;
                                    root.add-rota-entry(root.rota-new-label, root.rota-new-minutes, "");
                                }
                                edited(t) => { root.rota-label-changed(t); }
                            }

                            // Length. A rota entry may be a block of another
                            // size than the timer's default — that is much of
                            // the point of planning ahead.
                            SpinBox {
                                value <=> root.rota-new-minutes;
                                minimum: 1;
                                maximum: 180;
                                width: 74px;
                            }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                y: (parent.height - self.height) / 2;
                                background: root.rota-can-add ? Palette.accent : Palette.surface-3;
                                ta-rota-add := TouchArea {
                                    clicked => {
                                        if (root.rota-can-add) {
                                            root.add-rota-entry(root.rota-new-label, root.rota-new-minutes, "");
                                        }
                                    }
                                }
                                states [
                                    h when ta-rota-add.has-hover && root.rota-can-add : {
                                        background: Palette.text;
                                        in { animate background { duration: Motion.quick; } }
                                    }
                                ]
                                Icon {
                                    kind: "plus";
                                    size: 12px;
                                    color: root.rota-can-add ? Palette.on-accent : Palette.text-faint;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ---- saved plans ----
            // A day shape kept for another day. Sits directly under the rota
            // because that is where it is used: you look at today's plan, then
            // decide whether to start from a shape that worked before.
            //
            // Always present, like the rota card, and for the same reason: a
            // feature that appears only when it has content is a feature the
            // user never learns exists. Empty, it is one line that says how to
            // earn a first one.
            Rectangle {
                height: root.plans.length == 0
                    ? (root.plan-save-visible ? 104px : 64px)
                    : Math.min(56px + root.plans-list-height
                        + (root.plan-save-visible ? 40px : 0px)
                        + (root.plan-error != "" ? 22px : 0px), 260px);
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: Radius.card;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;
                drop-shadow-blur: Elev.card-blur;
                drop-shadow-offset-y: Elev.card-y;
                drop-shadow-color: Elev.card-shadow;

                VerticalLayout {
                    padding: Space.pad;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 18px;
                        Text {
                            text: Strings.plans-title;
                            font-size: Type.caption;
                            font-weight: 700;
                            letter-spacing: Strings.fa ? 0px : Type.tracking;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.plans.length == 0 : Text {
                        height: 26px;
                        text: Strings.plans-empty;
                        font-size: Type.small;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.plans.length > 0 : Flickable {
                        vertical-stretch: 1;
                        content-height: root.plans-list-height;
                        interactive: root.plans-list-height > self.height;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 0px;
                            for p[i] in root.plans : PlanRow {
                                item: p;
                                last: i == root.plans.length - 1;
                                apply-label: Strings.plans-apply;
                                apply-plan(id) => { root.apply-plan(id); }
                                delete-plan(id) => { root.delete-plan(id); }
                            }
                        }
                    }

                    if root.plan-error != "" : Text {
                        height: 22px;
                        text: root.plan-error;
                        font-size: Type.caption;
                        color: Palette.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // Naming a saved shape. Sits at the bottom because it is
                    // the second half of a decision already made: you save the
                    // day you just wrote, then say what to call it.
                    if root.plan-save-visible : Rectangle {
                        height: 32px;
                        border-radius: 9px;
                        background: Palette.surface-2;

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 4px;
                            spacing: 8px;

                            LineEdit {
                                text <=> root.plan-name;
                                placeholder-text: Strings.plans-name-hint;
                                font-size: Type.small;
                                horizontal-stretch: 1;
                                accepted(t) => {
                                    root.plan-name = t;
                                    if (root.plan-can-save) { root.save-plan(root.plan-name); }
                                }
                                edited(t) => { root.plan-name-changed(t); }
                            }

                            Rectangle {
                                width: 62px;
                                height: 24px;
                                border-radius: 12px;
                                y: (parent.height - self.height) / 2;
                                background: root.plan-can-save ? Palette.accent : Palette.surface-3;
                                ta-plan-name-save := TouchArea {
                                    clicked => {
                                        if (root.plan-can-save) { root.save-plan(root.plan-name); }
                                    }
                                }
                                states [
                                    h when ta-plan-name-save.has-hover && root.plan-can-save : {
                                        background: Palette.text;
                                    }
                                ]
                                Text {
                                    text: Strings.plans-save;
                                    font-size: Type.caption;
                                    font-weight: 600;
                                    color: root.plan-can-save ? Palette.on-accent : Palette.text-faint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ---- tasks ----
            // A fixed, comfortable height: the list scrolls inside the card, so
            // the card never collapses when the window is short.
            Rectangle {
                height: 200px;
                x: 22px;
                width: parent.width - 22px - 22px;
                border-radius: Radius.card;
                background: Palette.surface;
                border-width: 1px;
                border-color: Palette.hairline;
                drop-shadow-blur: Elev.card-blur;
                drop-shadow-offset-y: Elev.card-y;
                drop-shadow-color: Elev.card-shadow;

                VerticalLayout {
                    padding: Space.pad;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 20px;
                        Text {
                            text: Strings.tasks;
                            font-size: Type.caption;
                            font-weight: 700;
                            letter-spacing: Strings.fa ? 0px : Type.tracking;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: Digits.num(root.tasks.length);
                            font-size: Type.caption;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                    }

                    if root.tasks.length == 0 : Rectangle {
                        height: 46px;
                        Text {
                            text: Strings.tasks-empty;
                            font-size: Type.small;
                            color: Palette.text-faint;
                            x: 2px;
                            width: parent.width - 4px;
                            vertical-alignment: center;
                            // A full sentence in a 46px slot: it has to wrap,
                            // or the last words are silently cut off.
                            wrap: word-wrap;
                            line-height-factor: 1.45;
                        }
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-height: root.tasks.length * 42px;
                        interactive: root.tasks.length * 42px > self.height;

                        for t[i] in root.tasks : TaskRow {
                            y: i * 42px;
                            item: t;
                            last: i == root.tasks.length - 1;
                            toggle(id) => { root.toggle-task(id); }
                        }
                    }

                    // quick add
                    Rectangle {
                        height: 38px;
                        border-radius: 10px;
                        background: Palette.surface-2;

                        HorizontalLayout {
                            // Equal at both ends. It was 10px left and 4px
                            // right, which pushed the round Add button hard
                            // against the edge of the pill.
                            padding-left: Space.tight;
                            padding-right: Space.tight;
                            spacing: Space.tight;

                            // Two-way binding: a one-way `text:` binding is
                            // broken by the first keystroke, so clearing
                            // new-task-text from Rust never reached the field
                            // and the typed text stayed on screen after adding.
                            LineEdit {
                                text <=> root.new-task-text;
                                placeholder-text: Strings.task-placeholder;
                                font-size: Type.small;
                                horizontal-stretch: 1;
                                accepted(t) => {
                                    root.new-task-text = t;
                                    root.add-task();
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.new-task-text != "" ? Palette.accent : Palette.surface-3;
                                y: (parent.height - self.height) / 2;
                                ta6 := TouchArea { clicked => { root.add-task(); } }
                                states [
                                    h when ta6.has-hover && root.new-task-text != "" : {
                                        background: Palette.text;
                                        in { animate background { duration: Motion.quick; } }
                                    }
                                ]
                                Icon {
                                    kind: "plus";
                                    size: 14px;
                                    color: root.new-task-text != "" ? Palette.on-accent : Palette.text-faint;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 10px; }

            // ---- footer: sync ----
            HorizontalLayout {
                height: 18px;
                padding-left: Space.gutter;
                padding-right: Space.gutter;
                alignment: space-between;
                Text {
                    text: root.sync-status;
                    font-size: Type.caption;
                    color: Palette.text-faint;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: Strings.sync;
                    font-size: Type.caption;
                    color: Palette.text-dim;
                    ta7 := TouchArea {
                        clicked => { root.sync-now(); }
                        mouse-cursor: pointer;
                    }
                    states [
                        h when ta7.has-hover : {
                            color: Palette.accent;
                            in { animate color { duration: Motion.quick; } }
                        }
                    ]
                }
            }
            }
        }

        // ═══ STATS ═══
        // ═══ TODAY — Persian calendar ═══
        if root.show-view == "today" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px; spacing: 0px; // ---- title bar ----
            HorizontalLayout {
                height: Space.header-height; padding-left: Space.gutter; padding-right: Space.gutter; spacing: 8px; IconButton {
                    icon: "back"; size: 30px; icon-size: 15px; clicked => { root.close-today(); }
                }
                Text {
                    text: Strings.today; font-family: "Vazirmatn"; font-size: Type.title; font-weight: 600; color: Palette.text; horizontal-stretch: 1; }
                if root.refresh-status != "" : Text {
                    text: root.refresh-status; font-size: Type.caption; color: Palette.text-faint; vertical-alignment: center; }
                Rectangle {
                    width: 30px; height: 30px; border-radius: 15px; background: Palette.surface-2;
                    ta-ref := TouchArea { clicked => { root.refresh-events(); } }
                    states [
                        h when ta-ref.has-hover : { background: Palette.surface-3; in { animate background { duration: Motion.quick; } } }
                    ]
                    Icon { kind: "reset"; size: 14px; color: Palette.text-dim; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
            }

            Flickable {
                vertical-stretch: 1; width: parent.width; content-width: parent.width; content-height: today-content.preferred-height; interactive: true; today-content := VerticalLayout {
                    width: parent.width; padding-left: Space.gutter; padding-right: Space.gutter; padding-bottom: Space.gap * 2; spacing: Space.gap;

                    // ---- the month calendar ----
                    // The point of the whole screen: pick a day, see that day's
                    // work, and add to a future day without leaving it.
                    Rectangle {
                        height: month-card.preferred-height + 24px;
                        border-radius: Radius.card;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;

                        month-card := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            height: self.preferred-height;
                            spacing: 6px;

                            // month header: back, title, forward, today
                            HorizontalLayout {
                                height: 30px;
                                spacing: 4px;

                                IconButton {
                                    icon: "back";
                                    size: 26px;
                                    icon-size: 13px;
                                    clicked => { root.shift-month(-1); }
                                }
                                Text {
                                    text: root.month-title;
                                    font-family: "Vazirmatn";
                                    font-size: Type.body;
                                    font-weight: 600;
                                    color: Palette.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    icon: "skip";
                                    size: 26px;
                                    icon-size: 13px;
                                    clicked => { root.shift-month(1); }
                                }
                                // Back to today, only when you have wandered off.
                                if !root.selected-is-today : Rectangle {
                                    width: 44px;
                                    height: 24px;
                                    border-radius: Radius.tile;
                                    background: Palette.accent-soft;
                                    y: (parent.height - self.height) / 2;
                                    ta-today := TouchArea { clicked => { root.goto-today(); } }
                                    states [
                                        h when ta-today.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.today;
                                        font-family: "Vazirmatn";
                                        font-size: Type.caption;
                                        color: Palette.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // weekday initials, Saturday first
                            HorizontalLayout {
                                height: 16px;
                                for w in ["ش", "ی", "د", "س", "چ", "پ", "ج"] : Text {
                                    text: w;
                                    font-family: "Vazirmatn";
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    horizontal-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            MonthGrid {
                                rows: root.month-rows;
                                picked(k) => { root.pick-day(k); }
                            }
                        }
                    }

                    // ---- the selected day's tasks ----
                    HorizontalLayout {
                        height: 22px;
                        padding-left: 2px;
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: root.selected-day-title;
                            font-family: "Vazirmatn";
                            font-size: Type.small;
                            font-weight: 700;
                            color: Palette.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.selected-day-sub;
                            font-family: "Vazirmatn";
                            font-size: Type.caption;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: Digits.num(root.day-tasks.length);
                            font-size: Type.caption;
                            color: Palette.text-faint;
                            vertical-alignment: center;
                        }
                    }

                    if root.day-tasks.length == 0 : Rectangle {
                        height: 48px;
                        border-radius: Radius.card;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        Text {
                            text: Strings.tasks-none-day;
                            font-family: "Vazirmatn";
                            font-size: Type.small;
                            color: Palette.text-faint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for t in root.day-tasks : Rectangle {
                        height: editing == t.id ? 76px : 42px;
                        border-radius: Radius.card;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: editing == t.id ? Palette.accent : Palette.hairline;

                        animate height { duration: Motion.normal; }

                        VerticalLayout {
                            padding-left: Space.tight;
                            padding-right: Space.tight;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 40px;
                                spacing: 10px;

                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    border-width: 1.5px;
                                    border-color: t.done ? Palette.accent : Palette.surface-3;
                                    background: t.done ? Palette.accent : transparent;
                                    y: (parent.height - self.height) / 2;
                                    transform-scale: t.done ? 1.0 : 0.92;
                                    animate transform-scale { duration: Motion.normal; easing: ease-out-back; }
                                    animate background { duration: Motion.normal; }

                                    if t.done : Icon {
                                        kind: "check";
                                        size: 10px;
                                        color: Palette.on-accent;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    TouchArea { clicked => { root.toggle-task(t.id); } }
                                }

                                Text {
                                    text: t.title;
                                    font-family: "Vazirmatn";
                                    font-size: Type.small;
                                    color: t.done ? Palette.text-faint : Palette.text;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    animate color { duration: Motion.normal; }
                                }

                                if t.time != "" : Text {
                                    text: t.time;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }

                                // ── per-task controls ──
                                // Nudge the task a day either way, rename it, or
                                // delete it. These are what make the calendar a
                                // place to manage work rather than just look at it.
                                TaskAction {
                                    icon: "back";
                                    tip: Strings.move-earlier;
                                    clicked => { root.move-task(t.id, -1); }
                                }
                                TaskAction {
                                    icon: "skip";
                                    tip: Strings.move-later;
                                    clicked => { root.move-task(t.id, 1); }
                                }
                                TaskAction {
                                    icon: "edit";
                                    tip: Strings.rename;
                                    clicked => { editing = editing == t.id ? 0 : t.id; }
                                }
                                TaskAction {
                                    icon: "trash";
                                    tip: Strings.delete;
                                    destructive: true;
                                    clicked => { root.delete-task(t.id); }
                                }
                            }

                            // The rename field, only for the row being edited.
                            if editing == t.id : Rectangle {
                                height: 32px;
                                border-radius: Radius.tile;
                                background: Palette.surface-2;

                                HorizontalLayout {
                                    padding-left: Space.tight;
                                    padding-right: Space.tight;
                                    spacing: 4px;

                                    LineEdit {
                                        text <=> root.edit-text;
                                        font-size: Type.small;
                                        horizontal-stretch: 1;
                                        accepted(v) => {
                                            root.rename-task(t.id, v);
                                            editing = 0;
                                        }
                                    }

                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: Palette.accent;
                                        y: (parent.height - self.height) / 2;
                                        ta-save := TouchArea {
                                            clicked => {
                                                root.rename-task(t.id, root.edit-text);
                                                editing = 0;
                                            }
                                        }
                                        Icon {
                                            kind: "check";
                                            size: 12px;
                                            color: Palette.on-accent;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- add to the selected day ----
                    Rectangle {
                        height: 38px;
                        border-radius: 10px;
                        background: Palette.surface-2;

                        HorizontalLayout {
                            // Equal at both ends. It was 10px left and 4px
                            // right, which pushed the round Add button hard
                            // against the edge of the pill.
                            padding-left: Space.tight;
                            padding-right: Space.tight;
                            spacing: Space.tight;

                            LineEdit {
                                text <=> root.new-task-text;
                                placeholder-text: root.selected-is-today
                                    ? Strings.task-placeholder
                                    : Strings.task-placeholder-day;
                                font-size: Type.small;
                                horizontal-stretch: 1;
                                accepted(t) => {
                                    root.new-task-text = t;
                                    root.add-task-on(root.cal-selected);
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.new-task-text != "" ? Palette.accent : Palette.surface-3;
                                y: (parent.height - self.height) / 2;
                                ta-add := TouchArea { clicked => { root.add-task-on(root.cal-selected); } }
                                states [
                                    h when ta-add.has-hover && root.new-task-text != "" : {
                                        background: Palette.text;
                                        in { animate background { duration: Motion.quick; } }
                                    }
                                ]
                                Icon {
                                    kind: "plus";
                                    size: 14px;
                                    color: root.new-task-text != "" ? Palette.on-accent : Palette.text-faint;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    Rectangle {
                        // Measures its text column. It held 146px, which fit
                        // the four short lines it was designed around but not
                        // the heritage title once it was rewritten into words —
                        // the caption ran under the card's bottom edge.
                        height: cal-head.preferred-height + 28px;
                        border-radius: Radius.card; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; // era emblem, faint, on the right
                        Rectangle {
                            width: 84px; height: 84px; x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2; background: transparent; if root.era == "cyrus" : Shahbaz { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                            if root.era == "darius" : Faravahar { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                            if root.era == "parthian" : Derafsh { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                            if root.era == "sasanid" : Senmurv { width: 84px; height: 84px; color: Palette.accent; fade: 0.10; }
                        }

                        cal-head := VerticalLayout {
                            padding-left: Space.pad; padding-top: Space.pad; padding-bottom: Space.pad; spacing: 4px; Text {
                                text: root.cal-weekday; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.accent; font-weight: 600; overflow: elide; }
                            Text {
                                text: root.cal-date; font-family: "Vazirmatn"; font-size: Type.display; font-weight: 600; color: Palette.text; overflow: elide; }
                            Text {
                                text: root.cal-month-progress; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text-dim; overflow: elide; }
                            Text {
                                text: Strings.heritage-title + " · " + Strings.heritage-sub;
                                font-family: "Vazirmatn"; font-size: Type.caption; color: Palette.accent;
                                // Two clauses joined by a dot do not fit one
                                // 260px line; wrapping keeps both readable
                                // instead of eliding the half that says what
                                // the calendar actually is.
                                wrap: word-wrap; line-height-factor: 1.45; }
                        }
                    }

                    // ---- the Sasanian day-name ----
                    Rectangle {
                        height: day-name-col.preferred-height + 24px; border-radius: Radius.card; background: Palette.accent-soft; border-width: 1px; border-color: Palette.accent; day-name-col := VerticalLayout {
                            padding-left: Space.pad; padding-right: Space.pad; padding-top: 12px; padding-bottom: 12px; spacing: 2px; Text {
                                text: Strings.day-name-label; font-family: "Vazirmatn"; font-size: Type.small; font-weight: 700; color: Palette.text-faint; overflow: elide; }
                            HorizontalLayout {
                                spacing: 8px; Text {
                                    text: root.cal-day-name; font-family: "Vazirmatn"; font-size: Type.display; font-weight: 600; color: Palette.accent; vertical-alignment: center; overflow: elide; }
                                Text {
                                    text: root.cal-day-index; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text-dim; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }
                        }
                    }

                    // ---- feast badge, only when today is one ----
                    if root.cal-feast != "" : Rectangle {
                        height: feast-col.preferred-height + 24px;
                        border-radius: Radius.tile; background: Palette.surface-2; border-width: 1px; border-color: Palette.hairline; HorizontalLayout {
                            padding-left: Space.pad; padding-right: Space.pad; spacing: 8px; alignment: start; Boteh {
                                size: 20px; y: (parent.height - self.height) / 2; color: Palette.accent; fade: 0.9; }
                            feast-col := VerticalLayout {
                                vertical-stretch: 0;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: Strings.feast-prefix + root.cal-feast; font-family: "Vazirmatn"; font-size: Type.body; font-weight: 600; color: Palette.text; vertical-alignment: center; overflow: elide; }
                                if root.cal-feast-note != "" : Text {
                                    // The note is a full sentence. Eliding it
                                    // cut the gloss off mid-word, which is
                                    // worse than not showing it, so it wraps
                                    // and the card measures itself.
                                    text: root.cal-feast-note; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text-dim; wrap: word-wrap; line-height-factor: 1.45; }
                            }
                        }
                    }

                    // ---- events ----
                    HorizontalLayout {
                        height: 20px; padding-left: 2px; spacing: 6px; alignment: start; Text {
                            text: Strings.iran-events; font-family: "Vazirmatn"; font-size: Type.small; font-weight: 700; color: Palette.text-faint; vertical-alignment: center; }
                        Text {
                            text: root.cal-events.length > 0 ? "(" + root.cal-events.length + ")" : ""; font-size: Type.caption; color: Palette.text-faint; vertical-alignment: center; }
                    }

                    if root.cal-events.length == 0 : Rectangle {
                        height: 56px; border-radius: Radius.tile; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; Text {
                            text: root.cal-empty; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text-faint; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; line-height-factor: 1.55; }
                    }

                    for ev in root.cal-events : Rectangle {
                        height: ev-row.preferred-height + 22px; border-radius: Radius.tile; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; ev-row := VerticalLayout {
                            x: 14px; y: 11px; width: parent.width - 28px; height: self.preferred-height; spacing: 4px; HorizontalLayout {
                                spacing: 6px; height: 14px; if ev.year != "" : Text {
                                    text: ev.year; font-family: "Vazirmatn"; font-size: Type.caption; font-weight: 700; color: Palette.accent; vertical-alignment: center; }
                                if ev.section != "" : Text {
                                    text: ev.section; font-family: "Vazirmatn"; font-size: Type.caption; color: Palette.text-faint; vertical-alignment: center; }
                            }

                            Text {
                                text: ev.text; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text; wrap: word-wrap; line-height-factor: 1.55; }
                        }
                    }

                    // ---- world history, folded away by default ----
                    if root.cal-world.length > 0 : Rectangle {
                        height: 40px; border-radius: Radius.tile; background: Palette.surface; border-width: 1px; border-color: Palette.hairline;
                        ta-world := TouchArea { clicked => { root.cal-world-open = !root.cal-world-open; } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 8px;
                            Text {
                                text: Strings.world-events; font-family: "Vazirmatn"; font-size: Type.small; font-weight: 600; color: Palette.text-dim; vertical-alignment: center; horizontal-stretch: 1;
                            }
                            Text {
                                text: "(" + root.cal-world.length + ")"; font-size: Type.caption; color: Palette.text-faint; vertical-alignment: center;
                            }
                            Text {
                                text: root.cal-world-open ? Strings.show-less : Strings.show-more; font-size: Type.caption; color: Palette.accent; vertical-alignment: center;
                            }
                        }
                    }

                    if root.cal-world-open : VerticalLayout {
                        spacing: 10px;
                        for ev in root.cal-world : Rectangle {
                            height: wv-row.preferred-height + 22px; border-radius: Radius.tile; background: Palette.surface; border-width: 1px; border-color: Palette.hairline; wv-row := VerticalLayout {
                                x: 14px; y: 11px; width: parent.width - 28px; height: self.preferred-height; spacing: 4px; HorizontalLayout {
                                    spacing: 6px; height: 14px; if ev.year != "" : Text {
                                        text: ev.year; font-family: "Vazirmatn"; font-size: Type.caption; font-weight: 700; color: Palette.text-dim; vertical-alignment: center; }
                                }

                                Text {
                                    text: ev.text; font-family: "Vazirmatn"; font-size: Type.small; color: Palette.text-dim; wrap: word-wrap; line-height-factor: 1.55; }
                            }
                        }
                    }
                }
            }
        }

        // ═══ CHRONICLE ═══
        // The imperial timeline: every dynasty from the Medes to the Pahlavi,
        // in order, each with its span, capital, a notable figure and the one
        // thing it is remembered for. This is the view that gives the app its
        // sense of depth — the timer measures an hour, this measures 2,500
        // years.
        if root.show-view == "chronicle" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px;
            spacing: 0px;

            // ---- title bar ----
            HorizontalLayout {
                height: Space.header-height;
                padding-left: Space.gutter;
                padding-right: Space.gutter;
                spacing: 8px;
                IconButton {
                    icon: "back";
                    size: 30px;
                    icon-size: 15px;
                    clicked => { root.close-chronicle(); }
                }
                Text {
                    text: Strings.nav-chronicle;
                    font-family: "Vazirmatn";
                    font-size: Type.title;
                    font-weight: 600;
                    color: Palette.text;
                    horizontal-stretch: 1;
                }
            }

            Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-height: chron-col.preferred-height;
                interactive: true;

                chron-col := VerticalLayout {
                    width: parent.width;
                    padding-left: Space.gutter;
                    padding-right: Space.gutter;
                    padding-bottom: Space.gap * 2;
                    spacing: 0px;

                    // ---- header: the claim the view makes ----
                    Text {
                        text: Strings.chron-title;
                        font-family: "Vazirmatn";
                        font-size: Type.heading;
                        font-weight: 700;
                        color: Palette.text;
                        horizontal-alignment: Strings.fa ? right : left;
                    }
                    Text {
                        text: Strings.chron-sub;
                        font-family: "Vazirmatn";
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        wrap: word-wrap;
                        line-height-factor: 1.55;
                        horizontal-alignment: Strings.fa ? right : left;
                    }

                    Rectangle {
                        height: 14px;
                        WingedDivider { width: parent.width; color: Palette.accent; fade: 0.55; }
                    }

                    // ---- the dynasties ----
                    // Staggered entrance: each row reveals a beat after the one
                    // above it, so the chronicle assembles top-down.
                    for d[i] in root.dynasties : DynastyRow {
                        name: d.name;
                        span: d.span;
                        capital: d.capital;
                        figure: d.figure;
                        legacy: d.legacy;
                        capital-label: Strings.chron-capital-label;
                        figure-label: Strings.chron-figure-label;
                        legacy-label: Strings.chron-legacy-label;
                        first: i == 0;
                        last: i == root.dynasties.length - 1;
                        index: i;
                        reveal: root.view-opacity;
                    }

                    Rectangle {
                        height: 16px;
                        LotusRow {
                            count: 9;
                            unit: 15px;
                            x: (parent.width - self.width) / 2;
                            color: Palette.accent;
                            fade: 0.30;
                        }
                    }

                    Text {
                        text: Strings.chron-foot;
                        font-family: "Vazirmatn";
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        wrap: word-wrap;
                        line-height-factor: 1.55;
                        horizontal-alignment: Strings.fa ? right : left;
                    }
                }
            }
        }

        // ═══ INSCRIPTIONS ═══
        // The archive of written lines, one per finished focus session. It is a
        // separate screen rather than a card on Stats because its job is not
        // measurement: a number tells you how long you sat, this tells you what
        // you did, and the two do not belong in the same column.
        if root.show-view == "inscriptions" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px;
            spacing: 0px;

            HorizontalLayout {
                height: Space.header-height;
                padding-left: Space.gutter;
                padding-right: Space.gutter;
                spacing: 8px;
                alignment: start;

                IconButton {
                    icon: "back";
                    size: 30px;
                    icon-size: 15px;
                    clicked => { root.close-inscriptions(); }
                }
                Text {
                    text: Strings.ins-title;
                    font-size: Type.title;
                    font-weight: 600;
                    color: Palette.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: "close";
                    size: 30px;
                    icon-size: 14px;
                    clicked => { root.close-inscriptions(); }
                }
            }

            Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-height: ins-col.preferred-height;
                interactive: ins-col.preferred-height > self.height;

                ins-col := VerticalLayout {
                    width: parent.width;
                    padding-left: Space.gutter;
                    padding-right: Space.gutter;
                    padding-bottom: Space.gap * 2;
                    spacing: Space.gap;

                    Text {
                        text: Strings.ins-sub;
                        font-family: "Vazirmatn";
                        font-size: Type.small;
                        color: Palette.text-faint;
                        wrap: word-wrap;
                        line-height-factor: 1.5;
                        horizontal-alignment: Strings.fa ? right : left;
                    }

                    // Search, plus the two ways out: a file on disk, or the
                    // clipboard. Both are the same Markdown; the file is for
                    // keeping, the clipboard is for pasting into a journal.
                    HorizontalLayout {
                        height: 38px;
                        spacing: 6px;
                        alignment: start;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 38px;
                            border-radius: Radius.tile;
                            background: Palette.surface-2;
                            border-width: 1px;
                            border-color: Palette.hairline;

                            HorizontalLayout {
                                padding-left: Space.tight;
                                padding-right: Space.tight;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.inscription-search;
                                    placeholder-text: Strings.ins-search;
                                    font-size: Type.small;
                                    edited(v) => { root.search-inscriptions(v); }
                                    accepted(v) => { root.search-inscriptions(v); }
                                }
                            }
                        }

                        IconButton {
                            icon: "edit";
                            size: 34px;
                            icon-size: 15px;
                            clicked => { root.export-inscriptions(); }
                        }
                        IconButton {
                            icon: "chart";
                            size: 34px;
                            icon-size: 15px;
                            clicked => { root.copy-inscriptions(); }
                        }
                    }

                    if root.archive-decree-count != "" : Text {
                        text: root.archive-decree-count;
                        font-family: "Vazirmatn";
                        font-size: Type.caption;
                        color: Palette.accent;
                        horizontal-alignment: Strings.fa ? right : left;
                    }

                    if root.inscriptions.length == 0 : Card {
                        height: self.preferred-height;
                        VerticalLayout {
                            padding: 14px;
                            Text {
                                text: root.archive-empty;
                                font-family: "Vazirmatn";
                                font-size: Type.small;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.5;
                                horizontal-alignment: Strings.fa ? right : left;
                            }
                        }
                    }

                    for row[i] in root.inscriptions : VerticalLayout {
                        spacing: 4px;

                        // The day heading, only on the first row of each day.
                        if row.day != "" : Text {
                            text: row.day;
                            font-family: "Vazirmatn";
                            font-size: Type.caption;
                            font-weight: 600;
                            color: Palette.accent;
                            horizontal-alignment: Strings.fa ? right : left;
                        }

                        Card {

                            row-card := VerticalLayout {
                                padding: 14px;
                                spacing: 6px;

                                // The plan this block came from, when it came
                                // from one. Above the decree because it is the
                                // outermost layer: the day's list said this
                                // block would happen, and now it has.
                                if row.planned != "" : HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "◦";
                                        font-size: Type.caption;
                                        color: Palette.text-faint;
                                        vertical-alignment: top;
                                    }
                                    Text {
                                        text: row.planned;
                                        font-family: "Vazirmatn";
                                        font-size: Type.caption;
                                        color: Palette.text-faint;
                                        wrap: word-wrap;
                                        line-height-factor: 1.4;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: Strings.fa ? right : left;
                                    }
                                }

                                // The promise first, then the outcome. Only
                                // shown when a decree was actually issued, so a
                                // block written about without one still reads as
                                // a single clean line rather than a labelled
                                // blank.
                                if row.decree != "" : HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: "↳";
                                        font-size: Type.caption;
                                        color: Palette.accent;
                                        vertical-alignment: top;
                                    }
                                    Text {
                                        text: row.decree;
                                        font-family: "Vazirmatn";
                                        font-size: Type.caption;
                                        color: Palette.text-dim;
                                        wrap: word-wrap;
                                        line-height-factor: 1.4;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: Strings.fa ? right : left;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Space.gap;
                                    alignment: start;

                                    Text {
                                        text: row.time;
                                        font-size: Type.caption;
                                        color: Palette.text-faint;
                                        vertical-alignment: top;
                                    }

                                    Text {
                                        text: row.text;
                                        font-family: "Vazirmatn";
                                        font-size: Type.small;
                                        color: row.text == "" ? Palette.text-faint : Palette.text;
                                        wrap: word-wrap;
                                        line-height-factor: 1.5;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: Strings.fa ? right : left;
                                    }

                                    // A decree with no inscription: the block
                                    // was spoken for and nothing was written
                                    // against it. Said in the row rather than
                                    // left as a blank, because a blank reads as
                                    // a rendering fault.
                                    if row.text == "" : Text {
                                        text: Strings.ins-none-written;
                                        font-size: Type.caption;
                                        color: Palette.text-faint;
                                        font-italic: true;
                                        vertical-alignment: center;
                                    }

                                    IconButton {
                                        icon: "trash";
                                        size: 24px;
                                        icon-size: 12px;
                                        clicked => { root.delete-inscription(row.id); }
                                    }
                                }

                                // ── the verdict ──────────────────────────
                                //
                                // Five words under the line they judge. Shown
                                // only for a session that has a writing or a
                                // promise to judge — a row with neither has
                                // nothing to say a verdict about.
                                //
                                // A declared verdict is drawn filled and the
                                // five seals collapse to the one word; an
                                // inferred one is drawn hollow and labelled,
                                // so a guess can never be mistaken for the
                                // user's own statement.
                                if row.text != "" || row.decree != "" : HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;

                                    // A declared verdict: one filled chip, and
                                    // the five seals are not drawn at all. The
                                    // user has already answered; re-asking
                                    // would make the row look unresolved and
                                    // would also let a stray press silently
                                    // rewrite an answer they were only reading.
                                    //
                                    // Wrapped in a HorizontalLayout because a
                                    // Rectangle has no padding of its own — the
                                    // Text child would be laid out at the
                                    // rectangle's origin, overflow to the left
                                    // in RTL, and be clipped by the 22px
                                    // height. The layout is what gives the chip
                                    // its width.
                                    // A filled field, not an outline. An outlined
                                    // chip is the same shape as the seals it
                                    // replaced, so it reads as one more option
                                    // to press; a filled field reads as a value
                                    // that has already been set. `on-accent` is
                                    // the colour the rest of the app uses for
                                    // text on a filled accent surface.
                                    //
                                    // Pressing it takes the word back. That is
                                    // the only way to reach the five seals
                                    // again once a verdict is declared, and an
                                    // app that can record a judgement but never
                                    // withdraw one is an app that argues with
                                    // the user. The tooltip is the affordance:
                                    // without it the chip looks like a label.
                                    if row.verdict-declared : Rectangle {
                                        height: 22px;
                                        border-radius: 11px;
                                        background: Palette.accent;
                                        ta-undo := TouchArea {
                                            clicked => { root.declare-verdict(row.session, ""); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            alignment: center;
                                            Text {
                                                text: row.verdict;
                                                font-family: "Vazirmatn";
                                                font-size: Type.caption;
                                                font-weight: 600;
                                                color: Palette.on-accent;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if !row.verdict-declared : HorizontalLayout {
                                        spacing: 4px;
                                        alignment: start;

                                        // The five, in the order the words read
                                        // best: done, half, not, over, short.
                                        VerdictSeal {
                                            kind: "kept";
                                            label: Strings.verdict-kept;
                                            active: row.verdict-kind == "kept";
                                            picked(k) => { root.declare-verdict(row.session, k); }
                                        }
                                        VerdictSeal {
                                            kind: "partial";
                                            label: Strings.verdict-partial;
                                            active: row.verdict-kind == "partial";
                                            picked(k) => { root.declare-verdict(row.session, k); }
                                        }
                                        VerdictSeal {
                                            kind: "broken";
                                            label: Strings.verdict-broken;
                                            active: row.verdict-kind == "broken";
                                            picked(k) => { root.declare-verdict(row.session, k); }
                                        }
                                        VerdictSeal {
                                            kind: "extended";
                                            label: Strings.verdict-extended;
                                            active: row.verdict-kind == "extended";
                                            picked(k) => { root.declare-verdict(row.session, k); }
                                        }
                                        VerdictSeal {
                                            kind: "short";
                                            label: Strings.verdict-short;
                                            active: row.verdict-kind == "short";
                                            picked(k) => { root.declare-verdict(row.session, k); }
                                        }

                                        // When the app guessed, it says so
                                        // quietly at the end of the seal row:
                                        // the user is being asked, not told.
                                        if row.verdict != "" : Text {
                                            text: Strings.verdict-inferred;
                                            font-size: Type.caption;
                                            color: Palette.text-faint;
                                            font-italic: true;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.show-view == "report" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px;
            spacing: 0px;

            // ── header ───────────────────────────────────────────────────
            HorizontalLayout {
                height: Space.header-height;
                padding-left: Space.gutter;
                padding-right: Space.gutter;
                spacing: 8px;
                alignment: start;

                IconButton {
                    icon: "back";
                    size: 30px;
                    icon-size: 15px;
                    clicked => { root.close-report(); }
                }
                Text {
                    text: Strings.nav-stats;
                    font-size: Type.title;
                    font-weight: 600;
                    color: Palette.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: "close";
                    size: 30px;
                    icon-size: 14px;
                    clicked => { root.close-report(); }
                }
            }

            Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-height: report-col.preferred-height;
                interactive: report-col.preferred-height > self.height;

                report-col := VerticalLayout {
                    width: parent.width;
                    padding-left: Space.gutter;
                    padding-right: Space.gutter;
                    padding-bottom: Space.gap * 2;
                    spacing: Space.gap;

                    // ── period picker ────────────────────────────────────
                    PeriodPicker {
                        options: [Strings.period-day, Strings.period-week, Strings.period-month, Strings.period-year, Strings.period-all];
                        current: root.report-period-index;
                        selected(i) => { root.set-report-period(i); }
                    }

                    // ── span navigator ───────────────────────────────────
                    // The title says which span you are looking at and the
                    // arrows move one period at a time. This is the control
                    // that was missing entirely: without it the screen could
                    // only ever describe "now".
                    HorizontalLayout {
                        height: 40px;
                        spacing: 6px;
                        alignment: space-between;

                        IconButton {
                            icon: "back";
                            size: 30px;
                            icon-size: 14px;
                            enabled: root.report-period-index != 4;
                            clicked => { root.step-report(-1); }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 1px;
                            alignment: center;

                            Text {
                                text: root.report-title;
                                font-size: Type.title;
                                font-weight: 600;
                                color: Palette.text;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.report-span;
                                font-size: Type.caption;
                                color: Palette.text-faint;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }

                        // Forward is disabled at the current period: there is
                        // no future data to show, and an arrow that does
                        // nothing is worse than an arrow that says so.
                        IconButton {
                            icon: "chevron";
                            size: 30px;
                            icon-size: 14px;
                            enabled: root.report-offset < 0;
                            clicked => { root.step-report(1); }
                        }
                    }

                    // ── "back to now" ────────────────────────────────────
                    // Only present when you have actually navigated away, so
                    // the current view stays uncluttered.
                    if root.report-offset != 0 && root.report-period-index != 4 : Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: Palette.accent-soft;
                        border-width: 1px;
                        border-color: Palette.hairline;

                        now-ta := TouchArea { clicked => { root.report-today(); } }

                        Text {
                            text: Strings.stat-back-to-now;
                            font-size: Type.caption;
                            font-weight: 600;
                            color: Palette.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        states [
                            hovered when now-ta.has-hover : {
                                background: Palette.surface-3;
                                in { animate background { duration: Motion.quick; } }
                            }
                        ]
                    }

                    // ── headline score ───────────────────────────────────
                    Rectangle {
                        height: score-col.preferred-height + Space.pad * 2;
                        border-radius: Radius.panel;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        drop-shadow-blur: Elev.lift-blur;
                        drop-shadow-offset-y: Elev.lift-y;
                        drop-shadow-color: Elev.lift-shadow;

                        score-col := VerticalLayout {
                            padding: Space.pad;
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: Strings.score-title;
                                font-size: Type.caption;
                                font-weight: 700;
                                letter-spacing: Strings.fa ? 0px : Type.tracking;
                                color: Palette.text-faint;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: Digits.num(root.report-score);
                                font-size: 38px;
                                font-weight: 300;
                                color: Palette.accent;
                                horizontal-alignment: center;
                            }
                            // The delta against the previous period, directly
                            // under the score it belongs to.
                            if root.report-has-prev : HorizontalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: root.report-delta >= 0 ? "▲" : "▼";
                                    font-size: Type.caption;
                                    color: root.report-delta >= 0 ? Palette.accent : Palette.danger;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: Digits.num(Math.abs(root.report-delta)) + (Strings.fa ? "٪" : "%");
                                    font-size: Type.caption;
                                    font-weight: 600;
                                    color: root.report-delta >= 0 ? Palette.accent : Palette.danger;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: Strings.stat-vs-prev;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // ── the chart ────────────────────────────────────────
                    Rectangle {
                        height: chart-col.preferred-height + Space.pad * 2;
                        border-radius: Radius.card;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        drop-shadow-blur: Elev.card-blur;
                        drop-shadow-offset-y: Elev.card-y;
                        drop-shadow-color: Elev.card-shadow;

                        chart-col := VerticalLayout {
                            padding: Space.pad;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: Strings.focus;
                                    font-size: Type.caption;
                                    font-weight: 700;
                                    letter-spacing: Strings.fa ? 0px : Type.tracking;
                                    color: Palette.text-faint;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: Digits.num(root.report-minutes) + " " + Strings.minutes-short;
                                    font-size: Type.caption;
                                    font-weight: 600;
                                    color: Palette.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            BarChart {
                                values: root.chart-bars;
                                labels: root.chart-labels;
                                current: root.chart-current;
                                future-from: root.chart-future-from;
                                // A month of 30 columns cannot print 30 labels;
                                // every fifth is legible and enough to orient.
                                label-every: root.report-period-index == 2 ? 5
                                    : root.report-period-index == 4 ? 2
                                    : root.report-period-index == 0 ? 3
                                    : 1;
                                bar-gap: root.report-period-index == 2 ? 2px : 3px;
                            }

                            if root.report-empty : Text {
                                text: Strings.stat-empty;
                                font-size: Type.small;
                                color: Palette.text-faint;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── KPI grid ─────────────────────────────────────────
                    HorizontalLayout {
                        spacing: Space.gap;
                        StatCard {
                            label: Strings.sessions;
                            value: Digits.num(root.report-sessions);
                            horizontal-stretch: 1;
                        }
                        StatCard {
                            label: Strings.focus;
                            value: Digits.num(root.report-minutes) + " " + Strings.minutes-short;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.gap;
                        StatCard {
                            label: Strings.stat-avg-session;
                            value: Digits.num(root.report-avg) + " " + Strings.minutes-short;
                            horizontal-stretch: 1;
                        }
                        StatCard {
                            label: Strings.stat-best-day;
                            value: Digits.num(root.report-best) + " " + Strings.minutes-short;
                            hint: root.report-best-label;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.gap;
                        StatCard {
                            label: Strings.stat-active-days;
                            value: Digits.num(root.report-active-days) + " / " + Digits.num(root.report-days);
                            horizontal-stretch: 1;
                        }
                        StatCard {
                            label: Strings.consistency;
                            value: Digits.pct(root.report-consistency / 100.0);
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.gap;
                        StatCard {
                            label: Strings.streak;
                            value: Digits.num(root.report-streak) + " " + Strings.stat-day-unit;
                            horizontal-stretch: 1;
                        }
                        StatCard {
                            label: Strings.stat-longest;
                            value: Digits.num(root.report-longest) + " " + Strings.stat-day-unit;
                            horizontal-stretch: 1;
                        }
                    }

                    // ── time-of-day profile ──────────────────────────────
                    // Only shown once there is something to show. An empty
                    // 24-column strip is noise, not information.
                    if root.has-hour-profile : Rectangle {
                        height: hours-col.preferred-height + Space.pad * 2;
                        border-radius: Radius.card;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        drop-shadow-blur: Elev.card-blur;
                        drop-shadow-offset-y: Elev.card-y;
                        drop-shadow-color: Elev.card-shadow;

                        hours-col := VerticalLayout {
                            padding: Space.pad;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: Strings.stat-hours;
                                    font-size: Type.caption;
                                    font-weight: 700;
                                    letter-spacing: Strings.fa ? 0px : Type.tracking;
                                    color: Palette.text-faint;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            HourStrip {
                                values: root.hour-bars;
                            }

                            HorizontalLayout {
                                spacing: 0px;
                                for h[i] in [0, 6, 12, 18, 23] : Text {
                                    horizontal-stretch: 1;
                                    text: Digits.num(h);
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    horizontal-alignment: i == 0 ? start : (i == 4 ? end : center);
                                }
                            }

                            if root.report-honest-hour != "" : Text {
                                text: root.report-honest-hour;
                                font-size: Type.caption;
                                color: Palette.text-dim;
                                wrap: word-wrap;
                            }
                            if root.report-honest-gap != "" : Text {
                                text: root.report-honest-gap;
                                font-size: Type.caption;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── narrative ────────────────────────────────────────
                    // The same numbers, in sentences. Kept because a person
                    // reads "you are up 40% on last week" faster than they
                    // read two bars side by side.
                    Rectangle {
                        height: narrative-text.preferred-height + Space.pad * 2;
                        border-radius: Radius.card;
                        background: Palette.surface-2;
                        border-width: 1px;
                        border-color: Palette.hairline;

                        narrative-text := Text {
                            x: Space.pad;
                            y: Space.pad;
                            width: parent.width - Space.pad * 2;
                            text: root.report-narrative;
                            font-size: Type.small;
                            color: Palette.text-dim;
                            wrap: word-wrap;
                        }
                    }

                    // ── the reckoning ────────────────────────────────────
                    // What the written record adds up to over this same span.
                    //
                    // Last card on the screen on purpose: the numbers above say
                    // how much was worked, and this says whether the work was
                    // the work that was planned — which is a question you ask
                    // after the volume, not instead of it.
                    if !root.reck-empty : Rectangle {
                        height: reck-col.preferred-height + Space.pad * 2;
                        border-radius: Radius.card;
                        background: Palette.surface;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        drop-shadow-blur: Elev.card-blur;
                        drop-shadow-offset-y: Elev.card-y;
                        drop-shadow-color: Elev.card-shadow;

                        reck-col := VerticalLayout {
                            padding: Space.pad;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: Strings.reck-title;
                                    font-size: Type.caption;
                                    font-weight: 700;
                                    letter-spacing: Strings.fa ? 0px : Type.tracking;
                                    color: Palette.text-faint;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                // "3 of 8": the ratio is the point, and stating
                                // both halves stops a bare "5" from being
                                // read as either good or bad depending on what
                                // the reader assumed the denominator was.
                                Text {
                                    text: Digits.num(root.reck-answered) + " "
                                        + Strings.reck-of + " "
                                        + Digits.num(root.reck-spoken);
                                    font-size: Type.caption;
                                    font-weight: 600;
                                    color: Palette.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            // The verdict line, built in Rust.
                            Text {
                                text: root.reck-summary;
                                font-size: Type.small;
                                color: Palette.text-dim;
                                wrap: word-wrap;
                            }

                            // ── how the blocks were judged ───────────────
                            // Five counts that are deliberately not summed into
                            // one "delivered" number: that flattening is what
                            // the seals exist to undo. The declared/total line
                            // underneath says how much of this the user said
                            // themselves and how much the app guessed at.
                            if !root.verdict-empty : VerticalLayout {
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: Strings.verdict-tally-title;
                                        font-size: Type.caption;
                                        font-weight: 700;
                                        letter-spacing: Strings.fa ? 0px : Type.tracking;
                                        color: Palette.text-faint;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: Digits.num(root.verdict-declared) + " "
                                            + Strings.reck-of + " "
                                            + Digits.num(root.verdict-total) + " "
                                            + Strings.verdict-tally-declared;
                                        font-size: Type.caption;
                                        color: Palette.text-faint;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // The one summary sentence. Deliberately a
                                // sentence and not a percentage: "9 of 12 met"
                                // says what happened, while "75%" invites the
                                // reader to grade a week that had reasons.
                                if root.verdict-met > 0 : Text {
                                    text: Digits.num(root.verdict-met) + " "
                                        + Strings.reck-of + " "
                                        + Digits.num(root.verdict-total) + " "
                                        + Strings.verdict-met-suffix;
                                    font-size: Type.small;
                                    color: Palette.text-dim;
                                    wrap: word-wrap;
                                }

                                // Seals, drawn as a wrapped row of chips. Each
                                // is the same shape as the one in the archive,
                                // so the word the user pressed is the word
                                // they later see counted.
                                HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;
                                    VerdictChip {
                                        label: Strings.verdict-kept;
                                        count: root.verdict-kept;
                                        tint: Palette.success;
                                    }
                                    VerdictChip {
                                        label: Strings.verdict-partial;
                                        count: root.verdict-partial;
                                        tint: Palette.accent;
                                    }
                                    VerdictChip {
                                        label: Strings.verdict-broken;
                                        count: root.verdict-broken;
                                        tint: Palette.danger;
                                    }
                                    VerdictChip {
                                        label: Strings.verdict-extended;
                                        count: root.verdict-extended;
                                        tint: Palette.accent;
                                    }
                                    VerdictChip {
                                        label: Strings.verdict-short;
                                        count: root.verdict-short;
                                        tint: Palette.text-faint;
                                    }
                                }
                            }

                            // The four counts. Two pairs rather than one row of
                            // four: at this width four labels in a row elide.
                            HorizontalLayout {
                                spacing: Space.gap;
                                StatCard {
                                    label: Strings.reck-unanswered;
                                    value: Digits.num(root.reck-unanswered);
                                    horizontal-stretch: 1;
                                }
                                StatCard {
                                    label: Strings.reck-unspoken;
                                    value: Digits.num(root.reck-unspoken);
                                    horizontal-stretch: 1;
                                }
                            }

                            // ── promises that did not land ───────────────
                            if root.reck-unfulfilled.length > 0 : VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: Strings.reck-unfulfilled-title;
                                    font-size: Type.caption;
                                    font-weight: 700;
                                    letter-spacing: Strings.fa ? 0px : Type.tracking;
                                    color: Palette.text-faint;
                                    overflow: elide;
                                }

                                for u[i] in root.reck-unfulfilled : Rectangle {
                                    // A left rule instead of a full card: the
                                    // rows are a list of facts, and framing each
                                    // one would make five subdued notes look
                                    // like five separate problems.
                                    height: u-row.preferred-height + 10px;
                                    background: transparent;

                                    Rectangle {
                                        width: 2px;
                                        height: parent.height - 6px;
                                        y: 3px;
                                        border-radius: 1px;
                                        background: Palette.danger;
                                    }

                                    u-row := VerticalLayout {
                                        x: 10px;
                                        width: parent.width - 12px;
                                        y: 3px;
                                        spacing: 1px;
                                        Text {
                                            text: u.text;
                                            font-size: Type.small;
                                            color: Palette.text-dim;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: u.day;
                                            font-size: Type.caption;
                                            color: Palette.text-faint;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // "and 3 more": the list is capped so it stays
                                // a prompt, but the total behind it is not
                                // hidden — that would be the report flattering
                                // the user by omission.
                                if root.reck-unfulfilled-total > root.reck-unfulfilled.length : Text {
                                    text: Strings.reck-more + " "
                                        + Digits.num(root.reck-unfulfilled-total
                                            - root.reck-unfulfilled.length) + " "
                                        + Strings.reck-more-suffix;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                }
                            }

                            // ── the span's recurring words ───────────────
                            if root.reck-themes.length > 0 : VerticalLayout {
                                spacing: 6px;

                                Text {
                                    text: Strings.reck-themes-title;
                                    font-size: Type.caption;
                                    font-weight: 700;
                                    letter-spacing: Strings.fa ? 0px : Type.tracking;
                                    color: Palette.text-faint;
                                    overflow: elide;
                                }

                                for t in root.reck-themes : VerticalLayout {
                                    spacing: 3px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: t.word;
                                            font-size: Type.small;
                                            color: Palette.text-dim;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: t.count;
                                            font-size: Type.caption;
                                            color: Palette.text-faint;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // A bar, not a chart. Five words do not need
                                    // axes; they need to be comparable, and a
                                    // shared left edge does that with one rule.
                                    Rectangle {
                                        height: 3px;
                                        border-radius: 2px;
                                        background: Palette.surface-3;

                                        Rectangle {
                                            // A floor so a two-count theme is
                                            // still visible next to a five: at
                                            // this width a 40% bar is one pixel
                                            // and reads as a rendering fault.
                                            width: parent.width * Math.max(t.weight, 0.08);
                                            height: parent.height;
                                            border-radius: 2px;
                                            background: Palette.accent;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }


        // ═══ SETTINGS ═══
        if root.show-view == "settings" : VerticalLayout {
            opacity: root.view-opacity;
            y: root.view-offset;
            padding: 0px;
            spacing: 0px;

            HorizontalLayout {
                height: Space.header-height;
                padding-left: Space.gutter;
                padding-right: Space.gutter;
                spacing: 8px;

                IconButton {
                    icon: "back";
                    size: 30px;
                    icon-size: 15px;
                    clicked => { root.close-settings(); }
                }
                Text {
                    text: Strings.settings;
                    font-size: Type.title;
                    font-weight: 600;
                    color: Palette.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                // The primary action of this screen.
                //
                // It was a filled accent pill while every other primary action
                // in the app — Start, Add task, Add routine — is also filled
                // accent, and the secondary ones (Preview, Backup, Restore,
                // Sync now) are flat surface-2. That is the right hierarchy; the
                // settings header was the one place that broke it, with a flat
                // grey "Done" that read as disabled next to the accent "Add"
                // button further down the same screen.
                Rectangle {
                    width: 62px;
                    height: 30px;
                    border-radius: 15px;
                    background: Palette.accent;
                    ta8 := TouchArea { clicked => { root.close-settings(); } }
                    states [
                        h when ta8.has-hover : {
                            background: Palette.text;
                            in { animate background { duration: Motion.quick; } }
                        }
                    ]
                    Text {
                        text: Strings.done;
                        font-size: Type.small;
                        font-weight: 600;
                        color: Palette.on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Flickable {
                content-width: parent.width;
                content-height: settings-content.preferred-height;
                interactive: true;
                vertical-stretch: 1;
                // A Flickable sizes to its content's preferred width unless it
                // is told to fill. It was not, so the whole settings column —
                // every card, every divider — came out 260px wide inside a
                // 420px window and stopped dead short of the right gutter.
                width: parent.width;
                // Bind to the real content height so nothing is ever clipped when
                // a section is added. (This used to be a hardcoded 1180px, which
                // silently hid the bottom sections.)

                settings-content := VerticalLayout {
                    width: parent.width;
                    padding-left: Space.gutter;
                    padding-right: Space.gutter;
                    padding-bottom: Space.gap * 2;
                    spacing: 8px;

                    // ── timer ──
                    SectionLabel { text: Strings.sec-timer; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;

                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-work; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Stepper { value <=> root.work-minutes; min: 1; max: 180; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.work-minutes = v; } }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-short; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Stepper { value <=> root.short-break-minutes; min: 1; max: 60; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.short-break-minutes = v; } }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-long; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Stepper { value <=> root.long-break-minutes; min: 1; max: 90; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.long-break-minutes = v; } }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 40px;
                                alignment: center;
                                Text { text: Strings.lbl-long-every; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Stepper { value <=> root.long-break-interval; min: 1; max: 12; suffix: ""; changed(v) => { root.long-break-interval = v; } }
                            }
                        }
                    }

                    // ── goal ──
                    SectionLabel { text: Strings.sec-goal; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            HorizontalLayout {
                                alignment: center;
                                Text { text: Strings.lbl-goal; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Stepper { value <=> root.daily-goal-minutes; min: 15; max: 600; suffix: Strings.fa ? " دقیقه" : " min"; changed(v) => { root.daily-goal-minutes = v; } }
                            }
                        }
                    }

                    // ── behaviour ──
                    SectionLabel { text: Strings.sec-behaviour; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-autostart-next; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle { checked <=> root.auto-start-next; y: (parent.height - self.height) / 2; }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-autostart-launch; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle { checked <=> root.auto-start-on-launch; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    // ── appearance ──
                    SectionLabel { text: Strings.sec-heritage; }
                    Card {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 9px;

                            HorizontalLayout {
                                height: 14px;
                                Text {
                                    text: root.era-label;
                                    font-size: Type.small;
                                    font-weight: 700;
                                    letter-spacing: Strings.fa ? 0px : Type.tracking;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: Strings.lbl-eras;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }
                            }

                            // Two rows of two, not one row of four.
                            //
                            // At the default window width the settings column is
                            // 384px, so four cards with three 7px gaps left each
                            // card about 90px — and after its 10px inner padding
                            // only ~70px for the name and the sub-label. "آخامنشی"
                            // and "Persepolis" do not fit in that, and both labels
                            // are set to elide, so the choice was silently cut to
                            // a stub. Two per row doubles the usable width and the
                            // cards read as a picker again.
                            HorizontalLayout {
                                spacing: 7px;
                                EraCard {
                                    era-id: "cyrus";
                                    name: Strings.era-cyrus;
                                    blurb: Strings.era-cyrus-blurb;
                                    swatch: #D6A84E;
                                    active: root.era == "cyrus";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("cyrus"); }
                                }
                                EraCard {
                                    era-id: "darius";
                                    name: Strings.era-darius;
                                    blurb: Strings.era-darius-blurb;
                                    swatch: #C87941;
                                    active: root.era == "darius";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("darius"); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 7px;
                                EraCard {
                                    era-id: "parthian";
                                    name: Strings.era-parthian;
                                    blurb: Strings.era-parthian-blurb;
                                    swatch: #5B8FD6;
                                    active: root.era == "parthian";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("parthian"); }
                                }
                                EraCard {
                                    era-id: "sasanid";
                                    name: Strings.era-sasanid;
                                    blurb: Strings.era-sasanid-blurb;
                                    swatch: #4FA89B;
                                    active: root.era == "sasanid";
                                    horizontal-stretch: 1;
                                    picked => { root.set-era("sasanid"); }
                                }
                            }

                            // The selected dynasty's span and its place in history.
                            HorizontalLayout {
                                height: 14px;
                                spacing: 6px;
                                Text {
                                    text: root.era == "darius" ? Strings.era-darius-span
                                        : root.era == "parthian" ? Strings.era-parthian-span
                                        : root.era == "sasanid" ? Strings.era-sasanid-span
                                        : Strings.era-cyrus-span;
                                    font-size: Type.caption;
                                    font-weight: 600;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.era-blurb;
                                    font-size: Type.caption;
                                    color: Palette.text-dim;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: root.era == "darius" ? Strings.era-darius-note
                                    : root.era == "parthian" ? Strings.era-parthian-note
                                    : root.era == "sasanid" ? Strings.era-sasanid-note
                                    : Strings.era-cyrus-note;
                                font-size: Type.caption;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.45;
                                max-lines: 3;
                            }
                        }
                    }

                    SectionLabel { text: Strings.sec-appearance; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-theme; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Segmented {
                                    options: [Strings.theme-system, Strings.theme-dark, Strings.theme-light];
                                    current: root.theme-pref == "dark" ? 1 : (root.theme-pref == "light" ? 2 : 0);
                                    item-height: 24px;
                                    font-size: Type.small;
                                    y: (parent.height - self.height) / 2;
                                    selected(i) => {
                                        root.set-theme(i == 1 ? "dark" : (i == 2 ? "light" : "system"));
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-compact; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle {
                                    checked <=> root.compact-mode;
                                    y: (parent.height - self.height) / 2;
                                    // The window no longer binds its own size,
                                    // so switching compact mode has to ask Rust
                                    // to resize the window as well as swap the
                                    // layout — otherwise the compact view opens
                                    // inside a full-size window.
                                    toggled(v) => { root.set-compact-mode(v); }
                                }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            // Motion on/off. Off makes every transition
                            // instant, which is what a slow machine or a
                            // reduced-motion preference actually needs.
                            HorizontalLayout {
                                height: 52px;
                                VerticalLayout {
                                    spacing: 1px;
                                    alignment: center;
                                    vertical-stretch: 0;
                                    Text { text: Strings.lbl-animations; font-size: Type.body; color: Palette.text; horizontal-alignment: Strings.fa ? end : start; }
                                    Text { text: Strings.hint-animations; font-size: Type.small; color: Palette.text-dim; overflow: elide; horizontal-alignment: Strings.fa ? end : start; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Toggle {
                                    checked <=> root.animations;
                                    y: (parent.height - self.height) / 2;
                                    toggled(v) => { root.set-animations(v); }
                                }
                            }
                        }
                    }

                    // ── language ──
                    SectionLabel { text: Strings.sec-language; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            HorizontalLayout {
                                height: 34px;
                                Text { text: Strings.lbl-language; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Segmented {
                                    options: [Strings.lang-fa, Strings.lang-en];
                                    current: Strings.lang == "fa" ? 0 : 1;
                                    item-height: 26px;
                                    font-size: Type.small;
                                    y: (parent.height - self.height) / 2;
                                    selected(i) => { root.set-lang(i == 0 ? "fa" : "en"); }
                                }
                            }
                        }
                    }

                    // ── sound ──
                    SectionLabel { text: Strings.sec-sound; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 26px;
                                Text { text: Strings.lbl-sound-on; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle { checked <=> root.sound-enabled; y: (parent.height - self.height) / 2; }
                            }

                            Text { text: Strings.lbl-chime; font-size: Type.small; color: Palette.text-dim; horizontal-alignment: Strings.fa ? end : start; }

                            HorizontalLayout {
                                spacing: 6px;
                                for s[i] in ["santur", "daf", "tombak"] : Rectangle {
                                    height: 30px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: root.sound-theme == s ? Palette.accent : Palette.surface-2;
                                    ta9 := TouchArea { clicked => { root.sound-theme = s; } }
                                    states [
                                        h when ta9.has-hover && root.sound-theme != s : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: s == "santur" ? Strings.snd-santur : (s == "daf" ? Strings.snd-daf : (s == "tombak" ? Strings.snd-tombak : (s == "karn" ? Strings.snd-karn : (s == "sand" ? Strings.snd-sand : Strings.snd-cyrus))));
                                        font-size: Type.small;
                                        font-weight: root.sound-theme == s ? 600 : 400;
                                        color: root.sound-theme == s ? Palette.on-accent : Palette.text-dim;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                for s[i] in ["karn", "sand", "cyrus"] : Rectangle {
                                    height: 30px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: root.sound-theme == s ? Palette.accent : Palette.surface-2;
                                    ta10 := TouchArea { clicked => { root.sound-theme = s; } }
                                    states [
                                        h when ta10.has-hover && root.sound-theme != s : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: s == "santur" ? Strings.snd-santur : (s == "daf" ? Strings.snd-daf : (s == "tombak" ? Strings.snd-tombak : (s == "karn" ? Strings.snd-karn : (s == "sand" ? Strings.snd-sand : Strings.snd-cyrus))));
                                        font-size: Type.small;
                                        font-weight: root.sound-theme == s ? 600 : 400;
                                        color: root.sound-theme == s ? Palette.on-accent : Palette.text-dim;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            // volume + preview
                            HorizontalLayout {
                                height: 30px;
                                spacing: 10px;

                                Rectangle {
                                    height: 6px;
                                    horizontal-stretch: 1;
                                    border-radius: 3px;
                                    background: Palette.track;

                                    Rectangle {
                                        width: parent.width * root.sound-volume / 100;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: Palette.accent;
                                    }

                                    TouchArea {
                                        moved => {
                                            if (self.pressed) {
                                                root.sound-volume = round(clamp(self.mouse-x / self.width * 100, 0, 100));
                                            }
                                        }
                                        clicked => {
                                            root.sound-volume = round(clamp(self.mouse-x / self.width * 100, 0, 100));
                                        }
                                    }
                                }

                                Text {
                                    text: Digits.num(root.sound-volume) + (Strings.fa ? "٪" : "%");
                                    font-size: Type.small;
                                    color: Palette.text-dim;
                                    width: 34px;
                                    horizontal-alignment: end;
                                }

                                Rectangle {
                                    width: 72px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: Palette.surface-2;
                                    ta11 := TouchArea { clicked => { root.preview-sound(); } }
                                    states [
                                        h when ta11.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.preview;
                                        font-size: Type.small;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ── system ──
                    SectionLabel { text: Strings.sec-system; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 0px;
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-hotkeys; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle { checked <=> root.hotkey-enabled; y: (parent.height - self.height) / 2; }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-awake; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle { checked <=> root.inhibit-enabled; y: (parent.height - self.height) / 2; }
                            }
                            Rectangle { height: 1px; background: Palette.hairline; }
                            HorizontalLayout {
                                height: 44px;
                                Text { text: Strings.lbl-overlay; font-size: Type.body; color: Palette.text; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: Strings.fa ? end : start; overflow: elide; }
                                Toggle { checked <=> root.overlay-enabled; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    // ── automation ──
                    SectionLabel { text: Strings.sec-automation; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;

                            Text {
                                text: root.automation-summary;
                                font-size: Type.small;
                                horizontal-alignment: Strings.fa ? end : start;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.55;
                                max-lines: 2;
                            }

                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 34px;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    LineEdit {
                                        text <=> root.new-automation-text;
                                        placeholder-text: Strings.automation-placeholder;
                                        font-size: Type.small;
                                    }
                                }

                                Rectangle {
                                    width: 58px;
                                    height: 34px;
                                    border-radius: 9px;
                                    background: Palette.accent;
                                    ta12 := TouchArea {
                                        clicked => { root.add-automation("focus_start", root.new-automation-text); }
                                    }
                                    states [
                                        h when ta12.has-hover : {
                                            background: Palette.text;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.add;
                                        font-size: Type.small;
                                        font-weight: 600;
                                        color: Palette.on-accent;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: Strings.automation-hint;
                                font-size: Type.small;
                                horizontal-alignment: Strings.fa ? end : start;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.55;
                            }
                        }
                    }

                    // ── cloud ──
                    SectionLabel { text: Strings.sec-cloud; }

                    // Google account card. This is the whole sign-in flow: one
                    // button, then a short code the user types on whatever
                    // device already has a browser. No password ever touches
                    // the app, and no local port has to be reachable.
                    Card {
                        // Height follows the content. The card has four very
                        // different states (signed in, ready, waiting for a
                        // code, no client id) and a fixed height per state was
                        // wrong every time the copy changed — it clipped the
                        // console button in the no-client state.
                        height: sync-col.preferred-height + 28px;
                        sync-col := VerticalLayout {
                            padding: 14px;
                            spacing: 9px;

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    y: (parent.height - self.height) / 2;
                                    background: root.sync-signed-in ? Palette.accent : Palette.text-faint;
                                }
                                Text {
                                    text: root.sync-signed-in ? Strings.sync-connected : Strings.sync-off;
                                    font-size: Type.small;
                                    font-weight: 600;
                                    color: root.sync-signed-in ? Palette.accent : Palette.text-dim;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.sync-account;
                                    font-size: Type.small;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            // Which machine you are looking at. With two devices
                            // on one account this is the first thing a user needs
                            // to know when something looks out of step.
                            HorizontalLayout {
                                spacing: 6px;
                                visible: root.sync-device-name != "";
                                Text {
                                    text: Strings.sync-this-device;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.sync-device-name;
                                    font-size: Type.caption;
                                    color: Palette.text-dim;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            // What the last cycle actually moved, and when. The
                            // status line is transient (it is overwritten by the
                            // next message), so a user who looks away for a
                            // minute has no way to tell whether sync is alive.
                            // This line persists until the next cycle.
                            Text {
                                text: root.sync-detail;
                                font-size: Type.caption;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.55;
                                visible: root.sync-signed-in && root.sync-detail != "";
                            }

                            Text {
                                text: Strings.sync-blurb;
                                font-size: Type.caption;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.55;
                                visible: !root.sync-signed-in;
                            }

                            // The device code, shown only while waiting. The
                            // browser has already opened on Google's page, so
                            // the only thing the user has to do is type this.
                            Rectangle {
                                height: 88px; border-radius: 10px; background: Palette.accent-soft; border-width: 1px; border-color: Palette.accent; visible: root.sync-device-code != ""; VerticalLayout {
                                    padding: 10px; spacing: 6px; alignment: center; Text {
                                        text: Strings.sync-code-hint; font-size: Type.caption; color: Palette.text-dim; horizontal-alignment: center; }
                                    Text {
                                        text: root.sync-device-code; font-size: Type.display; font-weight: 700; color: Palette.accent; horizontal-alignment: center; letter-spacing: 4px; }
                                    // Copy, and a way back to the page if the
                                    // browser did not come up.
                                    HorizontalLayout {
                                        spacing: 6px; alignment: center; Rectangle {
                                            height: 22px; width: copy-lbl.preferred-width + 20px; border-radius: 11px; background: Palette.surface; ta-copy := TouchArea {
                                                clicked => { root.copy-code(root.sync-device-code); }
                                            }
                                            states [
                                                h when ta-copy.has-hover : {
                                                    background: Palette.surface-3; in { animate background { duration: Motion.quick; } }
                                                }
                                            ]
                                            copy-lbl := Text {
                                                text: root.code-copied ? Strings.sync-copied : Strings.sync-copy-code; font-size: Type.caption; color: root.code-copied ? Palette.accent : Palette.text-dim; horizontal-alignment: center; vertical-alignment: center; x: (parent.width - self.width) / 2; }
                                        }
                                        Rectangle {
                                            height: 22px; width: open-lbl.preferred-width + 20px; border-radius: 11px; background: Palette.surface; ta-open := TouchArea {
                                                clicked => { root.open-url(root.sync-device-url); }
                                            }
                                            states [
                                                h when ta-open.has-hover : {
                                                    background: Palette.surface-3; in { animate background { duration: Motion.quick; } }
                                                }
                                            ]
                                            open-lbl := Text {
                                                text: Strings.sync-open-browser; font-size: Type.caption; color: Palette.text-dim; horizontal-alignment: center; vertical-alignment: center; x: (parent.width - self.width) / 2; }
                                        }
                                    }
                                }
                            }

                            // Three numbered steps, shown before the code
                            // appears. The device flow is not obvious, so the
                            // card says what will happen rather than leaving
                            // the user to work it out.
                            VerticalLayout {
                                spacing: 2px; visible: !root.sync-signed-in && root.sync-device-code == "" && root.sync-available; Text { text: Strings.sync-step-1; font-size: Type.caption; color: Palette.text-faint; }
                                Text { text: Strings.sync-step-2; font-size: Type.caption; color: Palette.text-faint; }
                                Text { text: Strings.sync-step-3; font-size: Type.caption; color: Palette.text-faint; }
                            }

                            // Once signed in, say plainly that nothing further
                            // is required of them.
                            Text {
                                text: Strings.sync-signed-in-hint; font-size: Type.caption; color: Palette.text-faint; wrap: word-wrap; line-height-factor: 1.55; visible: root.sync-signed-in; }

                            // Say plainly what travels and what does not. A user
                            // who expects their hotkeys to follow them and finds
                            // they did not has been misled by silence.
                            VerticalLayout {
                                spacing: 3px;
                                visible: root.sync-signed-in;
                                Text {
                                    text: Strings.sync-settings-note-title;
                                    font-size: Type.caption;
                                    font-weight: 600;
                                    color: Palette.text-dim;
                                }
                                Text {
                                    text: Strings.sync-settings-note;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    wrap: word-wrap;
                                    line-height-factor: 1.55;
                                }
                            }

                            // Only shown when the build has no registered
                            // client. Google issues a client id per project, so
                            // it cannot ship in the source; letting the user
                            // paste one avoids a rebuild.
                            VerticalLayout {
                                spacing: 5px;
                                visible: !root.sync-available;

                                Text {
                                    text: Strings.sync-client-hint;
                                    font-size: Type.caption;
                                    color: Palette.text-dim;
                                    horizontal-alignment: Strings.fa ? end : start;
                                    wrap: word-wrap;
                                    line-height-factor: 1.55;
                                }
                                Text {
                                    text: Strings.sync-client-steps;
                                    font-size: Type.caption;
                                    color: Palette.text-faint;
                                    horizontal-alignment: Strings.fa ? end : start;
                                    wrap: word-wrap;
                                    line-height-factor: 1.55;
                                }
                                // Straight to the page where the client id is
                                // made, so the user is not hunting for it.
                                Rectangle {
                                    height: 24px;
                                    width: console-lbl.preferred-width + 22px;
                                    border-radius: Radius.tile;
                                    background: Palette.surface-2;
                                    ta-console := TouchArea {
                                        clicked => { root.open-url("https://console.cloud.google.com/apis/credentials"); }
                                    }
                                    states [
                                        h when ta-console.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    console-lbl := Text {
                                        text: Strings.sync-console;
                                        font-size: Type.caption;
                                        color: Palette.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        x: (parent.width - self.width) / 2;
                                    }
                                }

                                Rectangle {
                                    height: 32px;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    LineEdit {
                                        text: root.sync-client-id;
                                        placeholder-text: Strings.sync-client-placeholder;
                                        font-size: Type.caption;
                                        edited(t) => { root.sync-client-id = t; }
                                        accepted(t) => { root.set-client-id(t); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    visible: !root.sync-signed-in;
                                    ta-sync-connect := TouchArea {
                                        clicked => { if (root.sync-available && !root.sync-waiting) { root.sync-connect(); } }
                                    }
                                    states [
                                        h when ta-sync-connect.has-hover && root.sync-available : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: root.sync-waiting ? Strings.sync-waiting : (root.sync-available ? Strings.sync-connect : Strings.sync-no-client);
                                        font-size: Type.small;
                                        color: root.sync-available ? Palette.text : Palette.text-faint;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Sync now, for a user who does not want to wait
                                // for the timer.
                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    visible: root.sync-signed-in;
                                    ta-sync-now := TouchArea { clicked => { root.sync-now(); } }
                                    states [
                                        h when ta-sync-now.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.sync-now;
                                        font-size: Type.small;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    visible: root.sync-signed-in;
                                    ta-sync-off := TouchArea { clicked => { root.sync-disconnect(); } }
                                    states [
                                        h when ta-sync-off.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.sync-disconnect;
                                        font-size: Type.small;
                                        color: Palette.text-dim;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Automatic sync switch.
                            HorizontalLayout {
                                height: 26px;
                                visible: root.sync-signed-in;
                                alignment: center;
                                Text {
                                    text: Strings.sync-auto;
                                    font-size: Type.small;
                                    color: Palette.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: Strings.fa ? end : start;
                                }
                                Toggle {
                                    checked: root.sync-auto-on;
                                    toggled(v) => { root.set-sync-auto(v); }
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 14px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    ta13 := TouchArea { clicked => { root.backup-now(); } }
                                    states [
                                        h when ta13.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.backup;
                                        font-size: Type.small;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                    }
                                }
                                Rectangle {
                                    height: 34px;
                                    horizontal-stretch: 1;
                                    border-radius: 9px;
                                    background: Palette.surface-2;
                                    ta14 := TouchArea { clicked => { root.restore-now(); } }
                                    states [
                                        h when ta14.has-hover : {
                                            background: Palette.surface-3;
                                            in { animate background { duration: Motion.quick; } }
                                        }
                                    ]
                                    Text {
                                        text: Strings.restore;
                                        font-size: Type.small;
                                        color: Palette.text;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ── about ──
                    SectionLabel { text: Strings.sec-about; }
                    Card {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 8px;
                                Boteh {
                                    size: 26px;
                                    y: (parent.height - self.height) / 2;
                                    color: Palette.accent;
                                    fade: 0.9;
                                }
                                Text {
                                    text: Strings.made-by;
                                    font-size: Type.small;
                                    color: Palette.text-faint;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Khosrowan";
                                    font-size: Type.small;
                                    font-weight: 600;
                                    color: Palette.accent;
                                    vertical-alignment: center;
                                    ta15 := TouchArea {
                                        clicked => { root.open-url("https://khosrowan.ir"); }
                                        mouse-cursor: pointer;
                                    }
                                    states [
                                        h when ta15.has-hover : {
                                            color: Palette.text;
                                            in { animate color { duration: Motion.quick; } }
                                        }
                                    ]
                                }
                            }

                            Text {
                                text: "khosrowan.ir";
                                font-size: Type.small;
                                color: Palette.text-dim;
                                ta16 := TouchArea {
                                    clicked => { root.open-url("https://khosrowan.ir"); }
                                    mouse-cursor: pointer;
                                }
                                states [
                                    h when ta16.has-hover : {
                                        color: Palette.accent;
                                        in { animate color { duration: Motion.quick; } }
                                    }
                                ]
                            }

                            // Free Art License 1.3 requires visible attribution for
                            // the Parthian emblem (Derafsh Kaviani, by Oneasy).
                            Text {
                                text: Strings.emblem-credit;
                                font-size: Type.caption;
                                color: Palette.text-faint;
                                wrap: word-wrap;
                                line-height-factor: 1.55;
                            }
                        }
                    }

                    Text {
                        text: root.sync-status;
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: Strings.app-credit;
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
    // ─────────────────────────────────────────────────────────────────────
    // The inscription dialog.
    //
    // It covers the whole window when a focus session finishes, because the
    // question it asks — what did you just do — is only answerable in the
    // minute after the session ends. The scrim also blocks the timer controls
    // underneath: a stray click on Reset while typing would throw away the
    // record the dialog exists to capture.
    // ─────────────────────────────────────────────────────────────────────
    if root.inscription-open : Rectangle {
        width: parent.width; height: parent.height;
        background: Palette.scrim;

        // The scrim swallows clicks so they cannot reach the timer below.
        TouchArea { }

        Rectangle {
            width: parent.width - Space.gutter * 2;
            height: ins-dialog.preferred-height;
            x: (parent.width - self.width) / 2;
            y: Math.max(Space.gutter, (parent.height - self.height) / 2);
            border-radius: Radius.panel;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.hairline;
            drop-shadow-blur: Elev.card-blur;
            drop-shadow-offset-y: Elev.card-y;
            drop-shadow-color: Elev.card-shadow;

            ins-dialog := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: Strings.ins-prompt;
                    font-family: "Vazirmatn";
                    font-size: Type.body;
                    font-weight: 600;
                    color: Palette.text;
                    wrap: word-wrap;
                    horizontal-alignment: Strings.fa ? right : left;
                }

                Rectangle {
                    height: 76px;
                    border-radius: Radius.tile;
                    background: Palette.surface-2;
                    border-width: 1px;
                    border-color: root.inscription-error != "" ? Palette.danger : Palette.hairline;

                    ins-field := TextEdit {
                        x: Space.tight; y: Space.tight;
                        width: parent.width - Space.tight * 2;
                        height: parent.height - Space.tight * 2;
                        text <=> root.inscription-text;
                        placeholder-text: root.inscription-placeholder;
                        font-family: "Vazirmatn";
                        font-size: Type.small;
                        wrap: word-wrap;
                        edited(v) => { root.inscription-text-changed(v); }
                    }
                }

                // The count is always visible rather than appearing only when
                // the limit is passed: a user who can see the room left writes
                // a better line than one who is told off at the end.
                HorizontalLayout {
                    height: 16px;
                    spacing: 6px;
                    alignment: space-between;

                    Text {
                        text: root.inscription-error;
                        font-size: Type.caption;
                        color: Palette.danger;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.inscription-count;
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                    }
                }

                // ---- the quick judge ----
                // The verdict row, offered at the same moment as the inscription:
                // the block just finished, the user is right here, and the app
                // knows which session it was. Judging now beats judging later from
                // the archive — the work is still warm. The five seals reuse the
                // archive's vocabulary and the same declare-verdict callback.
                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: Strings.verdict-ask;
                        font-family: "Vazirmatn";
                        font-size: Type.caption;
                        font-weight: 600;
                        color: Palette.text-dim;
                        horizontal-alignment: Strings.fa ? right : left;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        VerdictSeal {
                            kind: "kept";
                            label: Strings.verdict-kept;
                            active: root.inscription-verdict-kind == "kept";
                            picked(k) => { root.declare-verdict(root.inscription-session, k); }
                        }
                        VerdictSeal {
                            kind: "partial";
                            label: Strings.verdict-partial;
                            active: root.inscription-verdict-kind == "partial";
                            picked(k) => { root.declare-verdict(root.inscription-session, k); }
                        }
                        VerdictSeal {
                            kind: "broken";
                            label: Strings.verdict-broken;
                            active: root.inscription-verdict-kind == "broken";
                            picked(k) => { root.declare-verdict(root.inscription-session, k); }
                        }
                        VerdictSeal {
                            kind: "extended";
                            label: Strings.verdict-extended;
                            active: root.inscription-verdict-kind == "extended";
                            picked(k) => { root.declare-verdict(root.inscription-session, k); }
                        }
                        VerdictSeal {
                            kind: "short";
                            label: Strings.verdict-short;
                            active: root.inscription-verdict-kind == "short";
                            picked(k) => { root.declare-verdict(root.inscription-session, k); }
                        }
                    }
                }

                HorizontalLayout {
                    height: 38px;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        border-radius: Radius.tile;
                        background: Palette.surface-2;
                        ta-skip := TouchArea { clicked => { root.skip-inscription(root.inscription-session); } }
                        states [
                            h when ta-skip.has-hover : {
                                background: Palette.surface-3;
                                in { animate background { duration: Motion.quick; } }
                            }
                        ]
                        Text {
                            text: Strings.ins-skip;
                            font-size: Type.small;
                            color: Palette.text-dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        border-radius: Radius.tile;
                        // Disabled while the field is blank, so the primary
                        // action never saves an empty inscription and then has
                        // to explain why it refused. `can-inscribe` is pushed
                        // from Rust, because this Slint version has no string
                        // length or trim to test against.
                        background: root.can-inscribe ? Palette.accent : Palette.surface-3;
                        ta-inscribe := TouchArea {
                            clicked => {
                                if (root.can-inscribe) {
                                    root.inscribe(root.inscription-session, root.inscription-text);
                                }
                            }
                        }
                        states [
                            h when ta-inscribe.has-hover && root.can-inscribe : {
                                background: Palette.accent-strong;
                                in { animate background { duration: Motion.quick; } }
                            }
                        ]
                        Text {
                            text: Strings.ins-inscribe;
                            font-size: Type.small;
                            font-weight: 600;
                            color: root.can-inscribe ? Palette.on-accent : Palette.text-faint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    // The decree dialog — asked *before* a block, never after it.
    //
    // Sits here rather than at the top of the file because it is the same kind
    // of surface as the inscription dialog: a scrim, one card, one field, two
    // ways out. The difference is when it fires and what it costs to skip. An
    // inscription skipped leaves a gap in a record; a decree skipped leaves the
    // block unspoken for, which is a perfectly ordinary way to work.
    // ─────────────────────────────────────────────────────────────────────
    if root.decree-open : Rectangle {
        width: parent.width; height: parent.height;
        background: Palette.scrim;

        TouchArea { }

        Rectangle {
            width: parent.width - Space.gutter * 2;
            height: dec-dialog.preferred-height;
            x: (parent.width - self.width) / 2;
            y: Math.max(Space.gutter, (parent.height - self.height) / 2);
            border-radius: Radius.panel;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.hairline;
            drop-shadow-blur: Elev.card-blur;
            drop-shadow-offset-y: Elev.card-y;
            drop-shadow-color: Elev.card-shadow;

            dec-dialog := VerticalLayout {
                padding: 18px;
                spacing: 12px;

                Text {
                    text: Strings.dec-prompt;
                    font-family: "Vazirmatn";
                    font-size: Type.body;
                    font-weight: 600;
                    color: Palette.text;
                    wrap: word-wrap;
                    horizontal-alignment: Strings.fa ? right : left;
                }

                Rectangle {
                    height: 46px;
                    border-radius: Radius.tile;
                    background: Palette.surface-2;
                    border-width: 1px;
                    border-color: root.decree-error != "" ? Palette.danger : Palette.hairline;

                    // One line, not a wrapping box: a decree must fit on the
                    // strip under the clock, so the field refuses the shape that
                    // could not survive there.
                    LineEdit {
                        x: Space.tight; y: Space.tight;
                        width: parent.width - Space.tight * 2;
                        height: parent.height - Space.tight * 2;
                        text <=> root.decree-text;
                        placeholder-text: root.decree-placeholder;
                        font-family: "Vazirmatn";
                        font-size: Type.small;
                        edited(v) => { root.decree-text-changed(v); }
                        accepted(v) => {
                            if (root.can-issue) { root.issue-decree(v); }
                        }
                    }
                }

                HorizontalLayout {
                    height: 16px;
                    spacing: 6px;
                    alignment: space-between;

                    Text {
                        text: root.decree-error;
                        font-size: Type.caption;
                        color: Palette.danger;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: root.decree-count;
                        font-size: Type.caption;
                        color: Palette.text-faint;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    height: 38px;
                    spacing: 8px;

                    // Starts the block with no stated intention. Not a refusal —
                    // an ordinary way to work — so it is a normal-weight button
                    // and it does not warn.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        border-radius: Radius.tile;
                        background: Palette.surface-2;
                        ta-decskip := TouchArea { clicked => { root.skip-decree(); } }
                        states [
                            h when ta-decskip.has-hover : {
                                background: Palette.surface-3;
                                in { animate background { duration: Motion.quick; } }
                            }
                        ]
                        Text {
                            text: Strings.dec-skip;
                            font-size: Type.caption;
                            color: Palette.text-dim;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 38px;
                        border-radius: Radius.tile;
                        background: root.can-issue ? Palette.accent : Palette.surface-3;
                        ta-issue := TouchArea {
                            clicked => {
                                if (root.can-issue) {
                                    root.issue-decree(root.decree-text);
                                }
                            }
                        }
                        states [
                            h when ta-issue.has-hover && root.can-issue : {
                                background: Palette.accent-strong;
                                in { animate background { duration: Motion.quick; } }
                            }
                        ]
                        Text {
                            text: Strings.dec-issue;
                            font-size: Type.small;
                            font-weight: 600;
                            color: root.can-issue ? Palette.on-accent : Palette.text-faint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    // Resize handles — a frameless window gets no WM resize border, so these
    // eight invisible grab zones give the edges and corners back. They sit on
    // top of the content and are only 5px wide, so they never block a click.
    // ─────────────────────────────────────────────────────────────────────
}
