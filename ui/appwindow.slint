import { Button, LineEdit } from "std-widgets.slint";

// Pangan — a modern, themed Pomodoro platform.
// Aesthetic: "Iranian Old Parsi" — cuneiform-laced deep indigo, gold accents,
// temple motifs, with light/dark/system themes and a full report screen.

export component PanganWindow inherits Window {
    in property <string> time-left;
    in property <string> session-name;
    in property <float> progress;
    in property <string> phase;
    in property <bool> running;

    // Theme label provided by the host ("System"/"Dark"/"Light").
    in property <string> theme-label: "System";
    // Effective theme used by the palette ("dark"/"light").
    in property <string> resolved-theme: "dark";

    // Status / report / sync / task input
    in property <string> status-line;
    in property <string> report-text;
    in property <string> sync-status;
    in property <bool> show-report: false;
    in-out property <string> new-task-text;

    callback start-pause;
    callback skip;
    callback reset;
    callback open-report;
    callback close-report;
    callback cycle-theme;
    callback toggle-sound;
    callback sync-now;
    callback add-task;
    callback quit;

    title: "Pangan";
    width: 460px;
    height: 620px;
    no-frame: true;

    // ---------- Theme palette ----------
    private property <brush> c-bg: root.resolved-theme == "light" ? #f4f1ea : #171a2e;
    private property <brush> c-bg2: root.resolved-theme == "light" ? #ece7dc : #1e2340;
    private property <brush> c-surface: root.resolved-theme == "light" ? #fbf9f4 : #242a4d;
    private property <brush> c-surface2: root.resolved-theme == "light" ? #e8e1d2 : #2d3460;
    private property <brush> c-text: root.resolved-theme == "light" ? #2a2a35 : #e8e6f2;
    private property <brush> c-muted: root.resolved-theme == "light" ? #6b6558 : #9a96b8;
    private property <brush> c-accent: root.resolved-theme == "light" ? #8a5a2b : #e0b25c;
    private property <brush> c-btn: root.resolved-theme == "light" ? #b98a4e : #c89a4f;
    private property <brush> c-btn-text: #141018;

    background: c-bg;

    VerticalLayout {
        spacing: 0px;

        // ================= Header =================
        Rectangle {
            height: 64px;
            background: c-bg2;
            Rectangle {
                height: 3px;
                width: parent.width;
                background: c-accent;
                y: 0px;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 12px;

                // --------- Old Parsi icon (winged bull + cuneiform) ---------
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: c-accent;

                    Rectangle { width: 13px; height: 3px; x: 5px; y: 14px; background: c-btn-text; }
                    Rectangle { width: 10px; height: 3px; x: 6px; y: 19px; background: c-btn-text; }
                    Rectangle { width: 7px; height: 3px; x: 7px; y: 24px; background: c-btn-text; }

                    Rectangle { width: 13px; height: 3px; x: 26px; y: 14px; background: c-btn-text; }
                    Rectangle { width: 10px; height: 3px; x: 28px; y: 19px; background: c-btn-text; }
                    Rectangle { width: 7px; height: 3px; x: 30px; y: 24px; background: c-btn-text; }

                    Rectangle {
                        width: 10px; height: 16px; x: 17px; y: 12px;
                        border-radius: 4px; background: c-btn-text;
                        Rectangle { width: 3px; height: 3px; x: 2px; y: 2px; background: c-accent; border-radius: 1px; }
                        Rectangle { width: 3px; height: 3px; x: 6px; y: 2px; background: c-accent; border-radius: 1px; }
                    }

                    Rectangle { width: 4px; height: 2px; x: 8px; y: 5px; background: c-btn-text; }
                    Rectangle { width: 4px; height: 2px; x: 14px; y: 3px; background: c-btn-text; }
                    Rectangle { width: 4px; height: 2px; x: 21px; y: 4px; background: c-btn-text; }
                    Rectangle { width: 3px; height: 2px; x: 27px; y: 6px; background: c-btn-text; }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text { text: "PANGAN"; font-size: 16px; font-weight: 700; letter-spacing: 2px; color: c-text; }
                    Text { text: "پنگان · پومودورو"; font-size: 11px; color: c-muted; }
                }

                Rectangle { width: 0px; }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    Button { width: 84px; text: root.theme-label; clicked => { root.cycle-theme(); } }
                    Button { width: 36px; text: "♪"; clicked => { root.toggle-sound(); } }
                }
            }
        }

        // ================= Body =================
        if root.show-report: VerticalLayout {
            padding: 16px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 10px;
                Button { text: "← Back"; clicked => { root.close-report(); } }
                Text {
                    text: "Focus Report"; font-size: 18px; font-weight: 700;
                    color: c-text; vertical-alignment: center;
                }
            }

            Rectangle { height: 1px; background: c-surface2; }

            Text {
                text: root.report-text;
                font-size: 13px; color: c-text; wrap: word-wrap; height: 480px;
            }
        }

        if !root.show-report: VerticalLayout {
            padding: 24px;
            spacing: 12px;

            Text {
                text: root.session-name;
                font-size: 15px; font-weight: 600; letter-spacing: 2px;
                color: c-muted; horizontal-alignment: center;
            }

            Rectangle {
                height: 10px; border-radius: 5px; background: c-surface2;
                Rectangle {
                    width: parent.width * root.progress;
                    height: parent.height; border-radius: 5px; background: c-accent;
                }
            }

            Text {
                text: root.time-left;
                font-size: 68px; font-weight: 700; color: c-text; horizontal-alignment: center;
            }

            Text {
                text: root.phase; font-size: 13px; color: c-muted; horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                Button { text: root.running ? "Pause" : "Start"; clicked => { root.start-pause(); } }
                Button { text: "Skip"; clicked => { root.skip(); } }
                Button { text: "Reset"; clicked => { root.reset(); } }
            }

            Rectangle { height: 2px; background: c-surface2; }

            Text {
                text: root.status-line;
                font-size: 12px; color: c-muted; wrap: word-wrap;
                horizontal-alignment: center; height: 44px;
            }

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                Button { text: "📊 Report"; clicked => { root.open-report(); } }
                Button { text: "☁ Sync"; clicked => { root.sync-now(); } }
            }

            Text {
                text: root.sync-status;
                font-size: 11px; color: c-muted; horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                LineEdit {
                    text: root.new-task-text;
                    placeholder-text: "Add a task for today…";
                    width: 260px;
                    edited => { root.new-task-text = self.text; }
                }
                Button { text: "+"; clicked => { root.add-task(); } }
            }
        }
    }
}
